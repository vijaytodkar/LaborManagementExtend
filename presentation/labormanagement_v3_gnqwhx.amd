{
  "appProperties": [],
  "flowDefinitions": [
    {
      "id": "SearchWorkerCostingAllocations",
      "flowSteps": [
        {
          "id": "searchOrganization",
          "transitions": [
            {
              "order": "a",
              "value": "SelectWorker",
              "condition": "true"
            }
          ],
          "startsFlow": true,
          "taskId": "SearchWorkerByOrganization"
        },
        {
          "id": "SelectWorker",
          "endsFlow": true,
          "taskId": "SelectWorkers"
        }
      ]
    },
    {
