    },
    {
      "id": "AssignCostingAllocationFlow",
      "flowSteps": [
        {
          "id": "promptUser",
          "transitions": [
            {
              "order": "a",
              "value": "AssignCostingAllocation",
              "condition": "<%  (flowVariables.Authorized == true)  %>"
            },
            {
              "order": "b",
              "value": "conclusion",
              "condition": "<%  (flowVariables.Authorized != true)  %>"
            }
          ],
          "startsFlow": true,
          "taskId": "AssignCostingAllocation_Prompts"
        },
        {
          "id": "AssignCostingAllocation",
          "transitions": [
            {
              "order": "a",
              "value": "conclusion",
              "condition": "<%  !empty(flowVariables.salaryCap)  %>"
            },
            {
              "order": "b",
              "value": "conclusion",
              "condition": "<%  empty(flowVariables.salaryCap)   %>"
            }
          ],
          "taskId": "AssignCostingAllocationCreateEdit"
        },
        {
          "id": "salaryOverCap1",
          "transitions": [
            {
              "order": "a",
              "value": "conclusion",
              "condition": "<% true %>"
            }
          ],
          "taskId": "SalaryOverTheCap"
        },
        {
          "id": "conclusion",
          "endsFlow": true,
          "taskId": "microConclusionPage"
        }
      ]
    },
    {
