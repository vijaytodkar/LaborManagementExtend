        },
        {
          "id": "salaryOverCap",
          "transitions": [
            {
              "order": "a",
              "value": "conclusion",
              "condition": "<% true %>"
            }
          ],
          "taskId": "SalaryOverTheCap"
        },
        {
          "id": "conclusion1",
          "endsFlow": true,
          "taskId": "microConclusionPage"
