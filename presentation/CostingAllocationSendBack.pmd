                          {
                            "type": "instanceList",
                            "id": "activityWorktag",
                            "enabled": true,
                            "required": true,
                            "values": "<% getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Activity'}).map(c =>{{'descriptor': ( ((c.referenceID1 ?? '') + ' ' + (c.name ?? ''))), 'id': c.id}}) ?? [] %>",
                            "selectedValues": "<% [row.activityType.id ?? ''] %>",
                            "onChange": "<%
                             //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'activity');
                              if(!empty(self.value[0])){
                                var worktags = getWorktags.invoke({'taggableType': 'CUSTOM_ORGANIZATION', 'worktag': self.value[0], 'taggableTypes': ['CUSTOM_ORGANIZATION_01', 'CUSTOM_ORGANIZATION_02', 'CUSTOM_ORGANIZATION_03','CUSTOM_ORGANIZATION_04','CUSTOM_ORGANIZATION_05','CUSTOM_ORGANIZATION_06','CUSTOM_ORGANIZATION_07','CUSTOM_ORGANIZATION_08','CUSTOM_ORGANIZATION_09','CUSTOM_ORGANIZATION_10']}) ?? [];
                                var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
                              }
                            %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colGrantWorktag",
                      "label": "Grant",
                      "id": "grantWorktagCol",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "grantWorktagFieldSet",
                        "children": [
                          {
                            "type": "instanceList",
                            "id": "grantWorktag",
                            "values": "<% (getGrant.data.map(x =>{x.grant}) ?? []) %>",
                            "selectedValues": "<% [row.grant.id ?? ''] %>",                                                        
                            "onChange": "<%         
                            self.clearWarning();
                            //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'grant');
                              if(!empty(self.value[0])){
                                if((earningGroupList1.value ?? '') == 'Base Salary'){
                                  var grantData = getGrantDeferred.invoke({'id': self.value[0]}).data[0] ?? {:};
                                  if(!empty(grantData.effectiveAwardLine.awardLineSalaryCap.id)){
                                    var salaryCapBody = getSalaryOverCap.invoke({'salaryCapID': (grantData.effectiveAwardLine.awardLineSalaryCap.id ?? '')});
                                       var awardLineSalaryCapOverrideID = grantData.effectiveAwardLine.awardLineSalaryCapOverride.id ?? '';
                                       salaryCapBody = Mapping.getSalaryOverTheCap(salaryCapBody,awardLineSalaryCapOverrideID) ?? {:};

                                  //  salaryCapBody = salaryCapBody[0] ?? {:};                                    
                                    var salaryAmount = salaryCapBody.amount ?? 0;
                                  //  var amountSalaryOverCap = (totalAmount.value.toDecimal() ?? 0) - salaryAmount; 
                                     var amountSalaryOverCap = ((totalAmount.value ?? 0) - (salaryAmount * (pageVariables.fte ?? 1.0))); 
                                    if(amountSalaryOverCap > 0){
                                      salaryCapValue.setValue(number:toBigDecimal((amountSalaryOverCap ?? 0), 2, 'HALF_DOWN'));
                                    }else{
                                      salaryCapValue.setValue((0));
                                    }
                                  }                                  
                                  else{
                                    salaryCapValue.setValue((0));
                                  }
                                }
                                var worktags = getWorktags.invoke({'taggableType': 'GRANT', 'worktag': self.value[0], 'taggableTypes': ['GRANT']}) ?? [];
                                //added indefinite attributes by Pasha 12/08 
                                indefinite.setValue(false);
                                indefinite.setEnabled(false);
                                var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
                                 Validation.getRelatedWorktags(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag,grantWorktag, projectWorktag, allRemainingWorktag, relatedWorktags, 'Grant', self.value[0]);
                                 //Added by Pasha 12/05  Validation.SOCAwardExpirationValidation
                                  Validation.SOCAwardExpirationValidation(endDate, grantWorktag, salaryCapValue,pageVariables.fte,totalAmount,(earningGroupList1.value ?? ''));                        
                               
                              }
                            %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colProjectWorktag",
                      "label": "Project",
                      "id": "projectWorktagCol",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "projectWorktagFieldSet",
                        "children": [
                          {
                            "type": "instanceList",
                            "id": "projectWorktag",
                            "values": "<% (getProject.data.map(x =>{{'descriptor': ('Project:'+ x.descriptor), 'id': x.id}}) ?? []) %>",
                            "selectedValues": "<% [row.project.id ?? ''] %>",
                            "onChange": "<%
                                     //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                            if(!empty(projectWorktag.value[0])){
                              // if(!empty(self.value[0])){
                                //changed by Pasha 10/30 projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                                 projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};                           
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'project');
                              if(!empty(self.value[0])){
                                var worktags = getWorktags.invoke({'taggableType': 'PROJECT', 'worktag': self.value[0], 'taggableTypes': ['PROJECT']}) ?? [];
                                var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
                                Validation.getRelatedWorktags(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag,grantWorktag, projectWorktag, allRemainingWorktag, relatedWorktags, 'Project', self.value[0]);
                              }
                            %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colallRemainingWorktag",
                      "label": "All Worktags",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "allRemainingWorktagSet",
                        "children": [
                          {
                            "type": "instanceList",
                            "id": "allRemainingWorktag",
                            "enabled": true,
                            "multiSelect": true,
                            "values": "<%
                              Validation.getAllocationAssignmentWorktags(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag, (startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (attrstore.ProjectValidations ?? '')) ?? [];
                            %>",
                            "selectedValues": "<%
                                var otherWT = [];
                                if(!empty(row.gift.id)){
                                    otherWT.add(row.gift.id);
                                }
                                if(!empty(row.clinicalAssignment.id)){
                                    otherWT.add(row.clinicalAssignment.id);
                                }
                                if(!empty(row.center.id)){
                                    otherWT.add(row.center.id);
                                }
                                if(!empty(row.activityType.id)){
                                    otherWT.add(row.activityType.id);
                                }
                                return otherWT ?? [];
                            %>",
                            "onChange": "<%
                              if(!empty(self.selectedEntries.filter(x =>{(x.descriptor ?? '').contains('Gift')}))){
                                var worktags = getWorktags.invoke({'taggableType': 'GIFT', 'worktag': (self.selectedEntries.filter(x =>{(x.descriptor ?? '').contains('Gift')})[0].id ?? ''), 'taggableTypes': ['GIFT']}) ?? [];
                                var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
                                Validation.getRelatedWorktags(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag,grantWorktag, projectWorktag, allRemainingWorktag, relatedWorktags, 'GIFT', self.value[0]);
                              }                              
                            //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'additionalWorktags');
                            %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colSalaryCap",
                      "id": "salaryCapCol",
                      "label": "Salary Over the Cap",
                      "visible":"<% !empty(earningGroupList1.value)? earningGroupList1.value == 'Base Salary' : false %>",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "salaryoverCapSection",
                        "children": [
                          {
                            "type": "number",
                            "enabled": false,
                            "id": "salaryCapValue",
                            "fractionDigits": 2,
                            "value": "<% 
                              if((earningGroupList1.value ?? '') == 'Base Salary'){
                                var grantData = getGrantDeferred.invoke({'id': (row.grant.id ?? '')}).data[0] ?? {:};                                
                                if(!empty(grantData.effectiveAwardLine.awardLineSalaryCap.id)){
                                  var salaryCapBody = getSalaryOverCap.invoke({'salaryCapID': (grantData.effectiveAwardLine.awardLineSalaryCap.id ?? '')});
                                    // added by Pasha MCW-14351
                                  var awardLineSalaryCapOverrideID = grantData.effectiveAwardLine.awardLineSalaryCapOverride.id ?? '';
                                  salaryCapBody = Mapping.getSalaryOverTheCap(salaryCapBody,awardLineSalaryCapOverrideID) ?? {:};
                                  if(!empty(salaryCapBody)){
                                  var salaryAmount = salaryCapBody.amount ?? 0;
                                  //var amountSalaryOverCap = (totalAmount.value ?? 0) - salaryAmount; 
                                   var amountSalaryOverCap = ((totalAmount.value ?? 0) - (salaryAmount * (pageVariables.fte ?? 1.0))); 
                                  if(amountSalaryOverCap > 0){
                                    //var amountSalaryOverCap = (totalAmount.value ?? 0) - salaryAmount; 
                                    return number:toBigDecimal((amountSalaryOverCap ?? 0), 2, 'HALF_DOWN');
                                  }else{
                                    return 0;
                                  }
                                }
                                }
                                /**else if(!empty(grantData.salaryCapForGrant.id)){
                                  var salaryCapBody = getSalaryOverCap.invoke({'salaryCapID': (grantData.salaryCapForGrant.id ?? '')});
                                }**/
                                //salaryCapBody = salaryCapBody[0] ?? {:};
                              }
                                return 0;
                              
                            %>"
                          }
                        ]
                        
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colStartDate",
                      "label": "Start Date",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "startDateFieldSet",
                        "children": [
                          {
                            "type": "date",
                            "id": "startDate",
                            "enabled": true,
                            "required": "<% true %>",
                            "value": "<% row.startDate ?? '' %>",
                            "onChange": "<%
                              endDate.clearError();
                               startDate.clearError();
                              if(!empty(endDate.value)){
                                if(endDate.value < (startDate.value ?? '')){
                                  endDate.setError('Start Date must be before End Date');
                                }
                              }
                                 if(!empty(startDate.value) && (((startDate.value.format('yyyy-MM-dd')) < '2025-12-28' ) )){
                                      startDate.setError('For labor costing adjustments prior to 12/28/2025 for non-exempt workers and 1/1/2026 for exempt workers, please submit a Funding Reallocation Form (FRF), located on the Infoscope Workday Training Resources Finance page.');
                                  } 
                              //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'startDate');
                            %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colEndDate",
                      "label": "End Date",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "endDateFieldSet",
                        "children": [
                          {
                            "type": "date",
                            "id": "endDate",
                            "enabled": "<% !(row.indefinite ?? false) %>",
                            "value": "<% row.endDate ?? '' %>",
                            "required": "<% !(row.indefinite ?? false) %>",
                            "onChange": "<%
                              endDate.clearError();
                              startDate.clearError();
                              self.clearWarning();
                              grantWorktag.clearWarning();                              
                             
                              if(!empty(endDate.value)){
                                if(endDate.value < (startDate.value ?? '')){
                                  endDate.setError('Start Date must be before End Date');
                                }                                 
                              }
                              if(!empty(startDate.value) && (((startDate.value.format('yyyy-MM-dd')) < '2025-12-28' ) )){
                                      startDate.setError('For labor costing adjustments prior to 12/28/2025 for non-exempt workers and 1/1/2026 for exempt workers, please submit a Funding Reallocation Form (FRF), located on the Infoscope Workday Training Resources Finance page.');
                                  } 
                            //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                               //added by Pasha 12/05
                              Validation.SOCAwardExpirationValidation(endDate, grantWorktag, salaryCapValue,pageVariables.fte,totalAmount,(earningGroupList1.value ?? '')); 
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'endDate');
                            %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colIndefinite",
                      "label": "Indefinite",
                      "cellTemplate": {
                        "type": "checkBox",
                        "id": "indefinite",
                        "enabled": true,
                        "value": "<% row.indefinite ?? false %>",
                        "onChange": "<%
                            //added by Pasha 10/30
                            var projectClinicalAssignment = {:};
                          if(!empty(projectWorktag.value[0])){
                            projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                          }
                          Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (attrstore.ProjectValidations ?? ''), 'indefinite');
                          if(self.value ?? false){
                            endDate.setValue('');
                            endDate.setEnabled(false);
                            endDate.setRequired(false);
                          }else{
                            endDate.setEnabled(true);
                            endDate.setRequired(true);
                          }
                        %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colAmount",
                      "label": "Amount",
                      "id": "amountCol",
                      "cellTemplate": {
                        "type": "number",
                        "id": "numberAmount",
                        "fractionDigits": 2,
                        "enabled": true,
                        "onChange": "<% 
                              var amountList = 0;
                              var earningGroupsfromAdmin  = getEarningGroupFromAdminPage.data ?? [];
                              for(var t: earningGroupsfromAdmin){
                                var earningsGroupsEarningsMapped = t.earnings.map(y =>{y.earningDescriptor})
                                for(var row : pageVariables.workersCompensation) 
                                var compPlanSubText = row.compensationElement.descriptor ?? '';                                
                                {                                  
                                for(var earning : earningsGroupsEarningsMapped){                                    
                                var list =  (((compPlanSubText ?? '').contains(earning)) || (('Regular ' + compPlanSubText) ?? '').contains(earning));      
                                    if (list == true)
                                    {
                                     if(row.frequency.descriptor == 'Hourly' ){
                                      amountList = (row.amount.value * (pageVariables.fte * 40)) ?? '0' + amountList ;
                                  }     
                                  else{

                                  amountList = row.amount.value ?? '0' + amountList;
                                  }
                                } 
                                    }
                                }
                              }                                              
                                var finalper = 0;
                                if(! empty self.value){
                                   finalper =  number:toBigDecimal((((self.value/amountList) ?? 0)*100), 2, 'HALF_UP');
                                }
                                if(finalper > 100)
                                {
                                   percentAmount.setError('Percent Value is beyond 100% allocation');
                                }
                                else
                                {
                                  percentAmount.clearError();
                                         percentAmount.value = finalper;
                                }
                            %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colPercent",
                      "label": "Percent",
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "percentSection",
                        "children": [
                          {
                            "type": "fieldSet",
                            "id": "percentAmountSection",
                            "children": [
                              {
                                "type": "number",
                                "id": "percentAmount",
                                "fractionDigits": 2,
                                "enabled": true,
                                "value": "<%   
                                  //pasha modified 11/04 review with chester pending
                                //!empty((row.allocationPercent)) ? (string:isString(row.allocationPercent)? (row.allocationPercent).toDecimal()*100 : (row.allocationPercent))*100 : 0 
                                //!empty((row.allocationPercent)) ? json:asJSON(number:toBigDecimal(((row.allocationPercent ?? 0)*100),2,'DOWN')) : 0 
                                !empty((row.allocationPercent)) ?number:toBigDecimal((string:isString(row.allocationPercent) ? (row.allocationPercent).toDecimal() : (row.allocationPercent)) * 100,2,'CEILING') : 0.00
                                 
                                %>",
                                 "_value": "<%                 
                                 !empty((row.allocationPercent)) ? number:toBigDecimal(((string:isString(row.allocationPercent)? (row.allocationPercent).toDecimal()*100 : (row.allocationPercent))*100),2, 'DOWN') : 0 %>",
                                "onChange": "<%
                                  percentAmount.clearError();
                                  if(self.value != 0){
                                    var amountList = 0;                            
                                    var earningGroupsfromAdmin  = getEarningGroupFromAdminPage.data ?? [];
                                      for(var t: earningGroupsfromAdmin){
                                        var earningsGroupsEarningsMapped = t.earnings.map(y =>{y.earningDescriptor})
                                        for(var row : pageVariables.workersCompensation) 
                                        var compPlanSubText = row.compensationElement.descriptor ?? '';                     
                                        {                                 
                                          for(var earning : earningsGroupsEarningsMapped){                                 
                                                    var list =  (((compPlanSubText ?? '').contains(earning)) || (('Regular ' + compPlanSubText) ?? '').contains(earning));      
                            
                                            if (list == true)
                                              {                                      
                                                if(row.frequency.descriptor == 'Hourly' ){
                                              amountList = (row.amount.value * (pageVariables.fte * 40)) ?? '0' + amountList;                                                   
                                              }     
                                                else{
                                              amountList = row.amount.value ?? '0' + amountList;
                                            }
                                            } 
                                          }
                                        }
                                    }                       
                                    var finalamount = (amountList*self.value)/100;
                                  }
                                %>"
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colComment",
                      "label": "Comment",
                      "cellTemplate": {
                        "type": "textArea",
                        "id": "comment",
                        "enabled": true,
                        "value": "<% (row.comment) ?? '' %>"
                      }
                    }
                  ]
                },
                {
                  "type": "hidden",
                  "id": "onLoadFunction",
                  "value": "<%                    
                    	//   var mostStartDate = gridData1.map(l =>{l.childrenMap.colStartDate.childrenMap.startDate.value ?? ''}).sort()[0] ?? '';
                    var moststartDate =  setPercentage.getRows().map(l =>{l.childrenMap.colStartDate.childrenMap.startDate.value ?? ''}).sort()[0] ?? '';
                     
                    pageVariables.percentData1 = {
                      //'gridData': (Validation.getPercentageData((setPercentage.getRows() ?? []), (pageVariables.gridFunction ?? []), date:now()) ?? {:})
                      'gridData': (Validation.getPercentageData((setPercentage.getRows() ?? []), (pageVariables.gridFunction ?? []), (moststartDate ?? date:now())) ?? {:})
                    };
                  %>"
                },
                {
                  "type": "section",
                  "id": "calculatePageActionSection",
                  "visible": "<%  true %>",
                  "children": [
                    {
                      "type": "pageActionButton",
                      "id": "calculateButton",
                      "label": "Calculate",
                      "onClick": "<%
                        var startDateEmpty = false;
                        var endDateEmpty = false;
                        var indefiniteValue = false;
                        var endDateEmptyVar = false;
                        for (var x : setPercentage.getRows() ?? []){
                          x.childrenMap.colStartDate.childrenMap.startDate.clearError();
                          x.childrenMap.colEndDate.childrenMap.endDate.clearError();
                          startDateEmpty = empty(x.childrenMap.colStartDate.childrenMap.startDate.value);
                          endDateEmpty = empty(x.childrenMap.colEndDate.childrenMap.endDate.value);
                          indefiniteValue = x.childrenMap.colIndefinite.value;
                          if(startDateEmpty){
                            x.childrenMap.colStartDate.childrenMap.startDate.setError('Start Date must have a value');
                          }
                          if(endDateEmpty && (indefiniteValue == false)){
                            endDateEmptyVar = true;
                            x.childrenMap.colEndDate.childrenMap.endDate.setError('End Date must have a value');
                          }
                        }
                        if(!startDateEmpty && !endDateEmptyVar){
                          if(environment == 'WCPDEV' || ((environment == 'IMPL'))){
                          var mapCostingAllocation = Mapping.mapAllocationData(loopWorkerAllocation.getChildren(), (getWorkerData.data[0] ?? ''), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), ( pageVariables.validationDate), 'sendBack', (getCostingAllocationRequest.position.id ?? ''));
                          var errorPayload = (Validation.allocationValidation(mapCostingAllocation, (individualEarnings.value ?? ''), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), 'sendBack') ?? []);
                          }else{
                          var mapCostingAllocation = Mapping.mapAllocationData(loopWorkerAllocation.getChildren(), (getWorkerData.data[0] ?? ''), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), pageVariables.validationDate, 'sendBack', (getCostingAllocationRequest.position.id ?? ''));
                          var errorPayload = (Validation.allocationValidation(mapCostingAllocation, (individualEarnings.value ?? ''), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), 'sendBack') ?? []);
                          }
                          pageVariables.percentageData1 = Validation.getPercentageData(setPercentage.getRows(), (pageVariables.gridFunction ?? []), date:now());
                          setGridError(setPercentage.getRows(), errorPayload, errorWidget);
                          if(!empty(pageVariables.percentageData1)){
                            ds.data = {
                                'gridData': pageVariables.percentageData1
                            }
                          }
                        }
                      %>"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "validation",
                  "visible": false,
                  "value": "<% '' %>"
                },
                {
                  "type": "hidden",
                  "id": "costCenterManager",
                  "value": "<% getgridCostCenterManager(setPercentage, pageVariables.onLoadApprovers); %>"
                },
                {
                  "type": "text",
                  "id": "earningCostingAllocationRequestID",
                  "label": "test",
                  "visible": false,
                  "enabled": "<%  false %>",
                  "value": "<% list:isList(earningDataValue.extendData)? (((earningDataValue.extendData[0] ?? '').earningRequestTransactionID) ?? '') : ((earningDataValue.extendData ?? '').earningRequestTransactionID) %>"
                },
                {
                  "type": "dynamicSection",
                  "_type": "text",
                  "id": "ds",
                  "data": "<% pageVariables.percentData1 ?? {:} %>",
                  "dataVariableName": "allocationData",
                  "children": [
                    {
                      "type": "grid",
                      "id": "viewAllocation",
                      "enabled": false,
                      "label": "View Allocation",
                      "rowVariableName": "row",
                      "rows": "<% allocationData.gridData ?? [] %>",
                      "dynamicColumns": {
                        "type": "dynamicColumns",
                        "columns": "<%  pageVariables.dynamicGrid ?? [] %>",
                        "columnVariableName": "aColumn",
                        "id": "<% aColumn.id %>",
                        "columnId": "<% aColumn.id %>",
                        "label": "<% aColumn.name %>",
                        "templateId": "<% aColumn.type %>",
                        "attributeName": "<% aColumn.dataField %>"
                      },
                      "cellTemplates": [
                        {
                          "type": "cellTemplate",
                          "templateId": "string",
                          "id": "cellTemplateID",
                          "template": {
                            "type": "text"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "text",
              "id": "errorWidget",
              "visible": false,
              "value": "<% '' %>"
            }           
          ]
        },
        {
          "type": "editButtonBar",
          "editButtons": [
            {
              "type": "editButton",
              "label": "Submit",
              "id": "submit",
              "buttonType": "PRIMARY",
              "ignoreRequiredFields": "true"
            },
            {
              "type": "editButton",
              "label": "Cancel",
              "id": "cancel",
              "buttonType": "AUXILIARY",
              "ignoreRequiredFields": "true"
            }
          ]
        }
      ]
    },
    "pageType": "EDIT"
  }
}