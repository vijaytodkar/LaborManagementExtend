{
  "id": "CostingAllocationSendBack",
  "endPoints": [
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getEarningsWorkday",
      "authType": "sso",
      "httpMethod": "GET",
      "url": "/GetReferencessSync/launch?referenceID=Earning_Code"
    },
    {
      "name": "workerMe",
      "url": "/workers/me",
      "exclude": "false",
      "authType": "sso",
      "baseUrlType": "WORKDAY-COMMON",
      "bestEffort": true
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getProjectData",
      "authType": "laborISUV2",
      "_exclude": "<% empty id %>",
      "deferred": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT project_worktag, cf_assignmentAllocationObject as assignmentAllocation FROM projects ' + attrstore.ProjectHierarchy + '  project_worktag IN(\\'' + id + '\\') AND  inactive_Current = false ');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorktags",
      "authType": "laborISUV2",
      "deferred": true,
      "_url": "<% 
       return '/data?query=' + string:urlEncode('PARAMETERS taggableType = (Taggable_Type_ID= ' + taggableType + ' ) SELECT worktagWithRelatedWorktags, relatedWorktagsForOperationalTransactionType FROM relatedWorktags (taggableTypes = (Taggable_Type_ID= ' + taggableTypes.join(', ') + ' ) ) WHERE worktagWithRelatedWorktags in ( \\''+ worktag + '\\')') %>",
       "url": "<% 
       return '/data?query=' + string:urlEncode('PARAMETERS taggableType = (Taggable_Type_ID= ' + taggableType + ' ) SELECT worktagWithRelatedWorktags, relatedWorktagsForOperationalTransactionType{workdayID as id, cf_CFXTNDWorktagDescriptor as descriptor} FROM relatedWorktags (taggableTypes = (Taggable_Type_ID= ' + taggableTypes.join(', ') + ' ) ) WHERE worktagWithRelatedWorktags in ( \\''+ worktag + '\\')') %>"       

    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getGrantDeferred",
      "authType": "laborISUV2",
      "deferred": true,
      "_url": "<% '/data?query=' + string:urlEncode('SELECT grant, effectiveAwardLine{toDate, awardLineSalaryCap} as effectiveAwardLine, isGrantAssociatedWithSalaryCap as hasSalaryCap, salaryCapForGrant FROM grants WHERE inactive = false AND grant IN(\\'' + id + '\\')') %>",
      "url": "<% '/data?query=' + string:urlEncode('SELECT grant, effectiveAwardLine{toDate, awardLineSalaryCap,awardLineSalaryCapOverride} as effectiveAwardLine, isGrantAssociatedWithSalaryCap as hasSalaryCap, salaryCapForGrant FROM grants WHERE inactive = false AND grant IN(\\'' + id + '\\')') %>"
    },
    {
      "name": "bpEventStep",
      "baseUrlType": "WORKDAY-BP",
      "url": "<% 
        //var query = '/eventSteps/' + queryParams.eventStepId;
        var query = '/eventSteps/' + (!empty(queryParams.eventStepId ) ? queryParams.eventStepId : flowVariables.eventStepId);
        return query; 
      %>",
      "authType": "sso"
    },
    {
      "name": "eventInfo",
      "baseUrlType": "WORKDAY-BP",
      "url": "<% '/events/' + bpEventStep.event.id  %>",
      "authType": "sso"
    },
    {
      "name": "getCostingAllocationRequest",
      "baseUrlType": "WORKDAY-APP",
      "exclude": "<% empty(eventInfo['for'].id) %>",
      "url": "<% '/costingAllocationRequestTransactions/' + eventInfo['for'].id %>",
      "authType": "laborISUV2"
    },
    {
      "name": "getCurrentWorker",
      "baseUrlType": "Workday-WQL",
      "url": "<% '/data?query=' + string:urlEncode('SELECT worker FROM processingWorker'); %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getFunds",
      "authType": "laborISUV2",
      "_url": "<%
        return  '/data?query=' + string:urlEncode('SELECT fund FROM funds WHERE inactive = false') %>",
      "url": "<% return  '/data?query=' + string:urlEncode('SELECT fund FROM funds WHERE inactive = false AND includedInFundHierarchies not in (Fund_Hierarchy_ID=\\'FDL1_Labor_Costing_Validation\\') ' ) %>"
    },
     {
      "baseUrlType": "Workday-WQL",
      "name": "getRestrictedFunds",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% return  '/data?query=' + string:urlEncode('SELECT workdayID as id,referenceID1 as refID, fundName as descriptor FROM funds WHERE inactive = false AND includedInFundHierarchies not in (Fund_Hierarchy_ID=\\'FDL1_Labor_Costing_Validation\\') AND workdayID = \\'' + id + '\\'' ) %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getCostCenter",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT costCenter FROM costCenters WHERE inactive = false') %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getGrant",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT grant FROM grants WHERE inactive = false') %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getProjectDeferred",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<%  return '/data?query=' + string:urlEncode('SELECT project_worktag, projectEndDate, projectStartDate FROM projects ' + attrstore.ProjectHierarchy + '  project_worktag IN(\\'' + id + '\\') AND  inactive_Current = false  ') %>"
    },    
     {
      "baseUrlType": "Workday-WQL",
      "name": "getProjectSearch",
      "authType": "laborISUV2",
      "exclude": "<% empty instanceListQuery %>",
      "deferred": true,
      "_url": "<%  return '/data?query=' + string:urlEncode('SELECT project_worktag FROM projects ' + attrstore.ProjectHierarchy + ' WHERE  referenceID1 CONTAINS(\\'' + instanceListQuery + '\\') OR projectName CONTAINS(\\'' + instanceListQuery + '\\') ') %>",
      "url": "<%  return '/data?query=' + string:urlEncode('SELECT project_worktag FROM projects ' + attrstore.ProjectHierarchy + '  referenceID1 CONTAINS(\\'' + instanceListQuery + '\\') OR projectName CONTAINS(\\'' + instanceListQuery + '\\') ') %>"
    },
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getGift1",
      "authType": "laborISUV2",
      "httpMethod": "GET",
      "url": "/GetReferencessSync/launch?referenceID=Gift_Reference_ID"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getGift",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT gift FROM gifts (dataSourceFilter = giftForCompanyAndRoleAccess) WHERE  isActive = true') %>"
    },
    {
      "_baseUrlType": "Workday-WQL",
      "name": "getProject",
      "authType": "laborISUV2",
      "url": "https://api.workday.com/projects/v1/projects",
      "isCollection": "true"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getCustomOrganization",
      "authType": "laborISUV2",
      "url": "<%
        if(environment == 'WCPDEV'){
            var wql = 'SELECT planDimensionAsCustomOrganization, workdayID as id, name, referenceID1, type1 FROM customOrganizations WHERE type1 in (a6bbbc0c1916100378779ca119020000,a6bbbc0c191610037820a28c4acf0000,a6bbbc0c1916100378779d3aaff30000,cc7f0548812d100ed16fa9689de10000)';
        }else{
            var wql = 'SELECT planDimensionAsCustomOrganization, workdayID as id, name, referenceID1,  type1 FROM customOrganizations WHERE (type1 IN (Organization_Type_ID = Activity) OR type1 IN (Organization_Type_ID = Budget_Unit) OR type1 IN (Organization_Type_ID = Center) OR type1 IN (Organization_Type_ID = Assignment_Allocation))  AND inactive = false';
        }
        return '/data?query=' + string:urlEncode(wql);
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getCostCenterRoles",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<%
          return '/data?query=' + string:urlEncode('SELECT costCenter, cf_XTNDLBCARICostCenterWorkforceManager as workforceManagerAssigned, cf_XTNDLBCARICostCenterWorkforceManagerInherited as workforceManagerInherited FROM costCenters WHERE costCenter in (\\'' + id + '\\')') 
       %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getEarningGroups",
      "deferred": true,
      "authType": "laborISUV2",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id FROM labormanagement_v3_gnqwhx_earningGroups WHERE ON earnings earningId = \\'' + earningID + '\\' WHERE EarningGroup IN (\\'' + earningGroups  +'\\')');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorkerData",
      "authType": "laborISUV2",
      "exclude": "<% empty(getCostingAllocationRequest.worker.id); %>",
      "url": "<%
      return '/data?query=' + string:urlEncode('SELECT worker, allPositions as positions,cf_CurrentOpenPayPeriod_StartDate as currentPayPeriod, cf_XTNDLBCEMIWorkerCompensation{compensationPlan,amount,compensationElement,frequency} AS compensationPlansRBO,FTE, positionWorkerType as workerType, hireDate FROM allWorkers WHERE worker IN (\\'' + getCostingAllocationRequest.worker.id + '\\')') 
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getDefaultWorkTags",
      "exclude": "<% empty(empty(getWorkerData.data[0].positions[0].id)) %>",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT costCenter, company, cf_Location1, fund, grant, program, gift, cf_XTNDLBCBudgetUnitOnPosition1 as budgetUnit,cf_XTNDLBCCenterOnPosition1 as center, cf_XTNDLBCAllocationorgonposition as assignmentAllocation, cf_XTNDLBCActivityOnPosition1 as activity FROM indexedPositionsAndJobs_AllStaffingModels WHERE positionAndJob_AllStaffingModels IN (\\'' + getWorkerData.data[0].positions[0].id + '\\')') %>"
    },
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getCostingAllocationWorkday",
      "authType": "laborISUV2",
      "httpMethod": "GET",
      "exclude": "<% empty(getWorkerData.data[0].worker.id) %>",
      "url": "<%
              return '/getCostingAllocations/launch?workerID=' + getWorkerData.data[0].worker.id;

      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getActiveCostingAllocationTransaction",
      "authType": "laborISUV2",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id, costingAllocationEarningsTransaction, sendBackComment FROM labormanagement_v3_gnqwhx_costingAllocationRequestTransactions WHERE workdayID = (\\''+  eventInfo['for'].id +'\\')');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getTransactionEarningData",
      "authType": "laborISUV2",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id, earningGroup,hasRetroactiveAllocation, earningGroup{earnings} as earningGroupRBO, costingAllocationIntervalsTransaction, cf_XTNDARIEarningIDOnEarningRequestTransaction{earningId} as earningID, costingAllocationIntervalsTransaction{startDate, endDate, indefinite, isCurrentPayPeriod, costingAllocationLineDetailTransaction} as intervalData, cf_XTNDARICostingAllocationTransactionLineDataToEarningTransaction{workdayID, fund, isUpdated, budgetUnit, activityType, costCenter, center, grantDescriptor, grantId, gift, project, allocationPercent, isRetroActive, comment, clinicalAssignment, workdaySOCLineData} as lineData FROM labormanagement_v3_gnqwhx_costingAllocationEarningRequestTransactions WHERE costingAllocationRequestTransaction IN (\\''+ getActiveCostingAllocationTransaction.data[0].id +'\\')');
      %>"
    },
    {
      "baseUrlType": "WORKDAY-APP",
      "name": "getEarnings",
      "authType": "laborISUV2",
      "url": "<% '/earningGroups' %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getEarningGroupFromAdminPage",
      "authType": "laborISUV2",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id, earningSortOrder, earningGroupName, earnings{workdayID as id, earningId, earningDescriptor} as earnings FROM labormanagement_v3_gnqwhx_earningGroups WHERE earningGroupFromAdminPage = true ORDER BY earningSortOrder ASC ');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getCostingAllocationTransaction",
      "authType": "laborISUV2",
      "httpMethod": "GET",
      "exclude": "<% empty(getWorkerData.data[0].worker.id) %>",
      "url": "<%
        return '/data?query=' + string:urlEncode('SELECT worker,sendBackComment, workdayID, status, approver, approver{action, workdayID as id, worker, approved, approvalDate} as approvals FROM labormanagement_v3_gnqwhx_costingAllocationRequestTransactions WHERE worker IN(\\''+ (getWorkerData.data[0].worker.id ?? '') +'\\') AND workdayID = (\\''+  eventInfo['for'].id +'\\') and approver is not empty');

      %>"
    },
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getSalaryOverCap",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% 
        
          return '/getSalaryOverTheCap/launch?id=' + salaryCapID;
        
        %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getSalaryOverTheCap",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT SalaryOverTheCap,budgetUnitId,  fund, budgetUnitDescriptor,activityId,  costCenterId,centerId, grantId, giftId, projectId, clinicalAssignmentId, activityDescriptor, costCenterDescriptor, centerDescriptor, grantDescriptor, giftDescriptor, projectDescriptor, clinicalAssignmentDescriptor, allocationPercent FROM labormanagement_v3_gnqwhx_salaryOverTheCaps WHERE costingAllocationLineDetailsTransaction IN(\\'' + id + '\\')') 
      %>"
    }
  ],
  "outboundData": {
    "outboundEndPoints": [
      {
        "name": "patchApprover",
        "httpMethod": "PATCH",
        "exclude": "<% cancel.value || empty pageVariables.patchApprovers %>",
        "baseUrlType": "WORKDAY-APP",
        "authType": "laborISUV2",
        "onSend": "<%                   

          return {'data': pageVariables.patchApprovers};
        %>",
        "url": "/approvers?bulk=true"
      },
      {
        "name": "postApprovers",
        "httpMethod": "POST",
        "exclude": "<% cancel.value || empty pageVariables.postApprovers %>",
        "baseUrlType": "WORKDAY-APP",
        "url": "/approvers?bulk=true",
        "authType": "laborISUV2",
        "onSend": "<%
          return {'data': pageVariables.postApprovers};
        %>"
      },
      {
        "name": "patchCostingAllocationRequestTransaction",
        "httpMethod": "PATCH",
        "exclude": "<% cancel.value %>",
        "baseUrlType": "WORKDAY-APP",
        "authType": "laborISUV2",
        "url": "<% '/costingAllocationRequestTransactions/' +  eventInfo['for'].id %>",
        "onSend": "<%
          var postApproverBody = (postApprovers.data.map(y=>{{'id': (y.body.id ?? '')}}) ?? {}) ?? [];
          var patchApproverBody = (patchApprover.data.map(y=>{{'id': (y.body.id ?? '')}}) ?? {}) ?? [];
          if((!empty(patchApproverBody) && !empty(postApproverBody))){
            var joinedApprovers = list:join((patchApproverBody ?? []), (postApproverBody ?? []) );
          }else if(!empty(patchApproverBody)){
            var joinedApprovers = patchApproverBody ?? [];

          }else if(!empty(postApproverBody)){
            var joinedApprovers = postApproverBody ?? [];
          }
          if(!empty(joinedApprovers)){
            var submitData = {
              'approver': (joinedApprovers ?? []),
              'status': 'Pending Approval'
            }
          }else{
            var submitData = {
              'status': 'Pending Approval'
            }
          }
          return submitData;
        %>"
      },
      {
        "name": "postDataTransactions",
        "httpMethod": "POST",
        "authType": "laborISUV2",
        "exclude": "<% cancel.value %>",
        "baseUrlType": "WORKDAY-ORCHESTRATION",
        "url": "/SubmitCostingAllocationTransaction/launch",
        "onSend": "<%
          var submitData = self.data ?? [];
          return submitData;
        %>",
        "values": [
          {
            "value": "<% pageVariables.submitData %>",
            "outboundPath": "submitData"
          },
          {
            "value": "<% (transactionID.value ?? '') %>",
            "outboundPath": "costingAllocationTransactionid"
          },
          {
            "value": "<% getCostingAllocationRequest.costingAllocationRequest.id ?? ''  %>",
            "outboundPath": "costingAllocationRequest"
          },
          {
            "value": "<% getActiveCostingAllocationTransaction.data ?? [] %>",
            "outboundPath": "activeCostingAllocationTransactions"
          },
          {
            "value": "<% 'sendBack' %>",
            "outboundPath": "transactionType"
          }
        ]
      },
      {
        "name": "submitStep",
        "baseUrlType": "WORKDAY-BP",
        "_url": "/eventSteps/<%(!empty queryParams.eventStepId  ?  queryParams.eventStepId  : '') %>/submit",
        "url": "/eventSteps/<% (!empty(queryParams.eventStepId ) ? queryParams.eventStepId : flowVariables.eventStepId) %>/submit",
        "exclude": "<% cancel.value %>",
        "httpMethod": "POST",
        "authType": "sso",
        "onSend": "<% return self.data; %>",
        "values": [
          {
            "outboundPath": "stepAction.id",
            "value": "<% 'd9e4223e446c11de98360015c5e6daf6' %>"
          }
        ]
      },
      {
        "name": "deleteApprovers",
        "httpMethod": "POST",
        "exclude": "<% cancel.value || empty pageVariables.deleteApprover %>",
        "baseUrlType": "WORKDAY-ORCHESTRATION",
        "url": "/deleteApprovers/launch",
        "authType": "laborISUV2",
        "onSend": "<%
          return {'data': pageVariables.deleteApprover.map(u =>{{'id': u.id}})};
        %>"
      },
      {
        "_comment": "Added By pasha 11/05 MCW14351",
        "name": "sendNotification",
        "authType": "laborISUV2",
        "url": "<% '/sendMessage' %>",
        "httpMethod": "POST",
        "baseUrlType": "WORKDAY-CONNECT",
		"exclude": "<% empty(pageVariables.notifyApprovers) %>",
        "onSend": "<% 
          var notificationBody ={

            'notificationType': {
              'id': attrstore.notificationType
            },
            'emailDetail': {
              'name':'Approve Costing Allocation',
              // 'body': 'A Labor Costing Allocation Approval is required for ' +  (getCostingAllocationRequest.worker.descriptor  ?? 'UNKOWN') + '. \\n Please Navigate to the \\'Labor Costing Allocation Dashboard\\'. or utilize the following URL: ' + ( (environment ?? '' ) == 'PROD' ? 'https://wd503.myworkday.com/' : 'https://impl.wd503.myworkday.com/') + tenant + '/d/wday/app/' + site.applicationId + '/' + site.applicationId + '/ApprovalDashboard.htmld',
            //   'body': 'A Labor Costing Allocation Approval is required for ' +  (! empty getWorkerData.data[0].worker.descriptor  ? getWorkerData.data[0].worker.descriptor  : ! empty getPrehireWorkerData.data[0].worker.descriptor ? getPrehireWorkerData.data[0].worker.descriptor  : '') + '.Please Navigate to the \\'Labor Costing Allocation Dashboard\\' to complete the action.',
            // A Labor Costing Allocation Approval is required for (keep code for auto-fill of worker's name).  Please navigate to the 'Labor Costing Allocation Dashboard' to complete the action.
             'body':  ' <b> A Labor Costing Allocation Approval is required for </b>' +  (! empty getWorkerData.data[0].worker.descriptor  ? getWorkerData.data[0].worker.descriptor  : ! empty getPrehireWorkerData.data[0].worker.descriptor ? getPrehireWorkerData.data[0].worker.descriptor  : '') + '.Please Navigate to the \\'Labor Costing Allocation Dashboard\\' to complete the action.',
              'subject': 'Approve Costing Allocation'
            },
            'recipients': {
              'contacts': !empty(pageVariables.notifyApprovers.map(t =>{{'id': t}})) ? (pageVariables.notifyApprovers.map(t =>{{'id': t}}).distinct()) : []
            }
          };
          return notificationBody;
         %>"
  },
      {
        "type": "outboundVariable",
        "name": "outboundFlow",
        "variableScope": "flow",
        "values": [
          {
            "outboundPath": "enviro",
            "value": "<% tenant ?? '' %>"
          },
          {
            "value": "<% console.info('patchCostingAllocationRequestTransaction: ', json:asJSON(patchCostingAllocationRequestTransaction ?? '')); console.info('patchApprover: ', json:asJSON(patchApprover ?? '')); %>",
            "outboundPath": "RankID"
          },
          {
            "outboundPath": "salaryCap",
            "value": "<% pageVariables.salaryOvertheCap ?? [] %>"
          },
          
          {
            "outboundPath": "transactionID",
            "_value": "<% eventInfo['for'].id ?? '' %>",
            "value": "<%eventInfo['for'].id ?? (flowVariables.transactionID ?? '')%>"
          },
          {
            "outboundPath" : "eventStepId",
            "value": "<% (!empty(queryParams.eventStepId ) ? queryParams.eventStepId : flowVariables.eventStepId) %>"
          },
          {
            "outboundPath": "bpEventStepId",          
            "value": "<% (!empty(bpEventStep.event.id) ? bpEventStep.event.id : flowVariables.bpEventStepId)%>"
          },
          {
            "outboundPath": "worker",
            "value": "<% getWorkerData.data[0].worker.id ?? ''%>"
          },
          {
            "outboundPath": "approvalWorkers",
            "value": "<% 
              var postApproverBody = (postApprovers.data.map(y=>{(y.body.worker.id ?? '')}) ?? {}) ?? [];
              var patchApproverBody = (patchApprover.data.map(y=>{(y.body.worker.id ?? '')}) ?? {}) ?? [];
              if((!empty(patchApproverBody) && !empty(postApproverBody))){
                var joinedApprovers = list:join((patchApproverBody ?? []), (postApproverBody ?? []) );
              }else if(!empty(patchApproverBody)){
                var joinedApprovers = patchApproverBody ?? [];
              }else if(!empty(postApproverBody)){
                var joinedApprovers = postApproverBody ?? [];
              }
              return joinedApprovers ?? [];
            %>"
          },
          {
            "outboundPath": "transactionType",
            "value": "<% 'SendBack' %>"
          },
          {
            "outboundPath": "approvers",
            "value": "<% 
              var postApproverBody = (postApprovers.data.map(y=>{(y.body.id ?? '')}) ?? {}) ?? [];
              var patchApproverBody = (patchApprover.data.map(y=>{(y.body.id ?? '')}) ?? {}) ?? [];
              if((!empty(patchApproverBody) && !empty(postApproverBody))){
                var joinedApprovers = list:join((patchApproverBody ?? []), (postApproverBody ?? []) );
              }else if(!empty(patchApproverBody)){
                var joinedApprovers = patchApproverBody ?? [];
              }else if(!empty(postApproverBody)){
                var joinedApprovers = postApproverBody ?? [];
              }
              return joinedApprovers ?? [];
             %>"
          }
        ]
      }
    ]
  },
  "include": [
    "Validation.script",
    "Mapping.script",
    "Queries.script",
    "GridScripts.script"
  ],
  "script": "<%
    var getSalaryOverTheCapLines = function(salaryOverTheCapLines){
      var salaryLine = salaryOverTheCapLines ?? [];
      var salaryOverTheCapData = [];
      for(var y: salaryLine){
        var salarydata = getSalaryOverTheCap.invoke({'id': y.id}).data ?? [];
        salarydata = salarydata.map(u =>{u.costCenterId ?? ''});
        salaryOverTheCapData = salaryOverTheCapData.addAll(salarydata);
      }
      return list:distinct(list:flatten(salaryOverTheCapData ?? []));
    } 
    var getgridCostCenterManager = function(grid, onLoadApprover){
      var approvers = onLoadApprover ?? [];
      for(var t : grid.rows){
        var costCenter = (t.childrenMap.colCostCenterWorktag.childrenMap.CostCenterWorktag.value[0] ?? '');
        var costCenterInvoked = getCostCenterRoles.invoke({'id': costCenter}) ?? {:};
          if(!empty(approvers[0].approvals.filter(l =>{((costCenterInvoked.data[0].workforceManagerInherited.map(x =>{x.id ?? ''}) ?? []).contains(l.worker.id ?? ''))  || ((costCenterInvoked.data[0].workforceManagerAssigned.map(x =>{x.id ?? ''}) ?? []).contains(l.worker.id ?? ''))}))){
            if(!empty(costCenterInvoked.data[0].workforceManagerAssigned.map(t =>{t.id}))){
              t.childrenMap.colCostCenterWorktag.childrenMap.workForceManager.setValue(costCenterInvoked.data[0].workforceManagerAssigned.map(x =>{x.id ?? ''}).join() ?? '');
            }else if(costCenterInvoked.data[0].workforceManagerInherited.map(t =>{t.id})){
              t.childrenMap.colCostCenterWorktag.childrenMap.workForceManager.setValue(costCenterInvoked.data[0].workforceManagerInherited.map(x =>{x.id ?? ''}).join() ?? '');
            }
          }
      }
    }
    var getTransactionStatus = function(submit, approversRemaining, currentWorker, approver){
       if(submit ?? false){
        if(!empty((approversRemaining[0].approverRBO.map(q =>{q.id}).removeAll([approver]) ?? []))){
          return 'Pending Approval';
        }else{
          return 'Final Approval';
        }
      }
    }
      var setGridError = function(grid, errorPayload, errorWidget){
      var gridRows = grid ?? [];
      var errorPayloadMappedIndefinite = errorPayload.errorArray.filter(x =>{((x.indefinite?? false) == true)}).map(x =>{{'startDate': (x.periodStartDate ?? ''), 'endDate': (x.periodEndDate ?? ''), 'errorText': (x.errorText ?? ''), 'indefinite': (x.indefinite ?? false)}}) ?? [];
      var errorPayloadMappedNotInfinite = errorPayload.errorArray.filter(x =>{((x.indefinite ?? false) == false)}).map(x =>{{'startDate': (x.periodStartDate ?? ''), 'endDate': (x.periodEndDate ?? ''), 'errorText': (x.errorText ?? ''), 'indefinite': (x.indefinite ?? false), 'sumIsZero': (x.sumIsZero ?? false)}}) ?? [];
      var indefiniteTotal = 0;
      var hasIndefinite = false;
    // if(empty(gridRows) && submit.value){  
    /*  if(empty(gridRows)){        
        errorWidget.setError('Please enter values in the grid');
      }else{
        errorWidget.clearError();
      } */
      for(var y : gridRows){
        var startDateWidget = (y.childrenMap.colStartDate.childrenMap.startDate ?? '');
        var endDateWidget = (y.childrenMap.colEndDate.childrenMap.endDate ?? '');     
         var selectedGrant = ( y.childrenMap.colGrantWorktag.childrenMap.grantWorktag.selectedEntries[0].descriptor ?? '');        
        var selectedProject = (y.childrenMap.colProjectWorktag.childrenMap.projectWorktag.selectedEntries[0].descriptor ?? '');
        var selectedGift =  ( y.childrenMap.colallRemainingWorktag.childrenMap.allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Gift:')}) ?? {:});
         var fundWorktagWidget = (y.childrenMap.colFundWorktag.childrenMap.fundWorktag ?? '');
        var mcwFund = (y.childrenMap.colFundWorktag.childrenMap.fundWorktag.value[0] ?? '');
         var fundWorktagWidgetDescriptor = fundWorktagWidget.selectedEntries[0].descriptor ?? '' ;        
        var validateFund =  getRestrictedFunds.invoke({'id':mcwFund}) ?? [];
         if(empty(validateFund.data))
         {            
            fundWorktagWidget.setError('Fund is Restricted Fund : ' + fundWorktagWidgetDescriptor);
         }else
         {
           fundWorktagWidget.clearError();
         }    
         if(fundWorktagWidgetDescriptor.contains('102.U')){        
        if(empty(selectedGrant)) {                
                fundWorktagWidget.setError('Grant cannot be empty with this Fund');                
              }else{
                fundWorktagWidget.clearError();
              }  
          }
          if(fundWorktagWidgetDescriptor.contains('103.U') || fundWorktagWidgetDescriptor.contains('119.U')|| fundWorktagWidgetDescriptor.contains('123.U')|| fundWorktagWidgetDescriptor.contains('131.U')|| fundWorktagWidgetDescriptor.contains('156.U')|| fundWorktagWidgetDescriptor.contains('164.U')|| fundWorktagWidgetDescriptor.contains('168.U')|| fundWorktagWidgetDescriptor.contains('300.U')|| fundWorktagWidgetDescriptor.contains('350.U')|| fundWorktagWidgetDescriptor.contains('400.U')|| fundWorktagWidgetDescriptor.contains('700.U')|| fundWorktagWidgetDescriptor.contains('706.U')|| fundWorktagWidgetDescriptor.contains('772.U')){
          if(empty(selectedProject)){
                fundWorktagWidget.setError('Project cannot be empty with this Fund');                
              }else{
                fundWorktagWidget.clearError();
              }
        }
         if(fundWorktagWidgetDescriptor.contains('116.U') || fundWorktagWidgetDescriptor.contains('117.P')|| fundWorktagWidgetDescriptor.contains('117.T')|| fundWorktagWidgetDescriptor.contains('117.U')|| fundWorktagWidgetDescriptor.contains('118.T')|| fundWorktagWidgetDescriptor.contains('118.U')|| fundWorktagWidgetDescriptor.contains('150.U')|| fundWorktagWidgetDescriptor.contains('150.T')){
            if(empty(selectedGift)){
                fundWorktagWidget.setError('Gift cannot be empty with this Fund');                
              }else{
                fundWorktagWidget.clearError();
              }
        }
        var indefiniteWidget = (y.childrenMap.colIndefinite ?? {:});
        hasIndefinite = (hasIndefinite == false)? indefiniteWidget.value : true;
        var errorExists = !(indefiniteWidget.value)? (errorPayloadMappedNotInfinite.filter(x => {(((x.startDate.between(endDateWidget.value, 'DAY') >= 0) && (x.endDate.between(startDateWidget.value, 'DAY')<= 0) ))})).map(x => {x.errorText}) : [];
        var errorExistsIndefinite = (indefiniteWidget.value)? (errorPayloadMappedIndefinite ?? []).map(x => {x.errorText}) ?? [] : [];
        var errorString = (!empty(errorExists)?(errorExists.join(', ')): '') +  (!empty(errorExistsIndefinite)?(errorExistsIndefinite.join(', ')): '') ;
        if(!empty(errorString)){
            startDateWidget.setError(errorString ?? '');
        }else{
            startDateWidget.clearError();
        }
        if(indefiniteWidget.value){
          indefiniteTotal= indefiniteTotal + number:toBigDecimal((y.childrenMap.colPercent.childrenMap.percentAmountSection.childrenMap.percentAmount.value ?? 0), 2, 'CEILING');
        }
      }
      var zeroError = errorPayloadMappedNotInfinite.filter(x => {x.sumIsZero == true}).map(x => {x.errorText});
      if(!empty(zeroError)){
        var errorString = (!empty(zeroError)?( zeroError.join(', ')) : '');
        errorWidget.setError(errorString);
      }else if(empty(gridRows)){
         errorWidget.setError('Please enter values in the grid.');
      }else {
         errorWidget.clearError();
      }
      
      if(hasIndefinite){
        var indefiniteWidget = (y.childrenMap.colIndefinite ?? {:});
        if((indefiniteTotal < 100) || (indefiniteTotal > 100)){
          indefiniteWidget.setError('Indefinite must add up to 100 %');
        }else{
          indefiniteWidget.clearError();
        }
      }
    }
    var getDefaultWorktagsScript = function(defaultEndpoint){
      var endpoint = defaultEndpoint.data[0] ?? {:};
      var budgetUnit = endpoint.budgetUnit[0] ?? {:};
      var costCenter = endpoint.costCenter[0] ?? {:};
      var company = endpoint.company ?? {:};
      var fund = endpoint.fund[0] ?? {:};
      var grant = endpoint.grant[0] ?? {:};
      var gift = endpoint.gift[0] ?? {:};
      var center = endpoint.center[0] ?? {:};
      var clinicalAssignment = endpoint.assignmentAllocation[0] ?? {:};
      var activity = endpoint.activity[0] ?? {:};
      return list:nonNull(list:toListIncludeNull( budgetUnit, costCenter, company, fund, activity,  grant, gift, center, clinicalAssignment));
    }
   %>",
  "onLoad": "<%   
    pageVariables.hireDate = getWorkerData.data[0].hireDate ?? '';
    pageVariables.validationDate = ((pageVariables.hireDate ?? '') >= ((! empty getWorkerData.data[0].currentPayPeriod ? getWorkerData.data[0].currentPayPeriod : ! empty getPrehireWorkerData.data[0].currentPayPeriod ? getPrehireWorkerData.data[0].currentPayPeriod  : date:now()))) ? pageVariables.hireDate : ((! empty getWorkerData.data[0].currentPayPeriod ? getWorkerData.data[0].currentPayPeriod : ! empty getPrehireWorkerData.data[0].currentPayPeriod ? getPrehireWorkerData.data[0].currentPayPeriod  : date:now()));
    pageVariables.workerType = getWorkerData.data[0].workerType ?? '';
    pageVariables.onLoadApprovers = getCostingAllocationTransaction.data ?? [];
    var initialDataMapped = Mapping.mapAllocationDataOnLoadSendBack((getTransactionEarningData ?? []), getCostingAllocationWorkday, (getEarningGroupFromAdminPage.data ?? []));
     pageVariables.initialAllocationData = initialDataMapped;   
    var allStartDates = [];
    for (var x : pageVariables.initialAllocationData){     
      for (var y : (x.extendData ?? [])){             
        for (var z : (y.lineData ?? [])){              
            allStartDates.add(z.startDate);
        }
      }
    }    
     var mostStartDate = allStartDates.sort()[0] ?? '';    
     var convStartDate = date:parse(mostStartDate) ?? '';  
    pageVariables.requestType = flowVariables.requestType ?? 'View';
    pageVariables.hasPendingTransactions = !empty(getCostingAllocationTransaction.data);
    pageVariables.allEarningGroups = getEarnings.data ?? [];
    pageVariables.assignmentallocations = (getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Assignment Allocation'}).map(x =>{{'descriptor': ('Assignment Allocation:'+ ((x.name ?? ''))), 'id': x.id}}) ?? []);
    pageVariables.allWorkTags =[];
    pageVariables.allWorkTags.addAll(getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Center'}).map(x =>{{'descriptor': ('Center:'+ ((x.referenceID1 ?? '') +(x.name ?? ''))), 'id': x.id}}) ?? []);
    pageVariables.allWorkTags.addAll((getGift.data.map(x =>{{'descriptor': ('Gift:'+ x.gift.descriptor), 'id': x.gift.id}}) ?? []));
    pageVariables.defaultWorktags = getDefaultWorktagsScript(getDefaultWorkTags); 
    if (!empty(convStartDate)) {
    pageVariables.gridFunction = GridScripts.getDatesArray(convStartDate, convStartDate.add('MONTH', 6), 'MONTH', 'prompt');
    }
    pageVariables.dynamicGrid = [];
    var workTagPayload = {
      'name': 'WorkTags',
      'id': 'workTag',
      'type': 'string',
      'dataField': 'WorkTags'
    }
    pageVariables.dynamicGrid.add(workTagPayload);
    for (var numCol : pageVariables.gridFunction){
      var colPayload = {
        'name': numCol.periodStartDate.format('MMM-dd-yyyy') + ' - ' + numCol.periodEndDate.format('MMM-dd-yyyy'),
        'id': numCol.id,
        'type': 'string',
        'dataField': numCol.periodStartDate.format('MMM-dd-yyyy') + ' - ' + numCol.periodEndDate.format('MMM-dd-yyyy')
      };
      pageVariables.dynamicGrid.add(colPayload);
    }
    pageVariables.workersCompensation = ! empty getWorkerData.data[0].compensationPlansRBO  ? getWorkerData.data[0].compensationPlansRBO  : [];
    pageVariables.fte =  ! empty getWorkerData.data[0].FTE  ? getWorkerData.data[0].FTE : '';
    var amountList = 0;                            
    var earningGroupsfromAdmin  = getEarningGroupFromAdminPage.data ?? [];
    for(var t: earningGroupsfromAdmin){
      var earningsGroupsEarningsMapped = t.earnings.map(y =>{y.earningDescriptor})
      for(var row : pageVariables.workersCompensation){
        var compPlanSubText = row.compensationElement.descriptor ?? '';                     
        for(var earning : (earningsGroupsEarningsMapped ?? [])){     
          var list =  (((compPlanSubText ?? '').contains(earning)) || (('Regular ' + compPlanSubText) ?? '').contains(earning));      
          if (list == true){                                      
            if(row.frequency.descriptor == 'Hourly' ){
              amountList = (row.amount.value * (pageVariables.fte  * 40)) ?? '0' + amountList;
            }else{
              amountList = row.amount.value ?? '0' + amountList;
            }
          } 
        } 
      } 
    }                     
    pageVariables.amountList = amountList;
  %>",
  "onSubmit": "<%
        event.ignoreWarnings();     
      if(environment == 'WCPDEV'){
        pageVariables.submitData = Mapping.mapAllocationData(loopWorkerAllocation.getChildren(), getWorkerData.data[0], (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), (date:now()), 'sendBack', (getCostingAllocationRequest.position.id ?? ''));
      }else{
        pageVariables.submitData = Mapping.mapAllocationData(loopWorkerAllocation.getChildren(), getWorkerData.data[0], (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), pageVariables.validationDate, 'sendBack', (getCostingAllocationRequest.position.id ?? ''));
      }      
      pageVariables.salaryOvertheCap = pageVariables.submitData.earnings.filter(x =>{x.earningGroupName == 'Base Salary'});
      pageVariables.salaryOvertheCap = pageVariables.salaryOvertheCap[0].intervalData ?? [];
      pageVariables.salaryOvertheCap = pageVariables.salaryOvertheCap.filter(y=> {y.lineData.map(q=>{q.salaryOverTheCap ?? false}).contains(true)}) ?? [];
      for(var y : (loopWorkerAllocation.getChildren()?? [])){
        var gridRows = y.children[1].childrenMap.setPercentage.rows ?? [];
          if(environment == 'WCPDEV'){
            var errorPayload = Validation.allocationValidation(pageVariables.submitData, (y.children[0].childrenMap.individualEarnings.value ?? []), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), 'sendBack') ?? [];
          }else{
            var errorPayload = Validation.allocationValidation(pageVariables.submitData, (y.children[0].childrenMap.individualEarnings.value ?? []), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? ''), 'sendBack') ?? [];
          }
        setGridError(gridRows, errorPayload, y.children[2]);
      }
      pageVariables.costCenters1 = [];
      pageVariables.costCentersUpdated = [];
        //get all cost centers workforce manager that have been updated
      for(var t: (pageVariables.submitData.earnings ?? [])){
        var intervalData = t.intervalData ?? [];
        for(var q : (intervalData ?? [])){
          // get all lines that have been updated
          if(!empty(q.lineData.filter(z =>{z.updated == true}))){
            var costCenterLineDataFiltered = q.lineData.filter(z =>{z.updated == true && !empty(z.costCenterWorkForceManager)}).map(r =>{r.costCenterWorkForceManager.split(',') ?? ''}) ?? [];
            var costCenterLineDataFiltered = list:flatten(costCenterLineDataFiltered);
            if(!empty(costCenterLineDataFiltered[0])){
              pageVariables.costCentersUpdated.addAll( (costCenterLineDataFiltered ?? ''));
            }            
          }else{
            var costCenterLineMapped = q.lineData.filter(t =>{!empty(t.costCenterWorkForceManager)}) ?? [];
            var costCenterLineMapped = costCenterLineMapped.map(r =>{r.costCenterWorkForceManager.split(',') ?? ''}) ?? [];
            var costCenterLineMapped = list:flatten(costCenterLineMapped);
            if(!empty(costCenterLineMapped[0])){
              pageVariables.costCenters1.addAll( (costCenterLineMapped ?? ''));
            }
          }
        }
      }
      pageVariables.costCenters = [];
      for(var l: pageVariables.costCenters1){
        if(!pageVariables.costCentersUpdated.contains((l ?? ''))){
          pageVariables.costCenters.add((l));
        }
      }
      pageVariables.costCentersUpdated = pageVariables.costCentersUpdated.distinct();
      pageVariables.costCenters = pageVariables.costCenters.distinct();
      pageVariables.costCentersUpdated = pageVariables.costCentersUpdated.map(x=>{{'costCenterManager': x, 'updated': true}});
      pageVariables.costCenters = pageVariables.costCenters.map(x=>{{'costCenterManager': x, 'updated': false}});
      pageVariables.patchApprovers = [];
      pageVariables.postApprovers = [];
      pageVariables.notifyApprovers = [];
      pageVariables.deleteApprover = pageVariables.onLoadApprovers[0].approvals ?? [];
      for(var t : list:join((pageVariables.costCentersUpdated ?? []), (pageVariables.costCenters ?? []))){
        if(pageVariables.costCentersUpdated.map(x => {x.costCenterManager ?? ''}).contains(t.costCenterManager)){
          var approvalObject = pageVariables.onLoadApprovers[0].approvals.filter(l =>{((l.worker.id ?? '') == t.costCenterManager)}) ?? [];
          if(!empty(approvalObject)){
            var patchPayload = {
              'worker':{
                'id': (t.costCenterManager ?? '')
              },        
               //commented by Pasha 11/05 MCW-14318     
             // 'approved': ((t.costCenterManager ?? '') == workerMe.id) ? true: false,
              'approved': ((t.costCenterManager ?? '') == workerMe.id) ? false: false,
              'costingAllocationRequest':{
                'id': (getCostingAllocationRequest.id ?? '')
              },
              'id': (approvalObject[0].id),
              //'action': ((t.costCenterManager ?? '') == workerMe.id) ? 'Approved' : ''
              'action': ''
            }
            pageVariables.deleteApprover.removeAll(approvalObject);
            pageVariables.patchApprovers.add(patchPayload);
            // added by Pasha 11/05  MCW-14351
            pageVariables.notifyApprovers.add(t.costCenterManager ?? '');
          }else{
            var postPayload = {
              'worker':{
                'id': (t.costCenterManager ?? '')
              },
              //commented by Pasha 11/05 MCW-14318
              //'approved': ((t.costCenterManager ?? '') == workerMe.id) ? true: false,
              'approved': ((t.costCenterManager ?? '') == workerMe.id) ? false: false,
              //'approved': (approvalObject[0].approved ?? false),
              'costingAllocationRequest':{
              'id': (getCostingAllocationRequest.id ?? '')
              },
              'action': ''              
            }
            pageVariables.postApprovers.add(postPayload);
            // added by Pasha 11/05  MCW-14351
            pageVariables.notifyApprovers.add(t.costCenterManager ?? '');
          }

        }else{
          var approvalObject = pageVariables.onLoadApprovers[0].approvals.filter(l =>{(l.worker.id ?? '') == t.costCenterManager}) ?? [];
          if(!empty(approvalObject)){
            var patchPayload = {
              'worker':{
                'id': (t.costCenterManager ?? '')
              },             
              'approved': (approvalObject[0].approved ?? false),
              'costingAllocationRequest':{
                'id': (getCostingAllocationRequest.id ?? '')
              },
              'action': (approvalObject[0].action ?? '')
            }
            pageVariables.deleteApprover.removeAll(approvalObject);
            pageVariables.patchApprovers.add(patchPayload);
             // added by Pasha 11/05  MCW-14351
             if( !(approvalObject[0].approved ?? false)){
              pageVariables.notifyApprovers.add(t.costCenterManager ?? '');
             }
          }else{
            var postPayload = {
              'worker':{
                'id': (t.costCenterManager ?? '')
              },
              'approved': (false),
              'costingAllocationRequest':{
                'id': (getCostingAllocationRequest.id ?? '')
              },
              'action': ''
            }
            pageVariables.postApprovers.add(postPayload);
            // added by Pasha 11/05  MCW-14351
            pageVariables.notifyApprovers.add(t.costCenterManager ?? '');
          }
        }
      }                    
  %>",
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "Send Back Costing Allocation"
    },
    "standardEditButtonsHidden": true,
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "type": "section",
          "id": "allocationOverallDetail",
          "horizontal": true,
          "children": [
            {
              "type": "section",
              "id": "workerPositionData",
              "horizontal": false,
              "children": [
                {
                  "type": "text",
                  "id": "worker",
                  "label": "Worker",
                  "enabled": false,
                  "value": "<% getWorkerData.data[0].worker.descriptor ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "position",
                  "label": "Position",
                  "enabled": false,
                  "value": "<% getWorkerData.data[0].positions[0].descriptor ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "transactionID",
                  "label": "transaction ID",
                  "enabled": false,
                  "visible": false,
                  "value": "<% getCostingAllocationRequest.id ?? '' %>"
                }
              ]
            },
            {
              "type": "section",
              "id": "allocationRequestData",
              "horizontal": false,
              "children": [
                {
                  "type": "richText",
                  "id": "defaultWT",
                  "label": "Default Worktags",
                  "enabled": false,
                  "value": "<% !empty(pageVariables.defaultWorktags)? pageVariables.defaultWorktags.map(x=>{(x.descriptor ?? '')}).join('\\n'): '' %>",
                  "multiSelect": true
                }
              ]
            },
            {
              "type": "text",
              "id": "commentSendBack",
              "label": "Send Back Comment",
              "enabled": false,
              "value": "<% getCostingAllocationTransaction.data[0].sendBackComment ?? '' %>"
            }
          ]
        },
        {
          "type": "panelList",
          "id": "loopWorkerAllocation",
          "label": "Allocations",
          "doNotRemove": true,
          "doNotAdd": true,
          "indexVariableName": "indexPanel",
          "panels": "<%
             pageVariables.initialAllocationData ?? [];
          %>",
          "panelName": "earningDataValue",
          "children": [
            {
              "type": "fieldSet",
              "id": "earningsData",
              "horizontal": true,
              "children": [
                {
                  "type": "text",
                  "id": "earningGroupList1",
                  "label": "Earnings",
                  "enabled": "<%  false %>",
                  "value": "<% list:isList(earningDataValue.extendData)? (((earningDataValue.extendData[0] ?? '').earningGroupName.descriptor) ?? ((earningDataValue.extendData[0] ?? '').earningGroupName ?? '')) : ((earningDataValue.extendData ?? '').earningGroupName) %>"
                },
                {
                  "type": "instanceList",
                  "id": "earningGroupList",
                  "visible": false,
                  "enabled": "<%  false %>",
                  "values": "<% list:isList(earningDataValue.extendData)? [(((earningDataValue.extendData[0] ?? '').earningGroup) ?? '')] : [((earningDataValue.extendData ?? '').earningGroup)] %>",
                  "selectedValues": "<% list:isList(earningDataValue.extendData)? [(((earningDataValue.extendData[0] ?? '').earningGroup.id) ?? '')] : [((earningDataValue.extendData ?? '').earningGroup.id)] %>"
                },
                {
                  "type": "instanceList",
                  "id": "individualEarnings",
                  "label": "Individual Earnings",
                  "visible": "<% false %>",
                  "_values": "<% earningDataValue.earnings.map(x =>{{'id': (x ?? ''), 'descriptor': (x ?? '')}}) ?? [] %>",
                  "values": "<% getEarningsWorkday.map(x =>{{'id': x.id, 'descriptor': x.descriptor}}) ?? [];  %>",
                  "selectedValues": "<% list:isList(earningDataValue.extendData)? (((earningDataValue.extendData[0] ?? '').earningSelected) ?? []) : (((earningDataValue.extendData ?? '').earningSelected) ?? []) %>",
                  "enabled": false
                },
                {
                  "type": "currency",
                  "id": "totalAmount",
                  "showCurrencySymbol": true,
                  "label": "Total Amount ($) ",
                  "fractionDigits": 2,
                  "currencyCode": "USD",
                  "enabled": false,
                  "value": "<%
                  //if the worker has hourly we multiply it by that. otherwise loop through each earning group and display the earnings by summing each total
                    var amountList = 0;      
                    var earningsGroupsEarningsMapped = individualEarnings.selectedEntries.map(x=>{x.descriptor}) ?? [];
                    for(var row : pageVariables.workersCompensation) {
                    var compPlanSubText = row.compensationElement.descriptor ?? '';
                      if(!empty(earningsGroupsEarningsMapped)){
                        for(var earning : (earningsGroupsEarningsMapped ?? [])){   
                          var list =  (((compPlanSubText ?? '').contains(earning)) || (('Regular ' + compPlanSubText) ?? '').contains(earning));          
                          if (list == true){                                      
                            if(row.frequency.descriptor == 'Hourly' ){
                              amountList = (row.amount.value * (pageVariables.fte * 40)) ?? '0' + amountList;
                              amountList = amountList*52;
                            }     
                            else{
                              amountList = row.amount.value ?? '0' + amountList;
                            }
                          }
                        }
                      }
                    }               
                    return amountList;
                  %>"
                }
              ]
            },
            {
              "type": "fieldSet",
              "id": "test",
              "children": [
                {
                  "type": "grid",
                  "id": "setPercentage",
                  "label": "Proposed Costing Allocation",
                  "rows": "<% list:isList(earningDataValue.extendData)? (earningDataValue.extendData[0].lineData ?? []) : (earningDataValue.extendData.lineData ?? [])  %>",
                  "doNotAdd": false,
                  "doNotRemove": false,
                  "enabled": true,
                  "isArrayOutBinding": "false",
                  "rowVariableName": "row",
                  "indexVariableName": "i",
                  "onRowAdd": "<% errorWidget.clearError(); %>",
                  "columns": [
                    {
                      "type": "column",
                      "columnId": "colRow",
                      "label": "Row",
                      "cellTemplate": {
                        "type": "number",
                        "enabled": false,
                        "id": "rowIndex",
                        "value": "<% i + 1 %>"
                      }
                    },
                    {
                      "sortableAndFilterable": true,
                      "type": "column",
                      "columnId": "colUpdated",
                      "label": "Updated",
                      "cellTemplate": {
                        "type": "text",
                        "enabled": false,
                        "id": "updated",
                        "value": "<% row.isUpdated ? 'Yes'  : 'No' %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colRetroActive",
                      "label": "Retroactive",
                      "cellTemplate": {
                        "type": "text",
                        "enabled": false,
                        "id": "retroActive",
                        "_value": "<% row.isRetroActive ? 'Yes'  : 'No' %>",                        
                        "value":  "<%(row.isRetroActive && row.isUpdated) ? 'Yes' : 'No' %>"
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colBudgetUnitWorktag",
                      "label": "Budget Unit",
                      "required": true,
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "budgetUnitWorktagFieldSet",
                        "children": [
                          {
                            "type": "instanceList",
                            "id": "budgetUnitWorktag",
                            "enabled": true,
                            "required": true,
                            "values": "<% getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Budget Unit'}).map(c =>{{'descriptor': ( ((c.referenceID1 ?? '') + ' ' + (c.name ?? ''))), 'id': (c.id ?? '')}}) ?? [] %>",
                            "selectedValues": "<% [row.budgetUnit.id ?? ''] %>",
                            "onChange": "<% 
                              if(!empty(self.value[0])){
                                var projectClinicalAssignment = {:};
                                var worktags = getWorktags.invoke({'taggableType': 'CUSTOM_ORGANIZATION', 'worktag': self.value[0], 'taggableTypes': ['CUSTOM_ORGANIZATION_01', 'CUSTOM_ORGANIZATION_02', 'CUSTOM_ORGANIZATION_03','CUSTOM_ORGANIZATION_04','CUSTOM_ORGANIZATION_05','CUSTOM_ORGANIZATION_06','CUSTOM_ORGANIZATION_07','CUSTOM_ORGANIZATION_08','CUSTOM_ORGANIZATION_09','CUSTOM_ORGANIZATION_10']}) ?? [];
                                var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
                                Validation.getRelatedWorktags(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag,grantWorktag, projectWorktag, allRemainingWorktag, relatedWorktags, 'Budget Unit', self.value[0]);
                              }
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'budgetUnit');
                            %>"
                          },
                          {
                            "type":"text",
                            "visible": false,
                            "id":"lineID",
                            "value":"<% row.id ?? '' %>"

                          },
                          {
                            "type":"hidden",
                            "id":"workdaylineID",
                            "value":"<% row ?? '' %>"

                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colCostCenterWorktag",
                      "label": "Cost Center",
                      "required": true,
                      "cellTemplate": {
                        "type": "fieldSet",
                        "id": "worktagCostCenterWorktag",
                        "children": [
                          {
                            "type": "instanceList",
                            "id": "CostCenterWorktag",
                            "enabled": true,
                            "required": true,
                            "values": "<% getCostCenter.data.map(t =>{t.costCenter}) ?? []  %>",
                            "selectedValues": "<% [row.costCenter.id ?? ''] %>",
                            "onChange": "<% 
                            // added by Pasha 10/30
                              var projectClinicalAssignment = {:};
                              if(!empty(projectWorktag.value[0])){
                                projectClinicalAssignment= getProjectData.invoke({'id': projectWorktag.value[0]}).data[0].assignmentAllocation ?? {:};
                              }
                              Validation.validateWorktags((indefinite.value ?? false), CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag,(startDate.value?? ''), (endDate.value ?? ''), pageVariables.validationDate, (earningGroupList1.value ?? {:}), (pageVariables.workerType ?? ''), (pageVariables.assignmentallocations ?? []), (pageVariables.allWorkTags ?? []), (projectClinicalAssignment ?? ''), 'costCenter');
                              if(!empty(self.value[0])){
                                var costCenterRole = getCostCenterRoles.invoke({'id': self.value[0]});
                                // commented by Pasha 11/05 MCW-14351
                           //     if(!((costCenterRole.data[0].workforceManagerInherited.map(x =>{x.id ?? ''}) ?? []).contains(workerMe.id) || (costCenterRole.data[0].workforceManagerAssigned.map(x =>{x.id ?? ''}) ?? []).contains(workerMe.id))){
                                  if(!empty(costCenterRole.data[0].workforceManagerAssigned.map(t =>{t.id}))){
                                   // workForceManager.setValue(costCenterRole.data[0].workforceManagerAssigned.map(t =>{t.id})[0] ?? '');
                                       workForceManager.setValue(costCenterRole.data[0].workforceManagerAssigned.map(t =>{t.id}).join(',') ?? '');
                                  }else if(costCenterRole.data[0].workforceManagerInherited.map(t =>{t.id})){
                                   // workForceManager.setValue(costCenterRole.data[0].workforceManagerInherited.map(t =>{t.id})[0] ?? '');
                                       workForceManager.setValue(costCenterRole.data[0].workforceManagerInherited.map(t =>{t.id}).join(',') ?? '');
                                  }
                            //    }
                                var worktags = getWorktags.invoke({'taggableType': 'COST_CENTER', 'worktag': self.value[0], 'taggableTypes': ['COST_CENTER']}) ?? [];
                                var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
                                 Validation.getRelatedWorktags(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag,grantWorktag, projectWorktag, allRemainingWorktag, relatedWorktags, 'CostCenter', self.value[0]);
                              }
                            %>"
                          },
                          {
                            "type": "text",
                            "id": "workForceManager",
                            "visible": false,
                            "value": "<% '' %>"
                          }
                        ]
                      }
                    },
                    {
                      "type": "column",
                      "columnId": "colFundWorktag",
                      "label": "Fund",
