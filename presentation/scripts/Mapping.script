            costingAllocationPlanBody.addAll({'extendData': (extendDataFilteredByEarning)});
            panelData.add(costingAllocationPlanBody);
    }
    return panelData;
}



var mapAllocationDataOnLoadApproval = function(extendData, workdayAllocation, earningGroupFromAdminPage, defaultWorktags, payPeriod){
    var earningsOnLoad = [];
    var mapExtendData = [];
    for(var k : (extendData.data ?? [])){
        var lineDataExtend = [];
        for(var g : (k.intervalData ?? [])){
            var intervalLineDatamapped = g.costingAllocationLineDetailTransaction.map(j =>{j.id ?? ''}) ?? [];
            var lineData = k.lineData.filter(y =>{intervalLineDatamapped.contains(y.workdayID)}) ?? [];
            for(var p: lineData){
                var lineDataInterval = {
                    'startDate': (g.startDate ?? ''),
                    'endDate': (g.endDate ?? ''),
                    'indefinite': empty(g.endDate),
                    'fund':({'descriptor': (p.fund.descriptor ?? ''), 'id': (p.fund.id ?? '')}),
                    'costCenter': ({'descriptor': (p.costCenter.descriptor ?? ''), 'id': (p.costCenter.id ?? '')}),
                    'project': ({'descriptor': (p.project.descriptor ?? ''), 'id': (p.project.id ?? '')}),
                    'gift': ({'descriptor': ((p.gift.descriptor ?? '')), 'id': (p.gift.id ?? '')}),
                    'activityType': ({'descriptor': (p.activityType.descriptor ?? ''), 'id': p.activityType.descriptor ?? ''}),
                    'budgetUnit': ({'descriptor': (p.budgetUnit.descriptor ?? ''), 'id': p.budgetUnit.id ?? ''}),
                    'center': ({'descriptor': ((p.center.descriptor ?? '')), 'id': (p.center.id ?? '')}),
                    'clinicalAssignment': ({'descriptor': ((p.clinicalAssignment.descriptor ?? '')), 'id': (p.clinicalAssignment.id ?? '')}),
                    'grant': ({'descriptor': (p.grantDescriptor ?? ''), 'id': (p.grantId ?? '')}),
                    'allocationPercent':  number:toBigDecimal(((p.allocationPercent ?? 0)), 5, 'UNNECESSARY'),
                    'isRetroActive': (p.isRetroActive ?? false),
                    'comment': (p.comment ?? ''),
                    'isUpdated': (p.isUpdated ?? false),
                    'id': (p.workdayID ?? ''),
                    'hasSalaryOvertheCap': (p.hasSalaryOvertheCap ?? false),
                    'salaryOverTheCapAmount' : (p.salaryOverTheCapAmount ?? 0),
                    'salaryOverTheCap': (p.salaryOverTheCap.map(l=>{l.id}) ?? []), 
                    'workdaySOCLineData': (p.workdaySOCLineData ?? '')
                }
                lineDataExtend.add(lineDataInterval);
            }
        }
        var extendPayload = {
          'earningSelected':  (k.earningID.map(f =>{f.earningId ?? ''}) ?? []),
          'hasRetroactive': (k.hasRetroactiveAllocation ?? false),
          'earningGroup': (k.earningGroup.descriptor ?? ''),
          'lineData': (lineDataExtend ?? [])
        };
        mapExtendData.add(extendPayload);
    }

    var firstStartDate = list:flatten(mapExtendData.map(i =>{i.lineData.map(r =>{r.startDate})}))[0] ?? date:now();
    var lastEndDate = ((list:flatten(mapExtendData.map(i =>{i.lineData.map(r =>{!empty(r.endDate)? r.endDate : null}) ?? []})))) ?? [];

    lastEndDate = list:nonNull(lastEndDate);
    var lastIndex = lastEndDate.size()-1;
    lastEndDate = lastEndDate[lastIndex] ?? date:now();
    var panelData = [];
    var workdayAllocationMapped = [];
    if(!empty(workdayAllocation)){
        for(var extendData : mapExtendData ?? []){
            var workdayAllocationFiltered = workdayAllocation.filter(t => {extendData.earningSelected.contains(t.workerEarning.id ?? '')}) ?? [];
            if(empty(workdayAllocationFiltered) && !empty(earningObjectID[1])){
                var workdayAllocationFiltered = workdayAllocation.filter(t => {(extendData.earningSelected).contains(t.workerEarning.id ?? '')}) ?? [];
            }
            if(!empty(workdayAllocationFiltered)){
                var filteredWorkdayAllocationByDate = workdayAllocationFiltered.filter(z =>{((z.startDate ?? '') >= date:parseFormattedDateString(payPeriod.toString(),'yyyy-MM-dd')) || ((z.endDate ?? '') >= date:parseFormattedDateString(payPeriod.toString(),'yyyy-MM-dd')) || empty(z.endDate)});
                var workdayAllocationMapped = [];
                var lineDataPayload = [];
            
                for(var t : [(filteredWorkdayAllocationByDate[0] ?? {:})]){
                    var lineData = t.AllocationDetails ?? [];
                    for(var m: lineData){
                        var worktags = [( m.fund.id ??''), (m.costCenter.id ?? ''), ( m.center.id ?? ''), (m.assignmentAllocation.id ?? ''), (m.budgetUnit.id ?? ''), (m.activity.id ?? ''), (m.grant.id ?? ''), (m.project_worktag.id ?? ''), (m.gift.id ?? '')];
                        if(!empty(list:removeAll(worktags, ['']))){
                                var lineDataInterval = {
                                    'startDate': (t.startDate ?? ''),
                                    'endDate': (t.endDate ?? ''),
                                    'indefinite': empty(t.endDate),
                                    'fund':({'id': m.fund.id ?? ''}),
                                    'costCenter': ({'id': m.costCenter.id ?? ''}),
                                    'center': ({'descriptor': ((m.center.descriptor ?? '')), 'id': m.center.id ?? ''}),
                                    'clinicalAssignment': ({'descriptor': ((m.assignmentAllocation.descriptor ?? '')), 'id': m.assignmentAllocation.id ?? ''}),
                                    'budgetUnit': ({'id': m.budgetUnit.id ?? ''}),
                                    'activity': ({'id': m.activity.id ?? ''}),
                                    'grant': ( m.grant.id ?? ''),
                                    'project': ({'id': m.project_worktag.id ?? ''}),
                                    'gift': ({'descriptor': ((m.gift.descriptor ?? '')), 'id': (m.gift.id ?? '')}),
                                    'allocationPercent':  number:toBigDecimal(((m.distributionPercent ?? 0)), 5, 'UNNECESSARY'),
                                    'workdaySOCLineData': (m.id ?? '')
                                    
                                };
                                lineDataPayload.add(lineDataInterval);
                                //}
                        }else{
                            var lineDataInterval = {
                                'startDate': (t.startDate ?? ''),
                                'endDate': (t.endDate ?? ''),
                                'indefinite': empty(t.endDate),
                                'fund':  ({'id': (defaultWorktags.data[0].fund[0].id ?? '')}),
                                'costCenter':  ({'id': (defaultWorktags.data[0].costCenter[0].id ?? '')}),
                                'center':  ({'descriptor': ((defaultWorktags.data[0].center.descriptor ?? '')), 'id': (defaultWorktags.data[0].center.id ?? '')}),
                                'clinicalAssignment': ({'descriptor': ((defaultWorktags.data[0].assignmentAllocation[0].descriptor ?? '')), 'id': (defaultWorktags.data[0].assignmentAllocation[0].id ?? '')}),
                                'budgetUnit': ({'id': (defaultWorktags.data[0].budgetUnit[0].id ?? '')}),
                                'activityType': ({'id': (defaultWorktags.data[0].activity[0].id ?? '')}),
                                'grantId': (defaultWorktags.data[0].grant[0].id ?? ''),
                                'project': ({'id': (defaultWorktags.data[0].project[0].id ?? '')}),
                                'gift': ({'descriptor': ((defaultWorktags.data[0].gift[0].descriptor ?? '')), 'id': (defaultWorktags.data[0].gift[0].id ?? '')}),
                                'allocationPercent':  number:toBigDecimal(((m.distributionPercent ?? 0)), 5, 'UNNECESSARY'),
                                'workdaySOCLineData': (m.id ?? '')
                            };
                            lineDataPayload.add(lineDataInterval);
                        }
                    }
                    var payload = {
                        'costingAllocationLineDetails': (lineDataPayload ?? [])
                    };
                    workdayAllocationMapped.add(payload);
                }
                var costingAllocationlineData = [];
                for(var x : (workdayAllocationMapped[0].costingAllocationLineDetails ?? []) ){
                    var costingAllocationLinePayload = {
                        'startDate': (x.startDate ?? ''),
                        'endDate': (x.endDate ?? ''),
                        'indefinite': (x.indefinite ?? false),
                        'fund':(x.fund ?? {:}),
                        'budgetUnit': (x.budgetUnit ?? {:}),
                        'activityType': (x.activity ?? {:}),
                        'costCenter': (x.costCenter ?? {:}),
                        'center': (x.center ?? {:}),
                        'grant': {'id': (x.grant ?? '')},
                        'gift': (x.gift ?? {:}),
                        'project': (x.project ?? {:}),
                        'clinicalAssignment': ({'id': (x.clinicalAssignment ?? '')}),
                        'allocationPercent':  (x.allocationPercent ?? 0.00),
                        'sequence': (x.sequence ?? ''),
                        'id': (x.id ?? ''),
                        'workdaySOCLineData': (m.workdaySOCLineData ?? '')
                    };
                    costingAllocationlineData.add(costingAllocationLinePayload);
                }
                var costingAllocationPlanBody = {
                    'earningGroup': (filteredWorkdayAllocationByDate[0].allocationLevel.earningID ?? ''),
                    'selectedValues': (filteredWorkdayAllocationByDate[0].allocationLevel.earningID ?? {:}),
                    'type': 'earningGroup',
                    'earnings': [filteredWorkdayAllocationByDate[0].allocationLevel.earningID ?? ''] ?? [],
                    'extendData': (extendData?? {:})
                    
                };
                costingAllocationlineData = list:sort(costingAllocationlineData, 'isUpdated', false);
                costingAllocationlineData = list:sort(costingAllocationlineData, 'startDate', true);
                costingAllocationPlanBody.addAll({'lineData': (costingAllocationlineData ?? [])});
                panelData.add(costingAllocationPlanBody);

            }else{
                var costingAllocationPlanBody = {
                    'earningGroup': (filteredWorkdayAllocationByDate[0].allocationLevel.earningID ?? ''),
                    'selectedValues': (filteredWorkdayAllocationByDate[0].allocationLevel.earningID ?? {:}),
                    'type': 'earningGroup',
                    'earnings': [filteredWorkdayAllocationByDate[0].allocationLevel.earningID ?? ''] ?? [],
                    'extendData': (extendData?? {:})
                };
                panelData.add(costingAllocationPlanBody);
            }
        }
       
    }else{
        for(var w: mapExtendData ?? []){
            var costingAllocationPlanBody = {
                'earningGroup': (w.earningSelected ?? ''),
                'earningGroup2': (w.earningGroup ?? ''),
                'selectedValues': (w.earningSelected ?? {:}),
                'type': 'earningGroup',
                'earnings': [w.earningSelected ?? ''] ?? []
            };
            costingAllocationPlanBody.addAll({'extendData': [(w)]});
            panelData.add(costingAllocationPlanBody);
        }
    }
    if(!empty(workdayAllocation)){
        panelData = panelData.filter(q => {!empty(q.extendData)});
    }
    panelData = panelData.distinct();
    return panelData;
}



var mapAllocationDataOnLoadSendBack = function(extendData, workdayAllocation, earningGroupFromAdminPage){
    var earningsOnLoad = [];
    var mapExtendData = [];
    
    for(var k : (extendData.data ?? [])){
        var lineDataExtend = [];
        for(var g : (k.intervalData ?? [])){
            var intervalLineDatamapped = g.costingAllocationLineDetailTransaction.map(j =>{j.id ?? ''}) ?? [];
            var lineData = k.lineData.filter(y =>{intervalLineDatamapped.contains(y.workdayID)}) ?? [];
            // modifed by pasha 11/03 number:toBigDecimal 2 to 6
            for(var p: lineData){
                var lineDataInterval = {
                    'startDate': (g.startDate ?? ''),
                    'endDate': (g.endDate ?? ''),
                    'indefinite': empty(g.endDate),
                   // 'fund':({'id': p.fund.id ?? ''}),
                    'fund':({'descriptor': (p.fund.descriptor ?? ''),'id': p.fund.id ?? ''}),
                    'costCenter': ({'descriptor': (p.costCenter.descriptor ?? ''), 'id': (p.costCenter.id ?? '')}),
                   // 'project': ({'id': p.project.id ?? ''}),
                     'project': ({'descriptor': (p.project.descriptor ?? ''),'id': p.project.id ?? ''}),
                 //    'gift': ({'id': p.gift.id ?? ''}),
                       'gift': ({'descriptor': (p.gift.descriptor ?? ''),'id': p.gift.id ?? ''}),
                    'activityType': ({'descriptor': (p.activityType.descriptor ?? ''),'id': p.activityType.id ?? ''}),
                   // 'budgetUnit': ({'id': p.budgetUnit.id ?? ''}),
                    'budgetUnit': ({'descriptor': (p.budgetUnit.descriptor ?? ''),'id': p.budgetUnit.id ?? ''}),
                   // 'center': ({'id': p.center.id ?? ''}),
                    'center': ({'descriptor': (p.center.descriptor ?? ''),'id': p.center.id ?? ''}),
                   // 'clinicalAssignment': ({'id': (p.clinicalAssignment.id ?? '')}),
                     'clinicalAssignment': ({'descriptor': (p.clinicalAssignment.descriptor ?? ''),'id': (p.clinicalAssignment.id ?? '')}),
                    // 'grant': ({'id': p.grantId ?? ''}),
                      'grant': ({'descriptor': (p.grantId.descriptor ?? ''),'id': p.grantId ?? ''}),
                  //   'allocationPercent':(p.allocationPercent ?? 0.00),
                  //   'allocationPercent':  number:toBigDecimal(((p.allocationPercent ?? 0)*100), 6, 'HALF_UP'),                      
                    'allocationPercent':  number:toBigDecimal(((p.allocationPercent ?? 0)), 6, 'HALF_UP'),
                    'isRetroActive': (p.isRetroActive ?? false),
                    'comment': (p.comment ?? ''),
                    'isUpdated': (p.isUpdated ?? false),
                    'id': (p.workdayID ?? ''),
                    'workdaySOCLineData': (p.workdaySOCLineData ?? '')
                }
                
                lineDataExtend.add(lineDataInterval);
            }
        }
        var earningGroup = earningGroupFromAdminPage.filter(d =>{(d.earnings.map(tn => {tn.earningId ?? ''}) ?? []).contains(k.earningID[0].earningId ?? '')}) ?? '';
        var extendPayload = {
          'earningSelected':  (k.earningID.map(f =>{f.earningId}) ?? []),
          'hasRetroactive': (k.hasRetroactiveAllocation ?? false),
          'earningGroup': (k.earningGroup ?? {:}),
          'earningGroupName': !empty(k.earningGroup) ?(k.earningGroup ?? '') : (k.earningGroupRBO.earnings.map(q =>{q.descriptor}).join('\n') ?? ''),
          'earningRequestTransactionID': (k.id ?? ''),
          'lineData': (lineDataExtend ?? [])
        };
        mapExtendData.add(extendPayload);
    }

    var firstStartDate = list:flatten(mapExtendData.map(i =>{i.lineData.map(r =>{r.startDate})}))[0] ?? date:now();
    var lastEndDate = ((list:flatten(mapExtendData.map(i =>{i.lineData.map(r =>{!empty(r.endDate)? r.endDate : null}) ?? []})))) ?? [];
    lastEndDate = list:nonNull(lastEndDate);
    var lastIndex = lastEndDate.size()-1;
    lastEndDate = lastEndDate[lastIndex] ?? date:now();
    var panelData = [];   
    var filteredWorkdayAllocationByDate = workdayAllocation.filter(z =>{(((z[1][0].startDate ?? '') >= date:now()) || ((z[1][0].endDate ?? '') >= date:now()) || empty(z[1][0].endDate)) && (!empty(t[0].allocationLevel.earningID))}) ?? [];   
    if(!empty(filteredWorkdayAllocationByDate)){
        for(var extendData : mapExtendData ?? []){
            var workdayAllocationFiltered = filteredWorkdayAllocationByDate.filter(t => {extendData.earningSelected.contains((t[0].allocationLevel.earningID ?? ''))}) ?? [];
            if(!empty(workdayAllocationFiltered)){
                var lineData = workdayAllocationFiltered[0].filter(u =>{list:isList(u)});
                var lineDataPayload = [];
                var workdayAllocationMapped = [];
                for(var m: lineData){
                    for(var q: m){
                        if((q.startDate < lastEndDate) && (((q.endDate ?? false) > firstStartDate) || (empty(q.endDate)))){
                            var lineDataInterval = {
                                'startDate': (q.startDate ?? ''),
                                'endDate': (q.endDate ?? ''),
                                'indefinite': empty(q.endDate),
                                'fund':({'id': q.fundID ?? ''}),
                                'grant': ({'id': q.grantID ?? ''}),
                                'costCenter': ({'id': q.costCenterID ?? ''}),
                                'project': ({'id': q.project ?? ''}),
                                'gift': ({'id': q.gift ?? ''}),
                                'clinicalAssignment': ({'id': (q.clinicalAssignment ?? '')}),
                                'activity': ({'id': q.activity ?? ''}),
                                'budgetUnit': ({'id': q.budgetUnit ?? ''}),
                                'center': ({'id': q.center ?? ''}),
                                'allocationPercent':  number:toBigDecimal(((q.distributionPercent ?? 0)*100), 2, 'HALF_UP')
                            };
                            lineDataPayload.add(lineDataInterval);
                        }
                    }
                }
                var payload = {
                    'costingAllocationLineDetails': (lineDataPayload ?? [])
                };
                workdayAllocationMapped.add(payload);
                var costingAllocationlineData = [];
                for(var x : (workdayAllocationMapped[0].costingAllocationLineDetails ?? []) ){
                    var costingAllocationLinePayload = {
                        'startDate': (x.startDate ?? ''),
                        'endDate': (x.endDate ?? ''),
                        'indefinite': (x.indefinite ?? false),
                        'fund':(x.fund ?? {:}),
                        'budgetUnit': (x.budgetUnit ?? {:}),
                        'activityType': (x.activity ?? {:}),
                        'costCenter': (x.costCenter ?? {:}),
                        'center': (x.center ?? {:}),
                        'grant': {'id': (x.grant ?? '')},
                        'gift': (x.gift ?? {:}),
                        'clinicalAssignment': ({'id': (x.clinicalAssignment ?? '')}),
                        'project': (x.project ?? {:}),
                        'allocationPercent':  (x.allocationPercent ?? 0.00),
                        'sequence': (x.sequence ?? ''),
                        'id': (x.id ?? '')
                    };
                    costingAllocationlineData.add(costingAllocationLinePayload);
                }
                var costingAllocationPlanBody = {
                    'earningGroup': (workdayAllocationFiltered[0].allocationLevel.earningID ?? ''),
                    'selectedValues': (workdayAllocationFiltered[0].allocationLevel.earningID ?? {:}),
                    'type': 'earningGroup',
                    'earnings': [workdayAllocationFiltered[0].allocationLevel.earningID ?? ''] ?? [],
                    'extendData': (extendData?? {:})
                    
                };
                costingAllocationlineData = list:sort(costingAllocationlineData, 'startDate', true);
                costingAllocationPlanBody.addAll({'lineData': (costingAllocationlineData ?? [])});
                panelData.add(costingAllocationPlanBody);
            }
        }
    }else{
        for(var w: mapExtendData ?? []){
            var costingAllocationPlanBody = {
                'earningGroup': (w.earningSelected ?? ''),
                'earningGroup2': (w.earningGroup ?? ''),
                'selectedValues': (w.earningSelected ?? {:}),
                'type': 'earningGroup',
                'earnings': [w.earningSelected ?? ''] ?? []
            };
            costingAllocationPlanBody.addAll({'extendData': [(w)]});
            panelData.add(costingAllocationPlanBody);
        }

    }
    if(!empty(workdayAllocation)){
        panelData = panelData.filter(q => {!empty(q.extendData)});

    }
    panelData = panelData.distinct();
    return panelData;
}
var getEarningsCostingAllocation = function(earningID, workdayAllocation, grid){
    var earningIDValue = earningID ?? '';
    var filteredWorkdayAllocationByEarning = workdayAllocation.filter(u =>{(earningIDValue == ((u.workerEarning.id ?? '')))});
    
    if(!empty(filteredWorkdayAllocationByEarning)){
        var filteredWorkdayAllocationByDate = filteredWorkdayAllocationByEarning.filter(z =>{((z.startDate ?? '') >= date:now()) || ((z.endDate ?? '') >= date:now()) || empty(z.endDate)});
    }else{
        var filteredWorkdayAllocationByDate = [];
    }
    var workdayAllocationMapped = [];
    
    for(var t : (filteredWorkdayAllocationByDate ?? [])){
        var lineData = t.AllocationDetails ?? [];
        var lineDataPayload = [];
        for(var m: lineData){
            if(((t.startDate ?? '') >= date:now()) || ((t.endDate ?? '') >= date:now()) || empty(t.endDate)){
                var lineDataInterval = {
                    'startDate': (t.startDate ?? ''),
                    'endDate': (t.endDate ?? ''),
                    'indefinite': empty(t.endDate),
                    'fund':({'id': m.fund.id ?? ''}),
                    'costCenter': ({'id': m.costCenter.id ?? ''}),
                    'center': ({'id': m.center.id ?? ''}),
                    'clinicalAssignment': ({'id': m.assignmentAllocation.id ?? ''}),
                    'budgetUnit': ({'id': m.budgetUnit.id ?? ''}),
                    'activityType': ({'id': m.activity.id ?? ''}),
                    'grantId': ( m.grant.id ?? ''),
                    'project': ({'id': m.project_worktag.id ?? ''}),
                    'gift': ({'id': m.gift.id ?? ''}),
                    'allocationPercent': (m.distributionPercent ?? 0)
                };
                lineDataPayload.add(lineDataInterval);
            }
        }
        var payload = {
            'isWorkdayAllocation': true,
            'earningGroup': [{'id': (t[0].allocationLevel.earningID ?? '')}],
            'worker': {'id': (t[0].allocationLevel.workerID ?? '')},
            'costingAllocationLineDetails': (lineDataPayload ?? [])
        };
        workdayAllocationMapped.add(payload);
    }
    var costingAllocationlineData = [];
    for(var x : (workdayAllocationMapped[0].costingAllocationLineDetails ?? []) ){
        var costingAllocationLinePayload = {
            'startDate': (x.startDate ?? ''),
            'endDate': (x.endDate ?? ''),
            'indefinite': (x.indefinite ?? false),
            'fund':(x.fund ?? {:}),
            'budgetUnit': (x.budgetUnit ?? {:}),
            'activityType': (x.activityType ?? {:}),
            'costCenter': (x.costCenter ?? {:}),
            'center': (x.center ?? {:}),
            'grant': {'id': (x.grantId ?? ''), 'descriptor': (x.grantDescriptor ?? '')},
            'clinicalAssignment': ({'id': (x.clinicalAssignment ?? '')}),
            'gift': (x.gift ?? {:}),
            'project': (x.project ?? {:}),
            'allocationPercent':  (x.allocationPercent ?? 0.00),
            'sequence': (x.sequence ?? ''),
            'id': (x.id ?? '')
        };
        costingAllocationlineData.add(costingAllocationLinePayload);
    }
    costingAllocationlineData = list:sort(costingAllocationlineData, 'startDate', true);
    grid.setRows(costingAllocationlineData);
}



var mapSalaryOverTheCap = function(lineData, pageType){
   // var lineDataValues = list:flatten(lineData ?? []);
   var lineDataValues = lineData ?? [];
    var salaryOverTheCapLines = lineDataValues.filter(y =>{(y.hasSalaryOvertheCap ?? false)}) ?? [];
    var salaryOvertheCapArray = [];
    for(var t : salaryOverTheCapLines){
        var salaryOverTheCap = getSalaryOverTheCap.invoke({'id': (t.id ?? '')}).data ?? [];
        var getWorkdayLineData = getWorkerCostingAllocationsDefferred.invoke({'id': (t.workdaySOCLineData ?? '')}).data[0].costingAllocationDetails.filter(p =>{!empty(p.allSalaryOverTheCapSuballocations) && ((p.id ?? '') == (t.workdaySOCLineData ?? ''))})[0].allSalaryOverTheCapSuballocations.map(lm=>{(lm.id ?? '')}) ?? [];
        var workdaySOCData = getSalaryOverTheCapWorkday.invoke({'id': (t.workdaySOCLineData ?? '')}).data ?? [];
        var workdaySOCInLineData = [];
        for(var p : (workdaySOCData[0].salaryOvertheCap ?? [])){
            if(getWorkdayLineData.contains(p.id)){
                workdaySOCInLineData.add(p);
            }
        }        
        workdaySOCInLineData = workdaySOCInLineData.map(l=>{{
            
            'costCenter': (l.costCenter ?? {:}),
            'budgetunit': (l.budgetUnit ?? {:}),
            'fund': (l.fund ?? {:}),
            'project': (l.project_worktag ?? {:}),
            'gift': (l.gift ?? {:}),
            'activity': (l.activity ?? {:}),
            'center': (l.center ?? {:}),
            'assignmentAllocation': (l.assignmentAllocation ?? {:}),
            'percent': (l.percent ?? 0)
        }}) ?? [];
        var socPayload = {
            'lineData': (salaryOverTheCap ?? []),
            'workdaySOCData': (workdaySOCInLineData ?? []),
            'grant': (t.grant.descriptor ?? (t.grantDescriptor ?? '')),
            'startDate': (t.startDate ?? (t.costingAllocationIntervalTransaction.startDate ?? '')),
            'endDate': (t.endDate ?? (t.costingAllocationIntervalTransaction.endDate ?? '')),
            'indefinite': (t.indefinite ?? (t.costingAllocationIntervalTransaction.indefinite ?? false)),
            'salaryOverTheCapAmount': (t.salaryOverTheCapAmount ?? 0),
            'id': (t.id ?? ''),
            'isRetroActive': (t.isRetroActive ?? false)
        }
        salaryOvertheCapArray.add(socPayload);
    }
    salaryOvertheCapArray = list:sort(salaryOvertheCapArray, 'startDate', true);
    return salaryOvertheCapArray ?? [];
}

var getSalaryOverTheCap = function(salaryCapLines, salaryCapOverride){

    var salaryCapLines = salaryCapLines ?? [];
   
    if(!empty(salaryCapLines) && !empty(salaryCapOverride)){
        var salaryCapOverride = salaryCapLines.filter(x => {x.intervalID == salaryCapOverride});
        salaryCapLines = salaryCapOverride;
    }
    return list:sort(salaryCapLines,'dateFrom',false)[0] ?? {:};
}

{
    "mapAllocationData": mapAllocationData,
    "getAllocationGridMapped": getAllocationGridMapped,
    "mapAllocationDataOnLoadApproval": mapAllocationDataOnLoadApproval,
    "mapCostingAllocationOnLoadNew": mapCostingAllocationOnLoadNew,
    "getEarningsCostingAllocation": getEarningsCostingAllocation,
    "mapCostingAllocationOnLoadNewView": mapCostingAllocationOnLoadNewView,
    "mapCostingAllocationOnLoadNewViewRetroActive": mapCostingAllocationOnLoadNewViewRetroActive,
    "mapAllocationDataOnLoadSendBack": mapAllocationDataOnLoadSendBack,
    "getUpdated": getUpdated,
    "mapSalaryOverTheCap": mapSalaryOverTheCap,
    "getSalaryOverTheCap": getSalaryOverTheCap
}
