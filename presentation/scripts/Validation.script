var validateGridOnAdd = function(setPercentage){
  var gridIsEnabled = !setPercentage.getDoNotAdd();
  var counter = 1;
  for(var x : (setPercentage.children ?? [])){
    
    x.childrenMap.colRow.setValue(counter);
    counter = counter + 1; 
  }
}
 
var convertStringToCurrency = function(valu){
  let tempNumber = number:toBigDecimal(valu,2,'HALF_DOWN') ?? '0';
  let tempString = string:toString(tempNumber);  
	tempString = regex:replace(tempString, '\\B(?=(\\d{3})+(?!\\d))',',');
  return tempString;
}

var SOCAwardExpirationValidation = function(endDate, grantWorktag, salaryCapValue,fte,totalAmount,earningGroupDescriptor){
  if (!empty(endDate.value) && !empty(grantWorktag.value[0] ?? [])){
    var grantData = getGrantDeferred.invoke({'id':grantWorktag.value[0] }).data[0] ?? {:};
    if(!empty(grantData.effectiveAwardLine.toDate ?? '')){
      var awardLineEndDate = grantData.effectiveAwardLine.toDate;
      if (awardLineEndDate < endDate.value.format('yyyy-MM-dd')){
        salaryCapValue.setValue((0));
      }  
      else{
        //code
         if(earningGroupDescriptor == 'Base Salary'){
         // var grantData = getGrantDeferred.invoke({'id':grantWorktag.value[0] }) ?? [];
         //var grantData = getGrantDeferred.invoke({'id': (row.grant.id ?? '')}).data[0] ?? {:};        
         if(!empty(grantData.effectiveAwardLine.awardLineSalaryCap.id)){
          var salaryCapBody = getSalaryOverCap.invoke({'salaryCapID': (grantData.effectiveAwardLine.awardLineSalaryCap.id ?? '')});                  
            var awardLineSalaryCapOverrideID = grantData.effectiveAwardLine.awardLineSalaryCapOverride.id ?? '';          
            salaryCapBody = Mapping.getSalaryOverTheCap(salaryCapBody,awardLineSalaryCapOverrideID) ?? {:};  
            if(!empty(salaryCapBody)){
              var salaryAmount = salaryCapBody.amount ?? 0;
              var amountSalaryOverCap = ((totalAmount.value ?? 0) - (salaryAmount * (fte ?? 1.0)));
              if(amountSalaryOverCap > 0){
                var ConvSOCValye = number:toBigDecimal((amountSalaryOverCap ?? 0), 2, 'HALF_DOWN');
              //  salaryCapValue.setValue((ConvSOCValye)); commented to byPass SOC
                 salaryCapValue.setValue((0));
              }else{
                salaryCapValue.setValue((0));
              }
            }
        } else {
			  salaryCapValue.setValue((0));
		}   
       }
	}
  }
  }
  }


{
    "allocationValidation": allocationValidation,
    "validateWorktags": validateWorktags,
    "getRelatedWorktags": getRelatedWorktags,
    "getAllocationAssignmentWorktags": getAllocationAssignmentWorktags,
    "getPercentageData": getPercentageData,
    "setGridError": setGridError,
    "getDefaultPayload": getDefaultPayload,
    "setPanelValues": setPanelValues,
    "updateGridEnabled": updateGridEnabled,
    "validateGridOnAdd": validateGridOnAdd,
    "convertStringToCurrency": convertStringToCurrency,
    "SOCAwardExpirationValidation": SOCAwardExpirationValidation
}
