    }  


}
var getRelatedWorktags = function(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag, relatedWorktags, requestType, selectedValue) {

  var relatedWorktagsValues = relatedWorktags ?? [];
  

  if(((requestType != 'GIFT') && (requestType != 'Project') && (requestType != 'Grant')) ? (!empty(projectWorktag.value[0]) ? false : (!empty(grantWorktag.value[0]) ? false: (!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Gift'))})) ? false : true))): true){
    if(requestType != 'CostCenter'){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Cost Center'))}))){
        var costCenterValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Cost Center'))}) ?? [];
        CostCenterWorktag.setValue(costCenterValue.map(x=>{x.id}));
      }else{
        CostCenterWorktag.setValue([]);
      }
    }
    if(requestType != 'Activity'){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Activity'))}))){
        var activityValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Activity'))}) ?? [];
        activityWorktag.setValue(activityValue.map(x=>{x.id}));
      }else{
        activityWorktag.setValue([]);
      }
    }
    if(requestType != 'Fund'){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Fund'))}))){
        var fundValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Fund'))}) ?? [];
        fundWorktag.setValue(fundValue.map(x=>{x.id}));
      }else{
        fundWorktag.setValue([]);
      }
    }
    if(requestType != 'Budget Unit'){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Budget Unit'))}))){
        var budgetUnitValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Budget Unit'))}) ?? [];
        budgetUnitWorktag.setValue(budgetUnitValue.map(x=>{x.id}));
      }else{
        budgetUnitWorktag.setValue([]);
      }
    }
    if(requestType != 'Grant'){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Grant'))}))){
        var grantValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Grant'))}) ?? [];
        if(!empty(grantWorktag)){
          grantWorktag.setValue(grantValue.map(x=>{x.id}));
        }
      }else{
        if(!empty(grantWorktag)){
          grantWorktag.setValue([]);
        }
      }
    }
    if(requestType != 'Project'){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Project'))}))){
        var projectValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Project'))}) ?? [];
        projectWorktag.setValue(projectValue.map(x=>{(x.id ?? '')}));
      }else{
        projectWorktag.setValue([]);
      }
    }
    if((requestType != 'Gift') ||  (requestType != 'Center') || (requestType != 'Assignment Allocation')){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Gift')) || (string:contains(y.descriptor, 'Center'))|| (string:contains(y.descriptor, 'Assignment Allocation'))}))){
        var otherWorktagsValues = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Gift')) || (string:contains(y.descriptor, 'Center'))|| (string:contains(y.descriptor, 'Assignment Allocation'))}) ?? [];
        if(requestType == 'Gift'){
          otherWorktagsValues.join(allRemainingWorktag.value.map(t =>{{'id': t ?? ''}}));
        }
        allRemainingWorktag.setValue(otherWorktagsValues.map(x=>{x.id}).add(selectedValue));
      }else{
        allRemainingWorktag.setValue([]);
      }
    }
  }else{
    var remainingWT = [];
    if(empty(CostCenterWorktag.value[0])){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Cost Center'))}))){
        var costCenterValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Cost Center'))}) ?? [];
        CostCenterWorktag.setValue(costCenterValue.map(x=>{x.id}));
      }else{
        CostCenterWorktag.setValue([]);
      }
    }
    if(empty(activityWorktag.value[0])){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Activity'))}))){
        var activityValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Activity'))}) ?? [];
        activityWorktag.setValue(activityValue.map(x=>{x.id}));
      }else{
        activityWorktag.setValue([]);
      }
    }
    if(empty(fundWorktag.value[0])){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Fund'))}))){
        var fundValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Fund'))}) ?? [];
        fundWorktag.setValue(fundValue.map(x=>{x.id}));
      }else{
        fundWorktag.setValue([]);
      }
    }
    if(empty(budgetUnitWorktag.value[0])){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Budget Unit'))}))){
        var budgetUnitValue = relatedWorktagsValues.filter(y =>{(string:contains(y.descriptor, 'Budget Unit'))}) ?? [];
        budgetUnitWorktag.setValue(budgetUnitValue.map(x=>{x.id}));
      }else{
        budgetUnitWorktag.setValue([]);
      }
    }
    if(empty(allRemainingWorktag.selectedEntries.filter(x =>{x.descriptor.startsWith('Gift:')}))){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:startsWith(y.descriptor,  'Gift:'))}))){
        var otherWorktagsValues = relatedWorktagsValues.filter(y =>{(string:startsWith(y.descriptor, 'Gift:'))}) ?? [];
        var selectedValueVar = allRemainingWorktag.value ?? [];
        var joinedValues = list:join(selectedValueVar, otherWorktagsValues.map(x=>{x.id}));
        remainingWT.add(joinedValues);
      }
    }
    if(empty(allRemainingWorktag.selectedEntries.filter(x =>{x.descriptor.startsWith('Center:')}))){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:startsWith(y.descriptor, 'Center'))}))){
        var otherWorktagsValues = relatedWorktagsValues.filter(y =>{(string:startsWith(y.descriptor, 'Center'))}) ?? [];
        var selectedValueVar = allRemainingWorktag.selectedEntries.map(t =>{t.id ?? ''}) ?? [];
        var joinedValues = list:join(selectedValueVar, otherWorktagsValues.map(x=>{x.id}));
        remainingWT.add(joinedValues);
      }
    }
    if(empty(allRemainingWorktag.selectedEntries.filter(x =>{x.descriptor.startsWith('Assignment Allocation:')}))){
      if(!empty(relatedWorktagsValues.filter(y =>{(string:startsWith(y.descriptor,  'Assignment Allocation:'))}))){
        var otherWorktagsValues = relatedWorktagsValues.filter(y =>{(string:startsWith(y.descriptor, 'Assignment Allocation:'))}) ?? [];
        var selectedValueVar = allRemainingWorktag.value ?? [];
        var joinedValues = list:join(selectedValueVar, otherWorktagsValues.map(x=>{x.id}));
        remainingWT.add(joinedValues);
      }
    }
    allRemainingWorktag.setValue(remainingWT ?? []);
  }
}
var setGridError = function(grid, errorPayload, errorWidget, submitValue){
  var gridRows = grid ?? [];
  var errorPayloadMappedIndefinite = errorPayload.errorArray.filter(x =>{((x.indefinite?? false) == true)}).map(x =>{{'startDate': (x.periodStartDate ?? ''), 'endDate': (x.periodEndDate ?? ''), 'errorText': (x.errorText ?? ''), 'indefinite': (x.indefinite ?? false)}}) ?? [];
  var errorPayloadMappedNotInfinite = errorPayload.errorArray.filter(x =>{((x.indefinite ?? false) == false)}).map(x =>{{'startDate': (x.periodStartDate ?? ''), 'endDate': (x.periodEndDate ?? ''), 'errorText': (x.errorText ?? ''), 'indefinite': (x.indefinite ?? false), 'sumIsZero': (x.sumIsZero ?? false)}}) ?? [];
  var indefiniteTotal = 0;
  var hasIndefinite = false;
  if(empty(gridRows) && submitValue){
    errorWidget.setError('Please enter values in the grid');
  }else{
    errorWidget.clearError();
  }
  for(var y : gridRows){
    var startDateWidget = (y.childrenMap.colStartDate.childrenMap.startDate ?? '');
    var endDateWidget = (y.childrenMap.colEndDate.childrenMap.endDate ?? '');
     var percentWidget = (y.childrenMap.colPercent.childrenMap.percentAmountSection.childrenMap.percentAmount ?? '');
     var selectedGrant = ( y.childrenMap.colGrantWorktag.childrenMap.grantWorktag.selectedEntries[0].descriptor ?? '');
    var selectedProject = (y.childrenMap.colProjectWorktag.childrenMap.projectWorktag.selectedEntries[0].descriptor ?? '');   
    var selectedGift =  ( y.childrenMap.colallRemainingWorktag.childrenMap.allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Gift:')}) ?? {:});
   //var selectedGift = [];
       var fundWorktagWidget = (y.childrenMap.colFundWorktag.childrenMap.fundWorktag ?? '');
      var mcwFund = (y.childrenMap.colFundWorktag.childrenMap.fundWorktag.value[0] ?? '');
      var fundWorktagWidgetDescriptor = fundWorktagWidget.selectedEntries[0].descriptor ?? '' ;
        var validateFund =  getRestrictedFunds.invoke({'id':mcwFund}) ?? [];
         if(empty(validateFund.data))
         {            
            fundWorktagWidget.setError('Fund is Restricted Fund : ' + fundWorktagWidgetDescriptor);
         }else
         {
           fundWorktagWidget.clearError();
         }
    
    if(empty(percentWidget.value ?? ''))
    {
      percentWidget.setError('Allocation Percent cannot be less than or equal to 0');
    }
    
        if(fundWorktagWidgetDescriptor.contains('102.U')){
        if(empty(selectedGrant)) {
                fundWorktagWidget.setError('Grant cannot be empty with this Fund');                
              }else{
                fundWorktagWidget.clearError();
              }  
     }
     if(fundWorktagWidgetDescriptor.contains('103.U') || fundWorktagWidgetDescriptor.contains('119.U')|| fundWorktagWidgetDescriptor.contains('123.U')|| fundWorktagWidgetDescriptor.contains('131.U')|| fundWorktagWidgetDescriptor.contains('156.U')|| fundWorktagWidgetDescriptor.contains('164.U')|| fundWorktagWidgetDescriptor.contains('168.U')|| fundWorktagWidgetDescriptor.contains('300.U')|| fundWorktagWidgetDescriptor.contains('350.U')|| fundWorktagWidgetDescriptor.contains('400.U')|| fundWorktagWidgetDescriptor.contains('700.U')|| fundWorktagWidgetDescriptor.contains('706.U')|| fundWorktagWidgetDescriptor.contains('772.U')){
      if(empty(selectedProject)){
                fundWorktagWidget.setError('Project cannot be empty with this Fund');                
              }else{
                fundWorktagWidget.clearError();
              }
        }
   if(fundWorktagWidgetDescriptor.contains('116.U') || fundWorktagWidgetDescriptor.contains('117.P')|| fundWorktagWidgetDescriptor.contains('117.T')|| fundWorktagWidgetDescriptor.contains('117.U')|| fundWorktagWidgetDescriptor.contains('118.T')|| fundWorktagWidgetDescriptor.contains('118.U')|| fundWorktagWidgetDescriptor.contains('150.U')|| fundWorktagWidgetDescriptor.contains('150.T')){
            if(empty(selectedGift)){
                fundWorktagWidget.setError('Gift cannot be empty with this Fund');                
              }else{
                fundWorktagWidget.clearError();
              }
        }
    //}
   
      
    var indefiniteWidget = (y.childrenMap.colIndefinite ?? {:});
    hasIndefinite = (hasIndefinite == false)? indefiniteWidget.value : true;
    var errorExists = !(indefiniteWidget.value)? (errorPayloadMappedNotInfinite.filter(x => {(((x.startDate.between(endDateWidget.value, 'DAY') >= 0) || (x.endDate.between(startDateWidget.value, 'DAY')<= 0) ))})).map(x => {x.errorText}) : [];
     // below line commented by Pasha 02/03 - Chester review pending
    // var errorExists2 = errorPayloadMappedNotInfinite.filter(t =>{(t.startDate.between(startDateWidget.value, 'DAY') >=0) && (t.endDate.between(startDateWidget.value, 'DAY')<=0)}).map(x => {x.errorText}) ?? [];
    var errorExistsIndefinite = (indefiniteWidget.value)? (errorPayloadMappedIndefinite ?? []).map(x => {x.errorText}) ?? [] : [];
     //Pasha modified below errorString  02/03 - Chester review pending
    var errorString = (!empty(errorExists)?(errorExists.join(', ')): '') +  (!empty(errorExistsIndefinite)?(errorExistsIndefinite.join(', ')): '') ; 
    //var errorString = (!empty(errorExists)?(errorExists.join(', ')): '') +  (!empty(errorExistsIndefinite)?(errorExistsIndefinite.join(', ')): '') + (!empty(errorExists2)?(errorExists2.join(', ')): '') ;
    if(!empty(errorString)){
      startDateWidget.setError(errorString ?? '');
    }else{
      startDateWidget.clearError();
    }
    if(indefiniteWidget.value){
      indefiniteTotal= indefiniteTotal + number:toBigDecimal((y.childrenMap.colPercent.childrenMap.percentAmountSection.childrenMap.percentAmount.value ?? 0), 2, 'CEILING');
    }
    
  }
  var zeroError = errorPayloadMappedNotInfinite.filter(x => {x.sumIsZero == true}).map(x => {x.errorText});
  if(!empty(zeroError)){
    var errorString = (!empty(zeroError)?( zeroError.join(', ')) : '');
    errorWidget.setError(errorString);
  }else{
    errorWidget.clearError();
  }
  if(hasIndefinite){
    var indefiniteWidget = (y.childrenMap.colIndefinite ?? {:});
    if((indefiniteTotal < 100) || (indefiniteTotal > 100)){
      indefiniteWidget.setError('Indefinite must add up to 100 %');
    }else{
      indefiniteWidget.clearError();
    }
  }
    
}

var getDefaultPayload = function(rows, columns, startDate, lastDay, flowSartDate){
  var counter = 0;
  var startDateBeforePrompt = startDate <= (flowSartDate ?? date:now());
  var defaultPayload = {'WorkTags': 'Total: '};
  for (var y : columns){
    var periodStartDate = y.periodStartDate ?? '';
    var periodMap = {:};
    var periodEndDate = y.periodEndDate ?? '';
    var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
    var periodSum = 0;
    if(!empty(lastDay)){
      var lastPeriod = lastDay < periodEndDate;
    }else{
      var lastPeriod= false;
    }
    var showError = !lastPeriod;
    //var betweenPeriod = false;
    if(counter == 0){
      var showError = !startDateBeforePrompt;
    }
    for(var x : rows){
      var value = x.get(dateFormatted);
      if(string:isString(value)){
        var valueDecimal =  value.toDecimal();
      }else{
        var valueDecimal =  value;
      }
      periodSum = ((valueDecimal ?? 0) + periodSum);
    }
    if(periodSum > 100){
      var defaultAllocation =  number:toBigDecimal((number:toBigDecimal((periodSum), 2, 'DOWN')), 2, 'DOWN');
    }else{
      var defaultAllocation =  number:toBigDecimal((number:toBigDecimal((periodSum), 2, 'DOWN')), 2, 'UP');
    }
    var defaultAllocationString = '';
    if((defaultAllocation > 100) || (defaultAllocation < 100)){
    if(showError){
      defaultAllocationString = 'Error: ' + (defaultAllocation ?? 0);
    }else{
      defaultAllocationString = defaultAllocation ?? '';
    }
    }else{
    defaultAllocationString = defaultAllocation ?? '';
    }
    periodMap = json:create(json:attribute(dateFormatted, defaultAllocationString));
    defaultPayload.addAll(periodMap);
    counter = counter+1;
  }
  return defaultPayload;
}




var getPercentageData = function(gridData1, gridColumns, flowStartDate){
    var grid = gridData1 ?? [];
    var gridPayload = [];
    var mostStartDate = gridData1.map(l =>{l.childrenMap.colStartDate.childrenMap.startDate.value ?? ''}).sort()[0] ?? '';
    var mostLastDate = gridData1.map(l =>{l.childrenMap.colStartDate.childrenMap.startDate.value ?? ''}).sort().last() ?? '';
    for(var x : (gridData1 ?? [])){
      if(empty(x.childrenMap.colStartDate.childrenMap.startDate.value)){
        x.childrenMap.colStartDate.childrenMap.startDate.setError('Start Date must have a value');
        return [];
      }else{
        var worktags = x.childrenMap.colallRemainingWorktag.childrenMap.allRemainingWorktag.selectedEntries.map(y =>{y.descriptor}) ?? [];
        var costCenter = !empty(x.childrenMap.colCostCenterWorktag.childrenMap.CostCenterWorktag.value[0])? ('Cost Center: '+ (x.childrenMap.colCostCenterWorktag.childrenMap.CostCenterWorktag.selectedEntries[0].descriptor ?? '')) : '';
        var fund = !empty(x.childrenMap.colFundWorktag.childrenMap.fundWorktag.value[0])? ('Fund: ' + (x.childrenMap.colFundWorktag.childrenMap.fundWorktag.selectedEntries[0].descriptor ?? '')) : '';
        var grant = !empty(x.childrenMap.colGrantWorktag.childrenMap.grantWorktag.value[0])? ('Grant: ' + (x.childrenMap.colGrantWorktag.childrenMap.grantWorktag.selectedEntries[0].descriptor ?? '')) : '';
        var project = !empty(x.childrenMap.colProjectWorktag.childrenMap.projectWorktag.value[0])? ('Project: ' + (x.childrenMap.colProjectWorktag.childrenMap.projectWorktag.selectedEntries[0].descriptor ?? '')) : '';
        var budgetUnit = !empty(x.childrenMap.colBudgetUnitWorktag.childrenMap.budgetUnitWorktag.value[0])? ('Budget unit: ' + (x.childrenMap.colBudgetUnitWorktag.childrenMap.budgetUnitWorktag.selectedEntries[0].descriptor ?? '')) : '';
        var activity = !empty(x.childrenMap.colActivityWorktag.childrenMap.activityWorktag.value[0])? ('Activity: ' + (x.childrenMap.colActivityWorktag.childrenMap.activityWorktag.selectedEntries[0].descriptor ?? '')): '';
        //update worktags based on new data
        if(!empty(costCenter)){
            worktags.add(costCenter);
        }
        if(!empty(fund)){
            worktags.add(fund);
        }
        if(!empty(budgetUnit)){
            worktags.add(budgetUnit);
        }
        if(!empty(activity)){
            worktags.add(activity);
        }
        if(!empty(project)){
            worktags.add(project);
        }
        if(!empty(grant)){
            worktags.add(grant);
        }
        var worktagsJoin = worktags.join('\n');
        var worktagspayload = {'WorkTags': worktagsJoin};
        var startDate = (x.childrenMap.colStartDate.childrenMap.startDate.value ?? '');
        var endDate = (x.childrenMap.colEndDate.childrenMap.endDate.value ?? '');
        var percentage = number:toBigDecimal((x.childrenMap.colPercent.childrenMap.percentAmountSection.childrenMap.percentAmount.value ?? 0), 2, 'HALF_EVEN');
        var indefinite = (x.childrenMap.colIndefinite.value ?? false);
        var gridRows = {:};
        gridRows.addAll(worktagspayload);
        var gridColumnSize = !empty(gridColumns)? gridColumns.size() : 0;
        var counter = 1;
        for (var y : gridColumns){
            var periodStartDate = y.periodStartDate ?? '';
            var periodMap = {:};
            var periodEndDate = y.periodEndDate ?? '';
            var numOfDaysInRequest = 0;
            //var lastPeriod = mostLastDate < periodEndDate;
            var numOfdaysInMonth = 0;
            if(indefinite){
              if((startDate.between(periodEndDate, 'DAY')>=0)){
                var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                if(counter == 1){
                  var firstDayOfMonth = periodStartDate;
                  firstDayOfMonth = firstDayOfMonth.minusDays(1);
                  numOfdaysInMonth = firstDayOfMonth.between(periodEndDate, 'DAY');
                  var startDateIsInPeriod = (startDate.format('yyyy-MM') == periodStartDate.format('yyyy-MM'));
                  if(startDate.between(periodStartDate, 'DAY') >  0){
                    numOfDaysInRequest =  startDateIsInPeriod? number:toBigDecimal((periodStartDate.between(periodEndDate, 'DAY') +1), 2, 'CEILING') : periodStartDate.between(periodEndDate, 'DAY');
                    numOfdaysInMonth = periodStartDate.between(periodEndDate, 'DAY'); 
                  }else{
                    numOfDaysInRequest =  startDateIsInPeriod? number:toBigDecimal((startDate.between(periodEndDate, 'DAY') +1), 2, 'CEILING') : periodStartDate.between(periodEndDate, 'DAY');
                  }
                }else{
                  numOfDaysInRequest = periodStartDate.between(periodEndDate, 'DAY');
                  numOfdaysInMonth = periodStartDate.between(periodEndDate, 'DAY');
                }
                var distributionPercentPeriod = number:toBigDecimal((percentage)*(numOfDaysInRequest/numOfdaysInMonth), 2, 'CEILING');
                periodMap = json:create(json:attribute(dateFormatted, distributionPercentPeriod));
                counter = counter + 1;
              }else{
                var distributionPercentPeriod = 0;
                var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                periodMap = json:create(json:attribute(dateFormatted, distributionPercentPeriod));
              }
            }else{
              if((startDate.between(periodEndDate, 'DAY')>=0) && (periodStartDate.between(endDate, 'DAY') > 0 )){
                var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                if((periodStartDate.between(startDate, 'DAY')>=0) && (endDate.between(periodEndDate, 'DAY') >=0 )){
                  //var firstDayOfMonth = periodEndDate.minusMonths(1);
                  var firstDayOfMonth = periodStartDate;
                  firstDayOfMonth = firstDayOfMonth.minusDays(1);
                  numOfdaysInMonth = firstDayOfMonth.between(periodEndDate, 'DAY');
                  numOfDaysInRequest =   number:toBigDecimal((startDate.between(endDate, 'DAY') + 1), 2, 'HALF_EVEN');
                }else if(endDate.between(periodEndDate, 'DAY') >= 0 ){
                  var firstDayOfMonth = periodStartDate;
                  firstDayOfMonth = firstDayOfMonth.minusDays(1);
                  numOfdaysInMonth = firstDayOfMonth.between(periodEndDate, 'DAY');
                  numOfDaysInRequest =  number:toBigDecimal((periodStartDate.between(endDate, 'DAY') + 1), 2, 'HALF_EVEN');
                }else if((periodStartDate.between(startDate, 'DAY') >= 0) ){
                  var firstDayOfMonth = periodStartDate;
                  firstDayOfMonth = firstDayOfMonth.minusDays(1);
                  numOfdaysInMonth = firstDayOfMonth.between(periodEndDate, 'DAY');
                  numOfDaysInRequest =  number:toBigDecimal((startDate.between(periodEndDate, 'DAY') + 1), 2, 'HALF_EVEN');
                }else{
                  numOfDaysInRequest = 1;
                  numOfdaysInMonth = 1;
                }
                numOfdaysInMonth = number:toBigDecimal(numOfdaysInMonth, 2, 'HALF_EVEN');
                var distributionPercentPeriod = number:toBigDecimal((percentage)*(numOfDaysInRequest/numOfdaysInMonth), 2, 'HALF_EVEN');
                periodMap = json:create(json:attribute(dateFormatted, distributionPercentPeriod));
                counter = counter + 1;
              }else{
                var distributionPercentPeriod = 0;
                var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                periodMap = json:create(json:attribute(dateFormatted, distributionPercentPeriod));
              }
            }
            gridRows.addAll(periodMap);
        }
        gridPayload.add(gridRows);
      }
    }
    var default = getDefaultPayload(gridPayload, gridColumns, mostStartDate, (mostLastDate ?? ''), flowStartDate);
    gridPayload.add(default);
    return gridPayload;
}




var setPanelValues = function(panels, earningsToSelectFrom){
  var panelsValue = panels.getPanels() ?? [];
  var earningsToChooseFromUpdated = earningsToSelectFrom.size() == panelsValue.size();
  var counter = 0;
  var earningsOnPage = [];
  var earningsToSelectFromValue= earningsToSelectFrom.map(x =>{{
    'id': (x.id ?? ''),
    'descriptor' : (x.descriptor ?? '')
  }}) ?? [];
  for(var x : panelsValue){
    if(!empty(x.children[1].childrenMap.earningGroupList.value)){
      x.children[1].childrenMap.earningGroupList.setValues(x.children[1].childrenMap.earningGroupList.selectedEntries);
      x.children[1].childrenMap.earningGroupList.setValue([x.children[1].childrenMap.earningGroupList.selectedEntries[0].id]);
    }
    earningsOnPage.add(((!empty(x.children[1].childrenMap.individualEarnings.selectedEntries ?? []))? (x.children[1].childrenMap.individualEarnings.selectedEntries ?? []) : (x.children[1].childrenMap.earningGroupList.selectedEntries ?? [])));
    x.children[4].setValue(counter);
    earningsToSelectFromValue = earningsToSelectFromValue.removeAll(list:flatten(earningsOnPage ?? []));
    counter = counter + 1;
    if(empty(x.children[1].childrenMap.earningGroupList.value)){
      x.children[1].childrenMap.earningGroupList.setValues(earningsToSelectFromValue);
    }
  }
  if(empty(earningsToSelectFromValue)){
    panels.setDoNotAdd(true);
  }else{
    panels.setDoNotAdd(false);
  }
  return (earningsToSelectFromValue ?? []);
}

var updateGridEnabled = function(gridIsEnabled, setPercentage){
  var isUpdated = false;
  for(var x : (setPercentage.children ?? [])){
    if(!isUpdated){
      isUpdated = Mapping.getUpdated(x);
    }
    if(!empty(x.childrenMap.colGrantWorktag.childrenMap.grantWorktag.value[0])){
      var worktags = getWorktags.invoke({'taggableType': 'GRANT', 'worktag': x.childrenMap.colGrantWorktag.childrenMap.grantWorktag.value[0], 'taggableTypes': ['GRANT']}) ?? [];
      var relatedWorktags = worktags.data[0].relatedWorktagsForOperationalTransactionType ?? [];
      x.childrenMap.colallRemainingWorktag.childrenMap.allRemainingWorktag.setEnabled(gridIsEnabled);
      x.childrenMap.colAmount.setEnabled(gridIsEnabled);
      x.childrenMap.colProjectWorktag.childrenMap.projectWorktag.setEnabled(false);
      x.childrenMap.colGrantWorktag.childrenMap.grantWorktag.setEnabled(gridIsEnabled);
      if(empty(relatedWorktags.filter(y =>{(string:contains(y.descriptor, 'Activity'))}) ?? [])){
        x.childrenMap.colActivityWorktag.childrenMap.activityWorktag.setEnabled(true);
      }else{
        x.childrenMap.colActivityWorktag.childrenMap.activityWorktag.setEnabled(false);
      }
      if(!gridIsEnabled){
        x.childrenMap.colPercent.childrenMap.percentTextSection.childrenMap.percentText.setVisible(true);
        x.childrenMap.colPercent.childrenMap.percentAmountSection.childrenMap.percentAmount.setVisible(false);
      }else{
        x.childrenMap.colPercent.childrenMap.percentAmountSection.childrenMap.percentAmount.setVisible(true);
        x.childrenMap.colPercent.childrenMap.percentTextSection.childrenMap.percentText.setVisible(false);
      }
