script.include("Mapping.script")

var allocationValidation = function(bodyMapped, earningGroup, startDate, endDate, type){
    var filteredBody =[];
    //var filteredBody = filteredBody.earnings ?? [];   
    if(!empty(earningGroup)){
      if(type == 'sendBack'){
        filteredBody = bodyMapped.earnings.filter(x =>{(x.earningsList ?? []).contains(earningGroup[0])});

      }else{
        filteredBody = bodyMapped.earnings.filter(x =>{(x.earningGroup ?? []).contains(earningGroup[0])});
      }
    }
    var intervalValues = filteredBody[0].intervalData ?? [];
    var error = [];
    for(var x : intervalValues){       
        var lineDataDefault = x.lineData ?? [];
        var startDates = x.startDate ?? '';
        var endDates = x.endDate ?? '';
        var indefinite = x.indefinite ?? false;
        var intervalPercentSum = 0;
        var intervalDefaultPercentSum = 0;
            //if sum is greater than 100% then throw error
        var lineDataMapped = x.lineData.map(y=> {
          {
            'gift': y.gift.id ?? '',
            'grantId': (y.grantId ?? ''),
            'costCenter': (y.costCenter.id ?? ''),
            'center': (y.center.id ?? ''),
            'project': (y.project.id ?? ''),
            'fund': (y.fund.id ?? ''),
            'budgetUnit': (y.budgetUnit.id ?? ''),
            'clinicalAssignment': (y.clinicalAssignment.id ?? ''),
            'activityType': (y.activityType.id ?? '')
          }
        }) ??[];
        var lineDataSize = lineDataMapped.size();
        //mapping
        var distinctLineDataSize = (lineDataMapped.distinct() ?? []).size();
        if(lineDataSize != distinctLineDataSize){
          var errorText = 'Worktags Must Be Unique';
          var errorPayload ={
            'periodStartDate': startDates ?? '',
            'periodEndDate': endDates ?? '',
            'errorText': errorText ?? '',
            'indefinite': false
          }
          error.add(errorPayload);
        }
        if((x.sum ?? 0) > 1){
            if(!indefinite){
                var errorText = ' periods between ' + startDates.format('MM/dd/yyyy') + ' - ' + endDates.format('MM/dd/yyyy') + ' are above 100% allocation. ';
                    var errorPayload = {
                        'periodStartDate': startDates ?? '',
                        'periodEndDate': endDates ?? '',
                        'errorText': errorText ?? '',
                        'indefinite': false
                    }
                        error.add(errorPayload);

            }else{
                var errorText = 'Indefinite data is allocated above 100%, please adjust this period. ';
                    var errorPayload ={
                        'periodStartDate': startDates ?? '',
                        'periodEndDate': endDates ?? '',
                        'errorText': errorText ?? '',
                        'indefinite': true
                    }
                    error.add(errorPayload);
            }
        }
        //if total sum is higher than 100% then throw error
        if((x.sum ?? 0) < 1){
            if(!indefinite){
                if(x.sum == 0){
                    var errorText = ' periods between ' + startDates.format('MM/dd/yyyy') +  ' - ' + endDates.format('MM/dd/yyyy') + ' are allocated below 100%, please adjust this period. ';
                    var errorPayload ={
                        'periodStartDate': startDates ?? '',
                        'periodEndDate': endDates ?? '',
                        'errorText': errorText ?? '',
                        'indefinite': false,
                        'sumIsZero': true
                    }
                    error.add(errorPayload);
                }else{
                    var errorText = ' periods between ' + startDates.format('MM/dd/yyyy') +  ' - ' + endDates.format('MM/dd/yyyy') + ' are allocated below 100%, please adjust this period. ';
                    var errorPayload ={
                        'periodStartDate': startDates ?? '',
                        'periodEndDate': endDates ?? '',
                        'errorText': errorText ?? '',
                        'indefinite': false,
                        'sumIsZero': false
                    }
                    error.add(errorPayload);
                }
                
            }else{
                var errorText = 'Indefinite data is allocated below 100%, please adjust this period. ';
                var errorPayload ={
                    'periodStartDate': startDates ?? '',
                    'periodEndDate': endDates ?? '',
                    'errorText': errorText ?? '',
                    'indefinite': true,
                    'sumIsZero': false
                }
                error.add(errorPayload);
            }
        }
        //added by Pasha start date should not less the 28-DEC-2025
       if((!empty(startDates)) && (!empty(endDates)))
       {
           if(((startDates.format('yyyy-MM-dd')) < '2025-12-28' ) ){
             var errorText = 'For labor costing adjustments prior to 12/28/2025 for non-exempt workers and 1/1/2026 for exempt workers, please submit a Funding Reallocation Form (FRF), located on the Infoscope Workday Training Resources Finance page.';
             var errorPayload ={
                  'periodStartDate': startDates ?? '',
                   'periodEndDate': endDates ?? '',
                  'errorText': errorText ?? ''
             }
              error.add(errorPayload);
          }   
       }
    }
    var returnPayload = {
        'errorArray': error ?? []
    };  
    return returnPayload ?? {:};
}

var getAllocationAssignmentWorktags = function(CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag, startDate, EndDate, payPeriod, earningGroup, workerType, assignAllocationTags, allOtherWorktag, projectAttribute){
        
    var costCenterReferenceID = CostCenterWorktag.selectedEntries[0].descriptor.substringBefore(' ') ?? '';
    var activityReferenceID = activityWorktag.selectedEntries[0].descriptor.substringBefore('-') ?? '';
    var fundReferenceID = fundWorktag.selectedEntries[0].descriptor.substringBefore(' ') ?? '';
    var budgetUnitReferenceID = budgetUnitWorktag.selectedEntries[0].descriptor.substringBefore('-') ?? '';
    var grantReferenceID = grantWorktag.selectedEntries[0].descriptor.substringAfterLast(' ') ?? '';
    var projectReferenceID = projectWorktag.selectedEntries[0].descriptor.substringBefore(' ') ?? '';
    var giftReferenceID = allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Gift:')})[0].substringBefore(' ').substringAfter('Gift:') ?? '';
    var assignmentAllocationRefID = allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Assignment Allocation:')})[0].substringBefore('-').substringAfter('Assignment Allocation:') ?? '';
    var centerRefID = allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Center:')})[0].substringBefore('-').substringAfter('Center:') ?? '';
    var refIDArray = [(costCenterReferenceID ?? ''), (activityReferenceID ?? ''),(fundReferenceID ?? ''),(budgetUnitReferenceID ?? ''),(grantReferenceID ?? ''),(projectReferenceID ?? ''),(giftReferenceID ?? ''),(assignmentAllocationRefID ?? ''),(centerRefID ?? '')];
    if((earningGroup ?? '') == 'Base Salary'){
      //MCW-14463 , added worker type Faculty - Non Clinical
        if(((workerType.descriptor ?? '') == 'Faculty - Clinical')  || ((workerType.descriptor ?? '') == 'Faculty - Non Clinical') ){
            
             if((activityReferenceID ?? '').contains('20')){
                if(!empty(projectAttribute)){
                  if(refIDArray.contains('300.U') || refIDArray.contains('400.U') || refIDArray.contains('700.U')|| refIDArray.contains('706.U')){
                    var assignAllocation = assignAllocationTags.filter(x =>{x.descriptor.contains(projectAttribute.descriptor)}) ?? [];
                    var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];
                    var remainingWortagValueSelected = allRemainingWorktag.value.sort ?? [];
                    return (allRemainingWorktagAllocation ?? []);
                  }
                }
                if(refIDArray.contains('106.U')){
                    var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU Onsite' || (x.descriptor ?? '') == 'Assignment Allocation:VA Support' || (x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                    var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];
                    var remainingWortagValueSelected = allRemainingWorktag.value.sort ?? [];
                    return (allRemainingWorktagAllocation ?? []);
                }
              
                if(refIDArray.contains('156.U')){
                    var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU Onsite' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                    var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                    var remainingWortagValueSelected = allRemainingWorktag.value ?? [];

                    return (allRemainingWorktagAllocation ?? []);
                }
                
                if(refIDArray.contains('164.U')){
                    var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU_offsite- wRVU Offsite' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                    var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                    var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                    return (allRemainingWorktagAllocation ?? []);
                }
                if(refIDArray.contains('350.U')){
                    var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:VA Support' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                    var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                    var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                    return (allRemainingWorktagAllocation ?? []);
                }                    
                if(!(refIDArray.contains('350.U') || refIDArray.contains('164.U') || refIDArray.contains('156.U') || refIDArray.contains('106.U'))){
                    var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                    var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                    var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                   return (allRemainingWorktagAllocation ?? []);
                }
              else{
                //allocation assignment with all other worktags. need to confirm all other worktags funds
                var assignAllocation = [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                return (allRemainingWorktagAllocation ?? []);
              }
            }else{
              //added by Pasha 01/08 CA001020
               var assignAllocation = [];
          var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
          return (allRemainingWorktagAllocation ?? []);
            }

            
        }else if (((workerType.descriptor ?? '') == 'Staff Physician - Clinical') || ((workerType.descriptor ?? '') == 'Staff - Clinical')  ){
          if((activityReferenceID ?? '').contains('20')){
            if(!empty(projectAttribute)){
              if(refIDArray.contains('300.U') || refIDArray.contains('400.U') || refIDArray.contains('700.U')|| refIDArray.contains('706.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{x.descriptor.contains(projectAttribute.descriptor)}) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];
                var remainingWortagValueSelected = allRemainingWorktag.value.sort ?? [];
                return (allRemainingWorktagAllocation ?? []);
              }
              
            }
            if(refIDArray.contains('106.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU Onsite' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
            }
            if(refIDArray.contains('156.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU Onsite' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
            }
            if(refIDArray.contains('164.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU_offsite- wRVU Offsite' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
            }
            if(refIDArray.contains('350.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:VA Support' ||(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
            }
            if(!(refIDArray.contains('350.U') || refIDArray.contains('164.U') || refIDArray.contains('156.U') || refIDArray.contains('106.U'))){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
            }

          }else{
                //allocation assignment with all other worktags. need to confirm all other worktags funds
                var assignAllocation = [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                return (allRemainingWorktagAllocation ?? []);
            }      
        } else{
          //allocation assignment with all other worktags. need to confirm all other worktags funds
          var assignAllocation = [];
          var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
          return (allRemainingWorktagAllocation ?? []);
        }  
    }else if((earningGroup ?? '') == 'Supplemental Pay'){
      //MCW-14463 , added Faculty - Non Clinical
        if (((workerType.descriptor ?? '') == 'Staff Physician - Clinical') || ((workerType.descriptor ?? '') == 'Staff - Clinical')  || ((workerType.descriptor ?? '') == 'Faculty - Clinical') || ((workerType.descriptor ?? '') == 'Faculty - Non Clinical')){
            if((activityReferenceID ?? '').contains('20')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
            }else{
                //allocation assignment with all other worktags. need to confirm all other worktags funds
                var assignAllocation = [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                return (allRemainingWorktagAllocation ?? []);
  
            } 
        } else{ 
                //allocation assignment with all other worktags. need to confirm all other worktags funds
                var assignAllocation = [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                return (allRemainingWorktagAllocation ?? []);
                
            } 
        if( ((workerType.descriptor ?? '') == 'Faculty - No Base Salary Non Clinical') ||((workerType.descriptor ?? '') == 'Faculty - No Base Salary Clinical')) {
            if((activityReferenceID ?? '').contains('20')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = allRemainingWorktag.value ?? [];
                return (allRemainingWorktagAllocation ?? []);
                 }
            //MCW-14463, added Faculty - Non Clinical
        } else if(!(((workerType.descriptor ?? '') == 'Staff Physician - Clinical') || ((workerType.descriptor ?? '') == 'Staff - Clinical')  || ((workerType.descriptor ?? '') == 'Faculty - Clinical') || ((workerType.descriptor ?? '') == 'Faculty - Non Clinical')  )){
                //allocation assignment with all other worktags. need to confirm all other worktags funds
                var assignAllocation = [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                return (allRemainingWorktagAllocation ?? []);
                 } 
        
    } else{
      //allocation assignment with all other worktags. need to confirm all other worktags funds
      var assignAllocation = [];
      var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
      return (allRemainingWorktagAllocation ?? []);
    }  

}
var validateWorktags = function(indefinite, CostCenterWorktag, activityWorktag,fundWorktag, budgetUnitWorktag, grantWorktag, projectWorktag, allRemainingWorktag, startDate, EndDate, payPeriod, earningGroup, workerType, assignAllocationTags, allOtherWorktag, projectAttribute, transactionType){
    CostCenterWorktag.clearError();
    if(!empty(activityWorktag)){
      activityWorktag.clearError();
    }
    if(!empty(fundWorktag)){
      fundWorktag.clearError();
    }
    if(!empty(budgetUnitWorktag)){
      budgetUnitWorktag.clearError();
    }
    if(!empty(grantWorktag)){
      grantWorktag.clearError();
    }
    if(!empty(projectWorktag)){
      projectWorktag.clearError();
    }
    if(!empty(allRemainingWorktag)){
      allRemainingWorktag.clearError();
    }
    var costCenterReferenceID = CostCenterWorktag.selectedEntries[0].descriptor.substringBefore(' ') ?? '';
    var activityReferenceID = activityWorktag.selectedEntries[0].descriptor.substringBefore('-') ?? '';
    var fundReferenceID = fundWorktag.selectedEntries[0].descriptor.substringBefore(' ') ?? '';
    
       var validateFund1 =  getFundsWorktagData.invoke({'id':fundReferenceID}) ?? [];
    var budgetUnitReferenceID = budgetUnitWorktag.selectedEntries[0].descriptor.substringBefore('-') ?? '';
    var grantReferenceID = grantWorktag.selectedEntries[0].descriptor.substringAfterLast(' ') ?? '';
    var projectReferenceID = projectWorktag.selectedEntries[0].descriptor.substringBefore(' ') ?? '';
    var giftReferenceID = allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Gift:')})[0].substringBefore(' ').substringAfter('Gift:') ?? '';
    var assignmentAllocationRefID = allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Assignment Allocation:')})[0].substringBefore('-').substringAfter('Assignment Allocation:') ?? '';
    var centerRefID = allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Center:')})[0].substringBefore('-').substringAfter('Center:') ?? '';
  
    if(!empty(projectWorktag.visible)){
      projectWorktag.clearError();
    }
    if(!empty(grantWorktag.visible)){
      grantWorktag.clearError();
    }
    
    if(!empty(projectReferenceID)){
      var projectData = getProjectDeferred.invoke({'id':projectWorktag.value[0] }) ?? [];
      projectWorktag.clearError();

      //  if((transactionType != 'project') || (transactionType != 'startDate') || (transactionType != 'endDate') || (transactionType != 'indefinite')){
      //      projectWorktag.setError('You cannot update the related worktags when a project has been selected');
      //    }
      if(!empty(projectData.data[0].projectEndDate)){
        if(!empty(startDate) && !empty(payPeriod)){
          //projectWorktag.clearError();

          if((projectData.data[0].projectEndDate ?? '') < (startDate.format('yyyy-MM-dd')) ){
              projectWorktag.setError('The Project ended on ' + date:parse(projectData.data[0].projectEndDate).format('MM/dd/yyyy') + ', Please select another Project');
          }
        }

        if( !empty(payPeriod) && !empty(EndDate)){
         // projectWorktag.clearError();
          if((projectData.data[0].projectEndDate ?? '') < (EndDate.format('yyyy-MM-dd'))){
              projectWorktag.setError('The Project ended on ' + date:parse(projectData.data[0].projectEndDate).format('MM/dd/yyyy') + ', Please select another Project');
          }
        }
        if((indefinite.value ?? false)  && !empty(payPeriod)){
          projectWorktag.setError('The Project ended on ' + date:parse(projectData.data[0].projectEndDate).format('MM/dd/yyyy') + ', Please select another Project');
        }
      }
      if(!empty(projectData.data[0].projectStartDate)){
        if(!empty(startDate) && !empty(payPeriod)){
          //projectWorktag.clearError();
          if((projectData.data[0].projectStartDate ?? '') > (startDate.format('yyyy-MM-dd')) ){
            projectWorktag.setError('The Project Starts on ' + date:parse(projectData.data[0].projectStartDate).format('MM/dd/yyyy') + ', Please select another Project');
          }
        }
      } 
     
    }


    if(!empty(grantReferenceID)){
      
        var grantData = getGrantDeferred.invoke({'id':grantWorktag.value[0] }) ?? [];
        grantWorktag.clearError();
      //  if((transactionType != 'grant') || (transactionType != 'startDate') || (transactionType != 'endDate') || (transactionType != 'indefinite')){
       //   grantWorktag.setError('You cannot update the related worktags when a grant has been selected');
       // }
        
        //setError commented by Pasha on 11/17 MCW-14508
        if(!empty(grantData.data[0].effectiveAwardLine.toDate)){
          if(!empty(startDate) && !empty(payPeriod)){

            if((grantData.data[0].effectiveAwardLine.toDate ?? '') < (startDate.format('yyyy-MM-dd'))){

              //grantWorktag.setError('The Grant Award expired on ' + date:parse(grantData.data[0].effectiveAwardLine.toDate).format('MM/dd/yyyy') + ', Please select another Grant');
              grantWorktag.setWarning('The Grant Award expired on ' + date:parse(grantData.data[0].effectiveAwardLine.toDate).format('MM/dd/yyyy') + ', Please select another Grant');
            }
          }
          if(!empty(EndDate) && !empty(payPeriod)){

            if(((grantData.data[0].effectiveAwardLine.toDate ?? '') < (EndDate.format('yyyy-MM-dd')))){

              //grantWorktag.setError('The Grant Award expired on ' + date:parse(grantData.data[0].effectiveAwardLine.toDate).format('MM/dd/yyyy') + ', Please select another Grant');
              grantWorktag.setWarning('The Grant Award expired on ' + date:parse(grantData.data[0].effectiveAwardLine.toDate).format('MM/dd/yyyy') + ', Please select another Grant');
            }
          }
          if((indefinite.value ?? false) && !empty(payPeriod)){
            //grantWorktag.setError('The Grant Award expired on ' + date:parse(grantData.data[0].effectiveAwardLine.toDate).format('MM/dd/yyyy') + ', Please select another Grant');
            grantWorktag.setWarning('The Grant Award expired on ' + date:parse(grantData.data[0].effectiveAwardLine.toDate).format('MM/dd/yyyy') + ', Please select another Grant');
          }

        }
        
        
    }

    
    //from Maintain Custom Validation tasks. accounting journal section 
    // requires you 
    var refIDArray = [(costCenterReferenceID ?? ''), (activityReferenceID ?? ''),(fundReferenceID ?? ''),(budgetUnitReferenceID ?? ''),(grantReferenceID ?? ''),(projectReferenceID ?? ''),(giftReferenceID ?? ''),(assignmentAllocationRefID ?? ''),(centerRefID ?? '')];
    if(!empty(refIDArray)){
        if(refIDArray.contains('102.U')){
           // if(empty(grantWorktag.value[0])){ 
            // if(empty(grantWorktag.selectedEntries[0])){
              if(empty(grantReferenceID))              
              {

              if(!empty(fundWorktag)){
                fundWorktag.setError('Grant cannot be empty with this Fund');                
              }
            }
        }
        if(refIDArray.contains('103.U') || refIDArray.contains('119.U')|| refIDArray.contains('123.U')|| refIDArray.contains('131.U')|| refIDArray.contains('156.U')|| refIDArray.contains('164.U')|| refIDArray.contains('168.U')|| refIDArray.contains('300.U')|| refIDArray.contains('350.U')|| refIDArray.contains('400.U')|| refIDArray.contains('700.U')|| refIDArray.contains('706.U')|| refIDArray.contains('772.U')){

            if(empty(projectWorktag.value[0])){
              if(!empty(fundWorktag)){
                fundWorktag.setError('Project cannot be empty with this Fund');
              }
            }
        }
        if(refIDArray.contains('116.U') || refIDArray.contains('117.P')|| refIDArray.contains('117.T')|| refIDArray.contains('117.U')|| refIDArray.contains('118.T')|| refIDArray.contains('118.U')|| refIDArray.contains('150.U')|| refIDArray.contains('150.T')){

            if(empty(allRemainingWorktag.selectedEntries.map(t =>{t.descriptor}).filter(x=>{x.contains('Gift:')})[0])){
              if(!empty(fundWorktag)){
                fundWorktag.setError('Gift cannot be empty with this Fund');
              }
            }
        }
    }

    // MCW-14463, added Faculty Non-clinical
    if((earningGroup ?? '') == 'Base Salary'){
      if(((workerType.descriptor ?? '') == 'Faculty - Clinical') || ((workerType.descriptor ?? '') == 'Faculty - Non Clinical')  ){

          if((activityReferenceID ?? '').contains('20')){
            if(!empty(projectAttribute)){
              if(refIDArray.contains('300.U') || refIDArray.contains('400.U') || refIDArray.contains('700.U')|| refIDArray.contains('706.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{x.descriptor.contains(projectAttribute.descriptor)}) ?? [];
                var allRemainingWorktagAllocation = list:join((allOtherWorktag ?? []), (assignAllocation ?? [])).sort() ?? [];;
                var remainingWortagValueSelected = list:join((allRemainingWorktag.value ?? []), ([]));
                allRemainingWorktag.setValues(allRemainingWorktagAllocation ?? []);
                allRemainingWorktag.setValue(remainingWortagValueSelected ?? []);
              }
            }else if(refIDArray.contains('106.U')){
                var assignAllocation = assignAllocationTags.filter(x =>{(x.descriptor ?? '') == 'Assignment Allocation:wRVU Onsite' || (x.descriptor ?? '') == 'Assignment Allocation:VA Support' || (x.descriptor ?? '') == 'Assignment Allocation:Non-wRVU' }) ?? [];
