{
  "securityDomains": [
    "ManageCostingAllocation"
  ],
  "id": "ViewCostingAllocation",
  "endPoints": [
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorktags",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% 
      return '/data?query=' + string:urlEncode('PARAMETERS taggableType = (Taggable_Type_ID= ' + taggableType + ' ) SELECT worktagWithRelatedWorktags, relatedWorktagsForOperationalTransactionType FROM relatedWorktags (taggableTypes = (Taggable_Type_ID= ' + taggableTypes.join(', ') + ' ) ) WHERE worktagWithRelatedWorktags in ( \\''+ worktag + '\\')') %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getFunds",
      "authType": "laborISUV2",
      "_url": "<% 
        return  '/data?query=' + string:urlEncode('SELECT fund FROM funds WHERE inactive = false') %>",
        "url": "<% return  '/data?query=' + string:urlEncode('SELECT fund FROM funds WHERE inactive = false AND includedInFundHierarchies not in (Fund_Hierarchy_ID=\\'FDL1_Labor_Costing_Validation\\') ' ) %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getCostCenter",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT costCenter FROM costCenters WHERE inactive = false') %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getGrant",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT grant FROM grants WHERE inactive = false') %>"
    },
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getGift1",
      "authType": "laborISUV2",
      "httpMethod": "GET",
      "url": "/GetReferencessSync/launch?referenceID=Gift_Reference_ID"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getGift",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT gift FROM gifts (dataSourceFilter = giftForCompanyAndRoleAccess)') %>"
    },
    {
      "_baseUrlType": "Workday-WQL",
      "name": "getProject",
      "authType": "laborISUV2",
      "_url": "https://api.workday.com/projects/v1/projects",
      "url": "https://api.us.wcp.workday.com/projects/v1/projects?limit=100",
      "isCollection": true 
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorkerData",
      "authType": "laborISUV2",
      "exclude": "<% empty(queryParams.workerID); %>",
      "_url": "<% '/data?query=' + string:urlEncode('SELECT worker, allPositions as positions, cf_CurrentOpenPayPeriod_StartDate as currentPayPeriod, compensationPlansEffective{compensationPlan, amount,compensationElement} AS compensationPlansRBO FROM workersForHCMReporting (dataSourceFilter = allActiveWorkers) WHERE worker IN (\\'' + queryParams.workerID + '\\')') %>",
      "url": "<% '/data?query=' + string:urlEncode('SELECT worker, allPositions as positions, cf_CurrentOpenPayPeriod_StartDate as currentPayPeriod, compensationPlansEffective{compensationPlan, amount,compensationElement} AS compensationPlansRBO FROM allActiveAndTerminatedWorkers WHERE worker IN (\\'' + queryParams.workerID + '\\')') %>"
    },
     {
      "baseUrlType": "Workday-WQL",
      "name": "getCustomOrganization",
      "authType": "laborISUV2",
      "url": "<%
        if(environment == 'WCPDEV'){
            var wql = 'SELECT planDimensionAsCustomOrganization, workdayID as id, name, referenceID1, type1 FROM customOrganizations WHERE type1 in (a6bbbc0c1916100378779ca119020000,a6bbbc0c191610037820a28c4acf0000,a6bbbc0c1916100378779d3aaff30000,cc7f0548812d100ed16fa9689de10000)';
        }else{
            var wql = 'SELECT planDimensionAsCustomOrganization, workdayID as id, name, referenceID1,  type1 FROM customOrganizations WHERE type1 IN (Organization_Type_ID = Activity) OR type1 IN (Organization_Type_ID = Budget_Unit) OR type1 IN (Organization_Type_ID = Center) OR type1 IN (Organization_Type_ID = Assignment_Allocation)';
        }
        return '/data?query=' + string:urlEncode(wql);
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getCustomOrgDefaults",
      "deferred": true,
      "authType": "laborISUV2",
      "url": "<%
       
        if(environment == 'WCPDEV'){
          var wql = ('SELECT fund, costCenter, grant, gift, project_worktag, customOrganization03 as activity, customOrganization02 as budgetUnit, customOrganization04 as Center FROM customOrganizations WHERE type1 in (a6bbbc0c1916100378779ca119020000,a6bbbc0c191610037820a28c4acf0000,a6bbbc0c1916100378779d3aaff30000) AND workdayID = \\''+ id + '\\'');
        }else{
          var wql = ('SELECT planDimensionAsCustomOrganization, workdayID as id, name as descriptor, type1 FROM customOrganizations WHERE type1 in ((Organization_Type_ID = Activity),(Organization_Type_ID = Budget_Unit)) AND workdayID = \\''+ id + '\\'');
        }
        return '/data?query=' + string:urlEncode(wql);
      %>"
    },
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getAllEarnings",
      "authType": "laborISUV2",
      "httpMethod": "GET",
      "url": "/GetReferencessSync/launch?referenceID=Earning_Code"
    },
    {
      "baseUrlType": "WORKDAY-APP",
      "name": "getEarnings",
      "authType": "sso",
      "url": "<% '/earningGroups' %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getDefaultWorkTags",
      "exclude": "<% empty(getWorkerData.data[0].positions[0].id) %>",
      "authType": "laborISUV2",
      "url": "<% '/data?query=' + string:urlEncode('SELECT costCenter, company, cf_Location1, fund, grant, program, gift FROM indexedPositionsAndJobs_AllStaffingModels WHERE positionAndJob_AllStaffingModels IN (\\'' + getWorkerData.data[0].positions[0].id + '\\')') %>"
    },
    {
      "baseUrlType": "WORKDAY-ORCHESTRATION",
      "name": "getCostingAllocationWorkday",
      "authType": "laborISUV2",
      "httpMethod": "GET",
      "exclude": "<% empty(getWorkerData.data[0].worker.id) %>",
      "url": "<%
              return '/getCostingAllocations/launch?workerID=' + getWorkerData.data[0].worker.id;

      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getEarningGroups",
      "deferred": true,
      "authType": "laborISUV2",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id FROM labormanagement_v3_gnqwhx_earningGroups WHERE ON earnings earningId = \\'' + earningID + '\\' WHERE EarningGroup IN (\\'' + earningGroups  +'\\')');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getEarningGroupFromAdminPage",
      "authType": "laborISUV2",
      "_exclude": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id, earningGroupName, earnings{workdayID as id, earningId, earningDescriptor} as earnings FROM labormanagement_v3_gnqwhx_earningGroups WHERE earningGroupFromAdminPage = true ');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getActiveCostingAllocationTransaction",
      "authType": "laborISUV2",
      "_exclude": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id, costingAllocationEarningsTransaction FROM labormanagement_v3_gnqwhx_costingAllocationRequestTransactions WHERE active = true AND worker IN(\\''+ queryParams.workerID +'\\')');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getTransactionEarningData",
      "authType": "laborISUV2",
      "exclude": "<% empty(getActiveCostingAllocationTransaction.data[0]) %>",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT earningGroup,hasRetroactiveAllocation, earningGroup{earnings} as earningGroupRBO, costingAllocationIntervalsTransaction, cf_XTNDARIEarningIDOnEarningRequestTransaction{earningId} as earningID, costingAllocationIntervalsTransaction{startDate, endDate, indefinite, isCurrentPayPeriod, costingAllocationLineDetailTransaction} as intervalData, cf_XTNDARICostingAllocationTransactionLineDataToEarningTransaction{workdayID, fund, budgetUnit, activityType, costCenter, center, grantDescriptor, grantId, gift, project, allocationPercent, isRetroActive, hasSalaryOvertheCap} as lineData FROM labormanagement_v3_gnqwhx_costingAllocationEarningRequestTransactions WHERE costingAllocationRequestTransaction IN (\\''+ getActiveCostingAllocationTransaction.data[0].id +'\\')');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getSalaryOverTheCapWorkday",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT allocationDetail, cf_XTNDLBCWorkersCostingLineSalaryOverTheCap{customOrganization01 as budgetUnit, costCenter, fund, project_worktag, gift, customOrganization02 as activity, customOrganization03 as center, customOrganization04 as assignmentAllocation, distributionPercent as percent, workdayID as id} as salaryOvertheCap FROM workerCostingOverride WHERE allocationDetail IN(\\'' + id + '\\')') 
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getSalaryOverTheCap",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT SalaryOverTheCap, fund, grantId, budgetUnitId, activityId, budgetUnitDescriptor, costCenterId, giftId, centerId,  activityDescriptor, costCenterDescriptor, centerDescriptor, grantDescriptor, giftDescriptor, projectDescriptor, clinicalAssignmentDescriptor, projectId, clinicalAssignmentId, allocationPercent, workdayID as id FROM labormanagement_v3_gnqwhx_salaryOverTheCaps WHERE costingAllocationLineDetailsTransaction IN(\\'' + id + '\\')') 
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorkerCostingAllocationsDefferred",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<%  console.info('deferred Costing query: ' + json:asJSON('SELECT allocationDetail, allocationDetail{allSalaryOverTheCapSuballocations, workdayID as id} as costingAllocationDetails FROM workerCostingOverride WHERE allocationDetail IN (\\'' + (id ?? '') + '\\')'));
        return '/data?query=' + string:urlEncode('SELECT allocationDetail, allocationDetail{allSalaryOverTheCapSuballocations, workdayID as id} as costingAllocationDetails FROM workerCostingOverride WHERE allocationDetail IN (\\'' + (id ?? '') + '\\')');
      %>"
    }
  ],
  "include": [
    "Validation.script",
    "Mapping.script",
    "GridScripts.script"
  ],
  "script": "<%

             var getDefaultPayload = function(rows, columns){
                 var counter = 0;
                 var defaultPayload = {'WorkTags': 'Default'};
                 for (var y : columns){
                     var periodStartDate = y.periodStartDate ?? '';
                         var periodMap = {:};
                         var periodEndDate = y.periodEndDate ?? '';
                         var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                         var periodSum = 0;
                         for(var x : rows){
                             var value = x.get(dateFormatted);
                                 periodSum = periodSum + value;
                         }
                         var defaultAllocation =  number:toBigDecimal((100 - periodSum), 2, 'CEILING');
                         periodMap = json:create(json:attribute(dateFormatted, defaultAllocation));
                         defaultPayload.addAll(periodMap);
                 }
                 return defaultPayload;
             }
             var getPercentageData = function(gridData, gridColumns){
                 var grid = gridData ?? [];
                 var gridData = [];
                 for (var x : grid){
                     var worktags = x.childrenMap.colallRemainingWorktag.childrenMap.allRemainingWorktag.selectedEntries.map(x =>{x.descriptor}) ?? [];
                         var costCenter = x.childrenMap.colCostCenterWorktag.childrenMap.CostCenterWorktag.selectedEntries[0].descriptor ?? '';
                         var fund = x.childrenMap.colFundWorktag.childrenMap.fundWorktag.selectedEntries[0].descriptor ?? '';

                         var budgetUnit = x.childrenMap.colBudgetUnitWorktag.childrenMap.budgetUnitWorktag.selectedEntries[0].descriptor ?? '';
                         var activity = x.childrenMap.colActivityWorktag.childrenMap.activityWorktag.selectedEntries[0].descriptor ?? '';


                         //update worktags based on new data
                         if(!empty(costCenter)){
                             worktags.add(costCenter);
                         }
                         if(!empty(fund)){
                             worktags.add(fund);
                         }
                         if(!empty(budgetUnit)){
                             worktags.add(budgetUnit);
                         }
                         if(!empty(activity)){
                             worktags.add(activity);
                         }
                         var worktagsJoin = worktags.join('\\n');
                         var worktagspayload = {'WorkTags': worktagsJoin};
                         var startDate = x.childrenMap.colStartDate.value ?? '';
                         var endDate = x.childrenMap.colEndDate.value ?? '';
                         var percentage = number:toBigDecimal((x.childrenMap.colPercent.value ?? 0), 2, 'CEILING');
                         var indefinite = x.childrenMap.colIndefinite.value ?? false;
                         var gridRows = {:};
                         gridRows.addAll(worktagspayload);
                         var gridColumnSize = !empty(gridColumns)? gridColumns.size() : 0;

                         var counter = 1;
                         for (var y : gridColumns){
                             var periodStartDate = y.periodStartDate ?? '';
                                 var periodMap = {:};
                                 var periodEndDate = y.periodEndDate ?? '';
                                 var numOfDaysInRequest = 0;
                                 var numOfdaysInMonth = 0;
                                 if(indefinite){
                                     if((startDate.between(periodEndDate, 'DAY')>=0)){
                                         var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                                             var firstDayOfMonth = periodEndDate.minusMonths(1);
                                             firstDayOfMonth = firstDayOfMonth.plusDays(1);
                                             numOfdaysInMonth = firstDayOfMonth.between(periodEndDate, 'DAY');
                                             var startDateIsInPeriod = (startDate.format('yyyy-MM') == periodStartDate.format('yyyy-MM'));
                                             numOfDaysInRequest =  startDateIsInPeriod? number:toBigDecimal(startDate.between(periodEndDate, 'DAY'), 2, 'CEILING') : periodStartDate.between(periodEndDate, 'DAY');
                                             var distributionPercentPeriod =  number:toBigDecimal((percentage)*(numOfDaysInRequest/numOfdaysInMonth), 0, 'CEILING');
                                             periodMap = json:create(json:attribute(dateFormatted, distributionPercentPeriod));
                                             counter = counter + 1;
                                     }
                                 }else{
                                     if((startDate.between(periodEndDate, 'DAY')>=0) && (periodStartDate.between(endDate, 'DAY') >=0 )){
                                         var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                                             if((endDate < periodEndDate) && ((counter == 1))){
                                                 numOfdaysInMonth = periodStartDate.between(periodEndDate, 'DAY');
                                                     numOfDaysInRequest =  startDate.between(endDate, 'DAY');;
                                             }else if(endDate < periodEndDate){
                                                 numOfdaysInMonth = periodStartDate.between(periodEndDate, 'DAY');
                                                     var endDateIsInPeriod = (endDate.format('yyyy-MM') == periodEndDate.format('yyyy-MM'));
                                                     numOfDaysInRequest = endDateIsInPeriod ? number:toBigDecimal(periodStartDate.between(endDate, 'DAY'), 2, 'CEILING') :  periodStartDate.between(periodEndDate, 'DAY');;
                                             }else if((counter == 1)){
                                                 var firstDayOfMonth = periodEndDate.minusMonths(1);
                                                     firstDayOfMonth = firstDayOfMonth.plusDays(1);
                                                     numOfdaysInMonth = firstDayOfMonth.between(periodEndDate, 'DAY');
                                                     var startDateIsInPeriod = (startDate.format('yyyy-MM') == periodStartDate.format('yyyy-MM'));
                                                     numOfDaysInRequest =  startDateIsInPeriod? number:toBigDecimal(startDate.between(periodEndDate, 'DAY'), 2, 'CEILING') : periodStartDate.between(periodEndDate, 'DAY');
                                             }else{
                                                 numOfDaysInRequest = periodStartDate.between(periodEndDate, 'DAY');
                                                     numOfdaysInMonth = periodStartDate.between(periodEndDate, 'DAY');
                                             }
                                             numOfdaysInMonth = number:toBigDecimal(numOfdaysInMonth, 2, 'CEILING');
                                             var distributionPercentPeriod =  number:toBigDecimal((percentage)*(numOfDaysInRequest/numOfdaysInMonth), 0, 'CEILING');
                                             periodMap = json:create(json:attribute(dateFormatted, distributionPercentPeriod));
                                            
                                             counter = counter + 1;
                                     }else{
                                         var dateFormatted = periodStartDate.format('MMM-dd-yyyy') + ' - ' + periodEndDate.format('MMM-dd-yyyy');
                                             periodMap = json:create(json:attribute(dateFormatted, 0));
                                     }
                                 }
                                 gridRows.addAll(periodMap);
                         }


                         gridData.add(gridRows);
                 }
                 var default = getDefaultPayload(gridData, gridColumns);
                 gridData.add(default);
                 return gridData;
             }



             %>",
  "onLoad": "<%
    pageVariables.onLoadData = Mapping.mapCostingAllocationOnLoadNewView((getEarningGroupFromAdminPage.data ?? []), (getCostingAllocationWorkday ?? []), (getTransactionEarningData.data ?? []));

   // var pageStartDate = list:flatten(pageVariables.onLoadData.map(l =>{list:flatten(l.extendData.map(u =>{u.lineData.map(s =>{s.startDate})}) ?? [])})).sort()[0] ?? date:now();
    //var pageEndDate = ((list:flatten(pageVariables.onLoadData.map(i =>{list:flatten(i.extendData.map(h =>{h.lineData.map(r =>{!empty(r.endDate)? r.endDate : null}) ?? []})) ?? []})))).last() ?? date:now();

    //pageVariables.initialAllocationData = Mapping.mapAllocationDataOnLoadView((getCostingAllocation ?? []), (getCostingAllocation ?? []), (flowVariables.startDate ?? ''), (flowVariables.endDate ?? '') );
    pageVariables.salaryOverCapFiltered = Mapping.mapSalaryOverTheCap(list:flatten(pageVariables.onLoadData.map(t =>{t.extendData.lineData ?? []}) ?? []), 'Approval') ?? [];
    // pageVariables.gridFunction = GridScripts.getDatesArray(pageStartDate, pageEndDate, 'MONTH', 'view');
  // pageVariables.gridFunction = GridScripts.getDatesArray(startDate.value, endDate.value, 'MONTH', 'prompt');
    pageVariables.dynamicGrid = [];
    var workTagPayload = {
        'name': 'WorkTags',
        'id': 'workTag',
        'type': 'string',
        'dataField': 'WorkTags'
    }
        pageVariables.dynamicGrid.add(workTagPayload);
   // for (var numCol : pageVariables.gridFunction){
   //     var colPayload = {
   //         'name': numCol.periodStartDate.format('MMM-dd-yyyy') + ' - ' + numCol.periodEndDate.format('MMM-dd-yyyy'),
   //         'id': numCol.id,
   //         'type': 'string',
   ///         'dataField': numCol.periodStartDate.format('MMM-dd-yyyy') + ' - ' + numCol.periodEndDate.format('MMM-dd-yyyy')
   //     };
  //          pageVariables.dynamicGrid.add(colPayload);
   // }

             pageVariables.allWorkTags =[];
             pageVariables.remainingValues = [];

    pageVariables.allWorkTags =[];
    pageVariables.allWorkTags.addAll(getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Center'}).map(x =>{{'descriptor': ('Center:'+ ((x.referenceID1 ?? '') +(x.name ?? ''))), 'id': x.id}}) ?? []);
    pageVariables.allWorkTags.addAll((getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Assignment Allocation'}).map(x =>{{'descriptor': ('Assignment Allocation:'+ ((x.referenceID1 ?? '') + ' ' + (x.name ?? ''))), 'id': x.id}}) ?? []));
    pageVariables.allWorkTags.addAll((getGift.data.map(x =>{{'descriptor': ('Gift:'+ x.gift.descriptor), 'id': x.gift.id}}) ?? []));
            
  %>",
  "presentation": {
    "headerSize": "VPS_DEFAULT",
    "title": {
      "type": "title",
      "label": "View Costing Allocation"
    },
    "standardEditButtonsHidden": true,
    "body": {
      "type": "section",
      
      "horizontal": false,
      "children": [
        {
          "type": "section",
          "id": "allocationOverallDetail",
          "horizontal": true,
          "children": [
            {
              "type": "section",
              "id": "workerPositionData",
              "horizontal": false,
              "children": [
                {
                  "type": "text",
                  "id": "worker",
                  "label": "Worker",
                  "enabled": false,
                  "value": "<% getWorkerData.data[0].worker.descriptor ?? '' %>"
                },
                {
                  "type": "text",
                  "id": "position",
                  "label": "Position",
                  "enabled": false,
                  "value": "<% getWorkerData.data[0].positions[0].descriptor ?? '' %>"
                },
                {
                  "type": "checkBox",
                  "id": "showRetroactive",
                  "label": "Show Retroactive Transactions",
                  "visible": "<% (pageVariables.onLoadData.map(x=>{(x.hasRetroactive ?? [])})).contains(true) %>",
                  "value": "<% false %>",
                  "onChange": "<% 
                    if(self.value){
                      pageVariables.onLoadData = Mapping.mapCostingAllocationOnLoadNewViewRetroActive((getEarningGroupFromAdminPage.data ?? []), (getCostingAllocationWorkday ?? []), (getTransactionEarningData.data ?? []));
                      pageVariables.onLoadData = pageVariables.onLoadData.filter(x=>{(x.extendData.hasRetroactive ?? false)});                  
                      panelListDynamicSection.setData(pageVariables.onLoadData);
                    }else{
                      pageVariables.onLoadData = Mapping.mapCostingAllocationOnLoadNewView((getEarningGroupFromAdminPage.data ?? []), (getCostingAllocationWorkday ?? []), (getTransactionEarningData.data ?? []));
                      panelListDynamicSection.setData(pageVariables.onLoadData);
                    }
                  %>"
                }
              ]
            }
          ]
        },
        {
          "type": "dynamicSection",
          "_type": "text",
          "id": "panelListDynamicSection",
          "data": "<% pageVariables.onLoadData.filter(t =>{!empty(t.extendData)}) ?? []; %>",
          "dataVariableName": "panelList",
          "children": [
            {
              "type": "panelList",
              "id": "loopWorkerAllocation",
              "label": "Allocations",
              "doNotAdd": true,
              "doNotRemove": true,
              "panels": "<%
                     //if you need to add a data change mapping script since we are getting the first widget with a static variable. not dynamic.
                     //pageVariables.initialAllocationData ?? [];
                     panelList ?? [];
                     %>",
              "panelName": "earningDataValue",
              "children": [
                {
                  "type": "instanceList",
                  "id": "earningGroupList",
                  "enabled": false,
                  "label": "Earning group",
                  "multiSelect": true,
                  "displayKey":"earningGroupName",
                  "values": "<% getEarningGroupFromAdminPage.data ?? [] %>",
                  "selectedValues": "<%  [earningDataValue.extendData.earningGroup ?? '']  %>"
                },
                {
                  "type": "instanceList",
                  "id": "earningSelected",
                  "enabled": false,
                  "label": "Earnings",
                  "multiSelect": true,
                  "values": "<% getAllEarnings ?? [] %>",
                  "selectedValues": "<% earningDataValue.extendData.earningSelected ?? [] %>"
                },
                {
                  "type": "fieldSet",
                  "id": "test",
                  "children": [
                    {
                      "type": "grid",
                      "id": "setPercentage",
                      "label": "Current Costing Allocation",
                      "rows": "<% earningDataValue.extendData.lineData ?? [] %>",
                      "doNotAdd": true,
                      "doNotRemove": true,
                      "enabled": false,
                      "isArrayOutBinding": "false",
                      "rowVariableName": "row",
                      "indexVariableName": "i",
                      "columns": [
                        {
                          "type": "column",
                          "columnId": "colRow",
                          "label": "Retroactive",
                          "cellTemplate": {
                            "type": "text",
                            "enabled": false,
                            "id": "rowIndex",
                            "value": "<% (row.isRetroActive == true) ? 'Yes' : 'No' %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colBudgetUnitWorktag",
                          "label": "Budget Unit",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "budgetUnitWorktagFieldSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "budgetUnitWorktag",
                                "enabled": false,
                                "values": "<% getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Budget Unit'}).map(c =>{{'descriptor': ( ((c.referenceID1 ?? '') + ' ' + (c.name ?? ''))), 'id': (c.id ?? '')}}) ?? [] %>",
                                "selectedValues": "<% [row.budgetUnit.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colCostCenterWorktag",
                          "label": "Cost Center",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "worktagCostCenterWorktag",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "CostCenterWorktag",
                                "enabled": false,
                                "values": "<% getCostCenter.data.map(t =>{t.costCenter}) ?? []  %>",
                                "selectedValues": "<% [row.costCenter.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colFundWorktag",
                          "label": "Fund",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "worktagFundWorktag",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "fundWorktag",
                                "enabled": false,
                                "values": "<% getFunds.data.map(x =>{x.fund}) ?? [] %>",
                                "selectedValues": "<% [row.fund.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colActivityWorktag",
                          "label": "Activity",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "ActivityWorktagFieldSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "activityWorktag",
                                "enabled": false,
                                "values": "<% getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Activity'}).map(c =>{{'descriptor': ( ((c.referenceID1 ?? '') + ' ' + (c.name ?? ''))), 'id': c.id}}) ?? [] %>",
                                "selectedValues": "<% [row.activityType.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colGrantWorktag",
                          "label": "Grant",
                          "id": "grantWorktagCol",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "grantWorktagFieldSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "grantWorktag",
                                "enabled": false,
                                "values": "<% (getGrant.data.map(x =>{x.grant}) ?? []) %>",
                                "selectedValues": "<% [row.grant.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colProjectWorktag",
                          "label": "Project",
                          "id": "projectWorktagCol",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "projectWorktagFieldSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "projectWorktag",
                                "enabled": false,
                                "values": "<% (getProject.data.map(x =>{{'descriptor': ('Project:'+ x.descriptor), 'id': x.id}}) ?? []) %>",
                                "selectedValues": "<% [row.project.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colallRemainingWorktag",
                          "label": "Additional Worktags",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "allRemainingWorktagSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "allRemainingWorktag",
                                "enabled": false,
                                "multiSelect": true,
                                "values": "<% pageVariables.allWorkTags ?? [] %>",
                                "selectedValues": "<%
                                  var otherWT = [];
                                  if(!empty(row.gift.id)){
                                      otherWT.add(row.gift.id);
                                  }
                                  if(!empty(row.clinicalAssignment.id)){
                                      otherWT.add(row.clinicalAssignment.id);
                                  }
                                  if(!empty(row.center.id)){
                                      otherWT.add(row.center.id);
                                  }
                                  if(!empty(row.activityType.id)){
                                      otherWT.add(row.activityType.id);
                                  }
                                // if(!empty(row.grant.id)){
                                  //    otherWT.add(row.grant.id);
                                  //}
                                  return otherWT ?? [];
                                %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colStartDate",
                          "label": "Start Date",
                          "cellTemplate": {
                            "type": "date",
                            "id": "startDate",
                            "enabled": false,
                            "required": "<% true %>",
                            "value": "<% row.startDate ?? '' %>",
                            "onChange": "<%
                              if(!empty(endDate.value)){
                                if(endDate.value < (startDate.value ?? '')){
                                  endDate.setError('Start Date must be before End Date');
                                }
                              }
                            %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colEndDate",
                          "label": "End Date",
                          "cellTemplate": {
                            "type": "date",
                            "id": "endDate",
                            "enabled": false,
                            "value": "<% row.endDate ?? '' %>",
                            "required": "<% !(row.indefinite ?? false) %>",
                            "onChange": "<%
                              if(!empty(endDate.value)){
                                if(endDate.value < (startDate.value ?? '')){
                                  endDate.setError('Start Date must be before End Date');
                                }
                              }
                              %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colIndefinite",
                          "label": "Indefinite",
                          "cellTemplate": {
                            "type": "checkBox",
                            "id": "indefinite",
                            "enabled": false,
                            "value": "<% row.indefinite ?? false %>",
                            "onChange": "<%
                              if(self.value ?? false){
                                endDate.setValue('');
                                endDate.setEnabled(false);
                                endDate.setRequired(false);
                              }else{
                                endDate.setEnabled(true);
                                endDate.setRequired(true);
                              }
                            %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colPercent",
                          "label": "Percent",
                          "cellTemplate": {
                            "type": "richText",
                            "id": "percentAmount",
                            "_fractionDigits": 2,
                            "enabled": false,
                            "value": "<% 
                            '<p style=\"text-align: right;\">' + number:toBigDecimal((string:isString(row.allocationPercent)? (row.allocationPercent).toDecimal() : (row.allocationPercent)),2, 'CEILING') + '% </p>';
                           // !empty((row.allocationPercent)) ? (string:isString(row.allocationPercent)? (row.allocationPercent).toDecimal() : (row.allocationPercent)) : 0
                             %>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "dynamicSection",
                      "_type": "text",
                      "id": "ds1",
                      "visible": false,
                      "render": false,
                      "data": "<% (getPercentageData((setPercentage.getRows() ?? []), (pageVariables.gridFunction ?? [])) ?? {:}) ?? {:} %>",
                      "dataVariableName": "allocationData",
                      "children": [
                        {
                          "type": "grid",
                          "id": "viewAllocation",
                          "enabled": false,
                          "label": "View Extend Costing Allocation",
                          "rowVariableName": "row",
                          "visible": false,
                          "rows": "<% allocationData ?? [] %>",
                          "dynamicColumns": {
                            "type": "dynamicColumns",
                            "columns": "<%  pageVariables.dynamicGrid ?? [] %>",
                            "columnVariableName": "aColumn",
                            "id": "<% aColumn.id %>",
                            "columnId": "<% aColumn.id %>",
                            "label": "<% aColumn.name %>",
                            "templateId": "<% aColumn.type %>",
                            "attributeName": "<% aColumn.dataField %>"
                          },
                          "cellTemplates": [
                            {
                              "type": "cellTemplate",
                              "templateId": "string",
                              "id": "cellTemplateID",
                              "template": {
                                "type": "text"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "grid",
                      "id": "workdayCostingAllocation",
                      "rows": "<% earningDataValue.lineData %>",
                      "doNotAdd": true,
                      "doNotRemove": true,
                      "render": false,
                      "label": "Workday Costing Allocations",
                      "enabled": false,
                      "isArrayOutBinding": "false",
                      "rowVariableName": "row",
                      "indexVariableName": "i",
                      "columns": [
                        {
                          "type": "column",
                          "columnId": "colRow",
                          "label": "Row",
                          "cellTemplate": {
                            "type": "text",
                            "enabled": false,
                            "id": "rowIndex",
                            "value": "<% i %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colBudgetUnitWorktag",
                          "label": "Budget Unit",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "budgetUnitWorktagFieldSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "budgetUnitWorktag",
                                "enabled": false,
                                "values": "<% getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Budget Unit'}).map(c =>{{'descriptor': ( ((c.referenceID1 ?? '') + ' ' + (c.name ?? ''))), 'id': (c.id ?? '')}}) ?? [] %>",
                                "selectedValues": "<% [row.budgetUnit.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colCostCenterWorktag",
                          "label": "Cost Center",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "worktagCostCenterWorktag",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "CostCenterWorktag",
                                "enabled": false,
                                "values": "<% getCostCenter.data.map(t =>{t.costCenter}) ?? []  %>",
                                "selectedValues": "<% [row.costCenter.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colFundWorktag",
                          "label": "Fund",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "worktagFundWorktag",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "fundWorktag",
                                "enabled": false,
                                "values": "<% getFunds.data.map(x =>{x.fund}) ?? [] %>",
                                "selectedValues": "<% [row.fund.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colActivityWorktag",
                          "label": "Activity",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "ActivityWorktagFieldSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "activityWorktag",
                                "enabled": false,
                                "values": "<% getCustomOrganization.data.filter(x =>{x.type1[0].descriptor == 'Activity'}).map(c =>{{'descriptor': ( ((c.referenceID1 ?? '') + ' ' + (c.name ?? ''))), 'id': c.id}}) ?? [] %>",
                                "selectedValues": "<% [row.activityType.id ?? ''] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colallRemainingWorktag",
                          "label": "All Worktags",
                          "cellTemplate": {
                            "type": "fieldSet",
                            "id": "allRemainingWorktagSet",
                            "children": [
                              {
                                "type": "instanceList",
                                "id": "allRemainingWorktag",
                                "enabled": false,
                                "multiSelect": true,
                                "values": "<% pageVariables.allWorkTags ?? [] %>"
                              }
                            ]
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colStartDate",
                          "label": "Start Date",
                          "cellTemplate": {
                            "type": "date",
                            "id": "startDate",
                            "enabled": false,
                            "required": "<% true %>",
                            "value": "<% row.startDate ?? '' %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colEndDate",
                          "label": "End Date",
                          "cellTemplate": {
                            "type": "date",
                            "id": "endDate",
                            "enabled": false,
                            "value": "<% row.endDate ?? '' %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colIndefinite",
                          "label": "Indefinite",
                          "cellTemplate": {
                            "type": "checkBox",
                            "id": "indefinite",
                            "enabled": false,
                            "value": "<% empty(row.endDate) %>"
                          }
                        },
                        {
                          "type": "column",
                          "columnId": "colPercent",
                          "label": "Percent",
                          "cellTemplate": {
                            "type": "number",
                            "id": "percentAmount",
                            "fractionDigits": 2,
                            "enabled": false,
                            "value": "<% !empty((row.allocationPercent)) ? (string:isString(row.allocationPercent)? (row.allocationPercent).toDecimal() : (row.allocationPercent)) : 0 %>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "dynamicSection",
                      "_type": "text",
                      "id": "ds",
                      "render": false,
                      "visible": false,
                      "data": "<% (getPercentageData((workdayCostingAllocation.getRows() ?? []), (pageVariables.gridFunction ?? [])) ?? {:}) %>",
                      "dataVariableName": "allocationData",
                      "children": [
                        {
                          "type": "grid",
                          "id": "viewAllocation",
                          "enabled": false,
                          "label": "View Workday Allocation",
                          "rowVariableName": "row",
                          "visible": false,
                          "rows": "<% allocationData ?? [] %>",
                          "dynamicColumns": {
                            "type": "dynamicColumns",
                            "columns": "<%  pageVariables.dynamicGrid ?? [] %>",
                            "columnVariableName": "aColumn",
                            "id": "<% aColumn.id %>",
                            "columnId": "<% aColumn.id %>",
                            "label": "<% aColumn.name %>",
                            "templateId": "<% aColumn.type %>",
                            "attributeName": "<% aColumn.dataField %>"
                          },
                          "cellTemplates": [
                            {
                              "type": "cellTemplate",
                              "templateId": "string",
                              "id": "cellTemplateID",
                              "template": {
                                "type": "text"
                              }
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "hidden",
                      "id": "onLoadFunction",
                      "_value": "<%
                          pageVariables.percentData = {
                            'gridData': (getPercentageData((workdayCostingAllocation.getRows() ?? []), (pageVariables.gridFunction ?? [])) ?? {:})
                          };
                          if(!empty(pageVariables.percentData)){
                            ds.setData(pageVariables.percentData);
                          }
                          
                          pageVariables.percentData1 = {
                            'gridData': (getPercentageData((setPercentage.getRows() ?? []), (pageVariables.gridFunction ?? [])) ?? {:})
                          };
                          if(!empty(pageVariables.percentData1)){
                          ds1.setData(pageVariables.percentData1); 
                          }
                    

                      %>"
                    },
                    {
                      "type": "text",
                      "id": "validation",
                      "visible": false,
                      "value": "<% '' %>"
                    }
                  ]
                },
                {
                  "type": "hidden",
                  "id": "costingAllocationPlan",
                  "value": "<% earningDataValue ?? {:} %>"
                }
              ]
            }
          ]
        },
        {
          "type": "editButtonBar",
          "editButtons": [
            {
              "type": "editButton",
              "label": "OK",
              "id": "OK",
              "buttonType": "PRIMARY"
            }
          ]
        }
      ]
    },
    "pageType": "EDIT"
  }
}