{
  "securityDomains": [
    "ManageCostingAllocation"
  ],
  "id": "ViewAllCostingAllocations",
  "endPoints": [
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorkerCostingAllocations",
      "authType": "laborISUV2",
      "exclude": "<% empty(queryParams.workerID ?? ''); %>",
      "url": "<% 
      // commented by Pasha 11/06 MCW-14446
        //return '/data?query=' + string:urlEncode('SELECT startDate, endDate, position, workerEarning, allocationDetail, allocationDetail{costingCompany, allCostingAllocationWorktagsAsOfAllocationStartDate, distributionPercent} as costingAllocationDetails FROM workerCostingOverride WHERE worker in (\\'' + (queryParams.workerID ?? '') + '\\')');
          return '/data?query=' + string:urlEncode('SELECT startDate, endDate, position, workerEarning, allocationDetail, allocationDetail{costingCompany, allCostingAllocationWorktagsAsOfAllocationStartDate, distributionPercent, workdayID as id, allSalaryOverTheCapSuballocations} as costingAllocationDetails FROM workerCostingOverride WHERE worker in (\\'' + (queryParams.workerID ?? '') + '\\')');
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getWorkerData",
      "authType": "laborISUV2",
      "exclude": "<% empty(queryParams.workerID); %>",
      "url": "<% '/data?query=' + string:urlEncode('SELECT worker, allPositions as positions,position, cf_CurrentOpenPayPeriod_StartDate as currentPayPeriod, cf_XTNDLBCEMIWorkerCompensation{compensationPlan, amount,compensationElement,frequency} AS compensationPlansRBO,FTE, bonusAndOne_TimePayments{compensationElement, amount} as onTimePayment, positionWorkerType as workerType FROM workersForHCMReporting (dataSourceFilter = allActiveWorkers) WHERE worker IN (\\'' + queryParams.workerID + '\\')') %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getSalaryOverTheCapWorkday",
      "authType": "laborISUV2",
      "deferred": true,
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT allocationDetail, cf_XTNDLBCWorkersCostingLineSalaryOverTheCap{workdayID as id, allCostingAllocationWorktagsAsOfAllocationStartDate, customOrganization01 as budgetUnit, costCenter, fund, project_worktag, gift, customOrganization02 as activity, customOrganization03 as center, customOrganization04 as assignmentAllocation, distributionPercent as percent} as salaryOvertheCap FROM workerCostingOverride WHERE allocationDetail IN(\\'' + id + '\\')'); 
      %>"
    },
    {
      "baseUrlType": "Workday-WQL",
      "name": "getEarningGroupFromAdminPage",
      "authType": "laborISUV2",
      "url": "<% 
        return '/data?query=' + string:urlEncode('SELECT workdayID as id, earningSortOrder, earningGroupName, earnings{workdayID as id, earningId, earningDescriptor} as earnings FROM labormanagement_v3_gnqwhx_earningGroups WHERE earningGroupFromAdminPage = true ORDER BY earningSortOrder ASC ');
      %>"
    },
      {
      "baseUrlType": "Workday-WQL",
      "name": "getPrehireWorkerData",
      "authType": "laborISUV2",
      "exclude": "<% empty(flowVariables.worker) || true %>",
      "url": "<% '/data?query=' + string:urlEncode('SELECT worker, allPositions as positions,position, cf_CurrentOpenPayPeriod_StartDate as currentPayPeriod, cf_XTNDLBCEMIWorkerCompensation{compensationPlan, amount,compensationElement,frequency} AS compensationPlansRBO,FTE ,bonusAndOne_TimePayments{compensationElement, amount} as onTimePayment FROM allWorkersForPre_Hires WHERE worker IN (\\'' + flowVariables.worker + '\\')') %>"
    }
  ],
  "onLoad": "<%
    pageVariables.retroactiveWorkers = getRetroactiveWorker.data ?? [];
    pageVariables.workersCompensation = ! empty getWorkerData.data[0].compensationPlansRBO  ? getWorkerData.data[0].compensationPlansRBO  : [];
    var earningGroupsfromAdmin  = getEarningGroupFromAdminPage.data ?? [];
    pageVariables.costingAllocation = [];
    var earningGroups = getEarningGroupFromAdminPage.data?? [];
    pageVariables.workersCompensation = ! empty getWorkerData.data[0].compensationPlansRBO  ? getWorkerData.data[0].compensationPlansRBO  : ! empty getPrehireWorkerData.data[0].compensationPlansRBO ? getPrehireWorkerData.data[0].compensationPlansRBO  : [];
    pageVariables.workersCompensation =list:join((pageVariables.workersCompensation ?? []), (oneTimePayments ?? []));                
    var earningGroupsfromAdmin  = getEarningGroupFromAdminPage.data ?? [];
    var finalAmountArray = [];
    for(var t: earningGroupsfromAdmin){
      var amountList = 0; 
      var earningsGroupsEarningsMapped = t.earnings.map(y =>{y.earningDescriptor}) ?? [];
      for(var row : pageVariables.workersCompensation) {         
        var compPlanSubText = row.compensationElement.descriptor ?? '';    
        if(!empty(earningsGroupsEarningsMapped)){
          for(var earning : (earningsGroupsEarningsMapped ?? [])){     
            var list =  (((compPlanSubText ?? '').contains(earning)) || (('Regular ' + compPlanSubText) ?? '').contains(earning));   
            if (list == true){    
              if(row.frequency.descriptor == 'Hourly' ){
                amountList = ((row.amount.value * (pageVariables.fte * 40)) ?? 0) + amountList;
              }     
              else{
                amountList = (row.amount.value.toDecimal() ?? 0)+ amountList;
              }
            }
          }
        }
      }
      var earningGroupAmountPayload = {
        'earning': (t.earningGroupName ?? ''),
        'amount': amountList
      };
      finalAmountArray.add(earningGroupAmountPayload);
    }                       
    pageVariables.amountMapped = finalAmountArray;
    console.info('getWorkerCostingAllocations.data test ViewAllCostingAllocations' + (json:asJSON(getWorkerCostingAllocations.data) ?? []));
    for(var t: earningGroups){
      var wdDataFiltered = getWorkerCostingAllocations.data.filter(l =>{(t.earnings.map(q =>{q.earningId ?? ''})[0] ?? '') == (l.workerEarning.id ?? '')}) ?? [];
      console.info('wdDataFiltered new ViewAllCostingAllocations -- ' + json:asJSON(wdDataFiltered));
      var earningGroupAmount = pageVariables.amountMapped.filter(l =>{l.earning == t.earningGroupName})[0] ?? {:};
      for(var wdData: (wdDataFiltered ?? [])){
        var salaryOverTheCapIDs = wdData.allSalaryOverTheCapSuballocations.map(y =>{y.id}) ?? [];
        var firstSOC = true;
        var isFirstValue = true;
        for(var intervalData : (wdData.costingAllocationDetails ?? [])){
           console.info('Test Pasha 04/19 interval data ViewAllCostingAllocations' + json:asJSON(intervalData));
          // added the below salaryOverTheCapIDs by Pasha 11/06 MCw-14446
        //  var salaryOverTheCapIDs = intervalData.allSalaryOverTheCapSuballocations.map(y =>{y.id}) ?? [];
            var salaryOverTheCapIDs =  (intervalData.allSalaryOverTheCapSuballocations ?? []).map(y => y.id ?? '').filter(id => !empty(id));
          if(!empty(salaryOverTheCapIDs)){            
            //commeted salaryOverTheCap by Pasha 11/06 MCW-14446
           // var salaryOverTheCap = getSalaryOverTheCapWorkday.invoke({'id': (wdData.id ?? '')}).data[0].salaryOvertheCap ?? [];
            var salaryOverTheCap = getSalaryOverTheCapWorkday.invoke({'id': (intervalData.id ?? '')}).data[0].salaryOvertheCap ?? [];
            salaryOverTheCap = salaryOverTheCap.filter(u =>{salaryOverTheCapIDs.contains((u.id ?? ''))}) ?? [];
            for(var l : salaryOverTheCap){
              if(firstSOC){
                if(isFirstValue){
                  var payload = {
                    'startDate': (wdData.startDate ?? ''),
                    'endDate': (wdData.endDate ?? ''),
                    'position': (wdData.position ?? {:}),
                    'earning': (t.earningGroupName ?? {:}),
                    'allocationData': (intervalData ?? {:}),
                    'salaryOverThecap': (l ?? {:}),
                    //added amount by Pasha 11/06 MCw-14446
                     'amount' : (earningGroupAmount.amount ?? 0)
                  }
                  isFirstValue = false;
                }else{
                  var payload = {
                    'allocationData': (intervalData ?? {:}),
                    'salaryOverThecap': (l ?? {:}),
                     //added amount by Pasha 11/06 MCw-14446
                     'amount' : (earningGroupAmount.amount ?? 0)
                  }
                }
                firstSOC = false;
              }else{
                var payload = {
                  'salaryOverThecap': (l ?? {:})
                }
              }
              pageVariables.costingAllocation.add(payload);
            }
          }else{
            if(isFirstValue){
              var payload = {
                'startDate': (wdData.startDate ?? ''),
                'endDate': (wdData.endDate ?? ''),
                'position': (wdData.position ?? {:}),
                'earning': (t.earningGroupName ?? {:}),
                'allocationData': (intervalData ?? {:}),
                'amount' : (earningGroupAmount.amount ?? 0)
              }
              isFirstValue = false;
            }else{
              var payload = {
                'allocationData': intervalData ?? {:},
                'amount' : (earningGroupAmount.amount ?? 0)
              }
            }
            pageVariables.costingAllocation.add(payload);
          }
        }
      }
    }
    var earningsFromEarningGroup = getEarningGroupFromAdminPage.data.map(l =>{l.earnings}) ?? [];
    earningsFromEarningGroup = list:flatten(earningsFromEarningGroup).map(p =>{p.earningId?? ''}) ?? [];
    var workdayDataNotInEarningGroup = getWorkerCostingAllocations.data.filter(t =>{!(earningsFromEarningGroup.contains(t.workerEarning.id ?? ''))}) ?? [];
    for(var t: workdayDataNotInEarningGroup){
      var isFirstValue = true;
      for(var wdData: t.costingAllocationDetails ?? []){
        if(isFirstValue){
          var payload = {
            'startDate': (t.startDate ?? ''),
            'endDate': (t.endDate ?? ''),
            'position': (t.position ?? {:}),
            'earning': (t.workerEarning.descriptor ?? {:}),
            'allocationData': (wdData ?? {:})
          }
          isFirstValue = false;
        }else{
          var payload = {
            'allocationData': wdData ?? {:}
          }
        }
        pageVariables.costingAllocation.add(payload);
      }
    }
  %>",
  "presentation": {
    "title": {
      "type": "title",
      "label": "Worker Profile"
    },
    "body": {
      "type": "section",
      "horizontal": false,
      "children": [
        {
          "autoPaging": true,
          "enabled": false,
          "excelExportEnabled": true,
          "type": "grid",
          "id": "costingAllocationGrid1",
          "label": "All Costing Allocations",
          "rows": "<% pageVariables.costingAllocation ?? [] %>",
          "rowVariableName": "costingAllocation",
          "columns": [
            {
              "type": "column",
              "id": "colStartDate",
              "label":"Start Date",
              "columnId": "startDateCol",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "date",
                "id": "startDate",
                "value": "<%  costingAllocation.startDate ?? '' %>"
              }
            },
            {
              "type": "column",
              "id": "colEndDate",
              "label":"End Date",
              "columnId": "endDateCol",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "date",
                "id": "endDate",
                "value": "<%  costingAllocation.endDate ?? '' %>"
              }
            },
            {
              "type": "column",
              "id": "colPosition",
              "label":"Position",
              "sortableAndFilterable": true,
              "columnId": "positionCol",
              "cellTemplate": {
                "type": "instanceList",
                "id": "position",
                "_values":"<% !empty(costingAllocation.position )? [costingAllocation.position ?? ''] : [] %>",
                "selectedValues": "<%  [costingAllocation.position.id ?? ''] %>",
                "instanceListLoopTag": {
                    "type": "instanceLoop",
                    "templateInstance": {
                      "id": "<% positionInstance.id %>",
                      "descriptor": "<% positionInstance.descriptor %>",
                      "wid": "<% positionInstance.id %>"
                    },
                    "on": "<% !empty(costingAllocation.position )? [costingAllocation.position ?? ''] : []  %>",
                    "as": "positionInstance"
                }
              }
            },
            {
              "type": "column",
              "id": "colEarning",
              "label":"Earning Group",
              "columnId": "earningCol",
              "sortableAndFilterable": true,
              "cellTemplate": {
                  "type": "text",
                  "id": "earning",
                  "value":"<% !empty(costingAllocation.earning)? costingAllocation.earning : '' %>"
              }
            },
           
            {
              "type": "column",
              "id": "colAmount",
              "label":"Amount",
              "columnId": "AmountCol",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "currency",
                "_type":"text",
                "showCurrencySymbol": "true",
                "label": "Amount",
                "align": "left",
                "currencyCode": "USD",
                "value": "<%
                 // console.info('amount on the widget: ' + json:asJSON(costingAllocation.amount ) + ' percent on allocaiton ' + json:asJSON(costingAllocation.allocationData.distributionPercent) + ' decimal: ' + json:asJSON(number:toBigDecimal((number:toBigDecimal(costingAllocation.amount,2, 'DOWN') * number:toBigDecimal(costingAllocation.allocationData.distributionPercent,2, 'DOWN')),2, 'DOWN')));
                  //'$'+ number:toBigDecimal((costingAllocation.amount * costingAllocation.allocationData.distributionPercent), 2, 'HALF_DOWN');
                  return (costingAllocation.amount * costingAllocation.allocationData.distributionPercent);
                %>",

                "enabled": "false"
              }	
            },
            {
              "type": "column",
              "id": "colworktags",
              "label":"Costing",
              "sortableAndFilterable": true,
              "columnId": "worktagsCol",
              "cellTemplate": {
                "type": "instanceList",
                "id": "worktags",
                "selectedValues": "<% 
                    !empty(costingAllocation.allocationData.allCostingAllocationWorktagsAsOfAllocationStartDate[0].id)?  costingAllocation.allocationData.allCostingAllocationWorktagsAsOfAllocationStartDate.map(x =>{x.id}) :  []
                %>",
                "instanceListLoopTag": {
                  "type": "instanceLoop",
                  "templateInstance": {
                    "id": "<% worktagInstance.id %>",
                    "descriptor": "<% worktagInstance.descriptor %>",
                    "wid": "<% worktagInstance.id %>"
                  },
                  "on": "<% !empty(costingAllocation.allocationData.allCostingAllocationWorktagsAsOfAllocationStartDate[0].id)?  costingAllocation.allocationData.allCostingAllocationWorktagsAsOfAllocationStartDate :  [] %>",
                  "as": "worktagInstance"
                }
              }
            },
            {
              "type": "column",
              "id": "colPercent",
              "label":"Percentage",
              "columnId": "percentCol",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "richText",
                "id": "percent",
                "value": "<% 
                  !empty(costingAllocation.allocationData.distributionPercent)? ('<p style=\"text-align: right;\">' + number:toBigDecimal(((costingAllocation.allocationData.distributionPercent  ?? 0)*100),2, 'DOWN') + '% </p>') : '';
                %>"
              }
            },
            {
              "type": "column",
              "id": "colsalaryOverTheCapworktags",
              "label":"Salary Over the Cap Costing",
              "sortableAndFilterable": true,
              "columnId": "worktagsSOCCol",
              "cellTemplate": {
                "type": "instanceList",
                "id": "worktags",
                "selectedValues": "<% 
                  !empty(costingAllocation.salaryOverThecap.allCostingAllocationWorktagsAsOfAllocationStartDate[0].id)?  costingAllocation.salaryOverThecap.allCostingAllocationWorktagsAsOfAllocationStartDate.map(x =>{x.id}) :  []
                %>",
                "instanceListLoopTag": {
                  "type": "instanceLoop",
                  "templateInstance": {
                    "id": "<% worktagInstance.id %>",
                    "descriptor": "<% worktagInstance.descriptor %>",
                    "wid": "<% worktagInstance.id %>"
                  },
                  "on": "<% !empty(costingAllocation.salaryOverThecap.allCostingAllocationWorktagsAsOfAllocationStartDate[0].id)?  costingAllocation.salaryOverThecap.allCostingAllocationWorktagsAsOfAllocationStartDate :  [] %>",
                  "as": "worktagInstance"
                }
              }
            },
            {
              "type": "column",
              "id": "colPercentSOC",
              "label":"Salary Over the Cap Percentage",
              "columnId": "percentSOCCol",
              "sortableAndFilterable": true,
              "cellTemplate": {
                "type": "richText",
                "id": "percent",
                "value": "<%
                  !empty(costingAllocation.salaryOverThecap.percent)? ('<p style=\"text-align: right;\">' + number:toBigDecimal(((costingAllocation.salaryOverThecap.percent  ?? 0)*100),2, 'CEILING') + '% </p>') : '';
                %>"
              }
            }
          ]
        }
      ]
    },
    "pageType": "VIEW"
  }
}